---
import { siteConfig } from '../data/site';
---

<section id="about" class="py-12 lg:py-14 bg-white border-b border-slate-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Headline & Narrative (col-span-5) -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">About Ziya Zara</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-bold font-editorial-serif text-[#0B1F36] leading-tight">
          Global Trade<br />
          Partner You Can Trust
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          We specialize in international trade and global sourcing, connecting reliable suppliers with quality products across borders. With a customer-centric approach and a strong network of partners, ZIYA ZARA TRADING COMPANY creates value through efficient trade solutions and long-term relationships.
        </p>

        <div class="pt-2">
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Learn More About Us</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Center Column: 4 Key Pillars with Clean Icons (col-span-3) -->
      <div class="lg:col-span-3 space-y-6">
        
        <!-- 1. Quality Products Across Industries -->
        <div class="flex items-start gap-3.5">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 3h12l4 6-10 12L2 9l4-6z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2 9h20" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 3l-2 6 4 12 4-12-2-6" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-[13px] font-bold text-[#0B1F36] leading-snug">Quality Products Across Industries</h3>
          </div>
        </div>

        <!-- 2. Transparent Trade Practices -->
        <div class="flex items-start gap-3.5">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-[13px] font-bold text-[#0B1F36] leading-snug">Transparent Trade Practices</h3>
          </div>
        </div>

        <!-- 3. Global Supplier Network -->
        <div class="flex items-start gap-3.5">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-[13px] font-bold text-[#0B1F36] leading-snug">Global Supplier Network</h3>
          </div>
        </div>

        <!-- 4. Commitment to Long-term Growth -->
        <div class="flex items-start gap-3.5">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-[13px] font-bold text-[#0B1F36] leading-snug">Commitment to Long-term Growth</h3>
          </div>
        </div>

      </div>

      <!-- Right Column: 8K Illuminated Globe Visual in Circular Arc (col-span-4) -->
      <div class="lg:col-span-4 flex justify-end items-center">
        <div class="relative w-full max-w-[360px] sm:max-w-[400px] lg:max-w-[440px] aspect-square rounded-full overflow-hidden shadow-2xl border-4 border-slate-100/90 bg-[#061220] group">
          <!-- 8K Photorealistic Globe Image -->
          <img
            src="/images/about/globe_hd.jpg"
            alt="Global trade network globe"
            width="1024"
            height="1024"
            class="w-full h-full object-cover object-center transform scale-110 group-hover:scale-115 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <!-- Radial Depth Overlay -->
          <div class="absolute inset-0 bg-radial from-transparent via-[#061220]/20 to-[#061220]/60 pointer-events-none"></div>

          <!-- Editorial Headline Overlay from Mockup -->
          <div class="absolute top-7 right-7 sm:top-9 sm:right-9 text-right pointer-events-none z-10 space-y-1">
            <div class="text-xs sm:text-[13px] font-extrabold uppercase tracking-widest text-white leading-tight drop-shadow-lg">
              Global Markets<br />
              Stronger Together
            </div>
            <div class="w-8 h-[2px] bg-[#138848] ml-auto"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
