---
import { siteConfig } from '../data/site';
---

<section id="about" class="py-16 lg:py-20 bg-white border-b border-slate-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Column: Editorial Headline & Copy (col-span-5) -->
      <div class="lg:col-span-5 space-y-5">
        
        <!-- Eyebrow with green line -->
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">About Ziya Zara</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <!-- Headline -->
        <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-editorial-serif text-[#0B1F36] leading-tight">
          Global Trade<br />
          Partner You Can Trust
        </h2>

        <!-- Paragraph -->
        <p class="text-sm sm:text-[15px] text-slate-600 leading-relaxed font-normal">
          We specialize in international trade and global sourcing, connecting reliable suppliers with quality products across borders. With a customer-centric approach and a strong network of partners, ZIYA ZARA TRADING COMPANY creates value through efficient trade solutions and long-term relationships.
        </p>

        <!-- CTA Button -->
        <div class="pt-2">
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Learn More About Us</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Center Column: 4 Key Pillars with Icons (col-span-3) -->
      <div class="lg:col-span-3 space-y-6">
        
        <!-- 1. Quality Products -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36] leading-snug">Quality Products Across Industries</h3>
          </div>
        </div>

        <!-- 2. Transparent Trade Practices -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36] leading-snug">Transparent Trade Practices</h3>
          </div>
        </div>

        <!-- 3. Global Supplier Network -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-700 flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36] leading-snug">Global Supplier Network</h3>
          </div>
        </div>

        <!-- 4. Commitment to Long-term Growth -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36] leading-snug">Commitment to Long-term Growth</h3>
          </div>
        </div>

      </div>

      <!-- Right Column: Glowing Global Visualization Card (col-span-4) -->
      <div class="lg:col-span-4">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#0B1F36] to-[#040C17] p-4 text-white shadow-xl group">
          
          <!-- Caption on top right -->
          <div class="text-right pb-3 pr-2">
            <span class="text-xs font-bold tracking-widest uppercase font-display text-white">
              Global Markets<br />
              <span class="text-emerald-400">Stronger Together</span>
            </span>
          </div>

          <!-- Circular Globe Image Cutout -->
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden shadow-2xl bg-black">
            <img
              src="/images/about/global_network.jpg"
              alt="Global trade network visualization"
              width="500"
              height="500"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-radial-gradient from-transparent via-transparent to-black/60 pointer-events-none"></div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
