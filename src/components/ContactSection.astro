---
// Contact Section matching reference mockup 100%
// Twilight port terminal backdrop, serif headline, 3 contact details with icons, clean 3-col form card
import { siteConfig } from '../data/site';
---

<section id="contact" class="relative py-20 lg:py-28 bg-[#071326] text-white overflow-hidden">
  
  <!-- Background Image: Shipping Port Terminal at Twilight -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/contact/port_twilight.jpg"
      alt="Global Shipping Container Port at Twilight"
      width="1920"
      height="1080"
      class="w-full h-full object-cover object-center opacity-45"
      loading="lazy"
    />
    <!-- Rich Deep Navy Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#071326] via-[#071326]/85 to-[#071326]/50"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & Details -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal-left flex items-center gap-2.5">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-white font-mono">
            GET IN TOUCH
          </span>
          <span class="w-8 h-0.5 bg-emerald-500"></span>
        </div>

        <!-- Headline -->
        <h2 class="scroll-reveal-left text-3xl sm:text-4xl lg:text-5xl font-bold font-serif text-white tracking-tight leading-[1.15]">
          Let's Create<br />
          Global Opportunities
        </h2>

        <!-- Description -->
        <p class="scroll-reveal-left text-xs sm:text-sm text-slate-300 leading-relaxed font-normal max-w-md">
          We are always open to new opportunities, partnerships and inquiries. Reach out to us and our team will get back to you shortly.
        </p>

        <!-- Contact Information matching mockup layout -->
        <div class="scroll-reveal-left space-y-3 pt-2">
          
          <!-- Row 1: Email & Phone side-by-side on sm+ -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-200">
            <!-- Email -->
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${siteConfig.email}`} class="hover:text-emerald-400 transition-colors">
                {siteConfig.email}
              </a>
            </div>

            <!-- Phone & WhatsApp -->
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href="tel:+919003098708" class="hover:text-emerald-400 transition-colors">
                {siteConfig.phone}
              </a>
              <a
                href="https://wa.me/919003098708?text=Hello%20ZIYA%20ZARA,%20I%20would%20like%20to%20inquire%20about%20your%20export%20commodities"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400 hover:text-emerald-300 ml-1 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/30 transition-colors"
                title="Chat on WhatsApp"
              >
                <span>WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Row 2: Location -->
          <div class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-200">
            <svg class="w-4 h-4 text-white flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteConfig.location}</span>
          </div>

        </div>

      </div>

      <!-- Right Column: Clean White Floating Inquiry Card Matching Mockup -->
      <div class="lg:col-span-7">
        <div class="scroll-reveal-right bg-white rounded-2xl p-6 sm:p-8 lg:p-9 shadow-2xl text-slate-800 border border-slate-100">
          
          <div class="mb-5">
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-navy-950">
              Send an Inquiry
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Tell us about your requirements and our team will get back to you.
            </p>
          </div>

          <form id="landing-contact-form" class="space-y-4">
            
            <!-- Row 1: Name, Business Email, Company -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
              
              <!-- Name -->
              <div class="space-y-1">
                <label for="contact-name" class="block text-xs font-semibold text-slate-700">
                  Name <span class="text-emerald-600">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 focus:outline-none transition-colors"
                />
              </div>

              <!-- Email -->
              <div class="space-y-1">
                <label for="contact-email" class="block text-xs font-semibold text-slate-700">
                  Business Email <span class="text-emerald-600">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="your@email.com"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 focus:outline-none transition-colors"
                />
              </div>

              <!-- Company -->
              <div class="space-y-1">
                <label for="contact-company" class="block text-xs font-semibold text-slate-700">
                  Company
                </label>
                <input
                  type="text"
                  id="contact-company"
                  name="company"
                  placeholder="Your company name"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 focus:outline-none transition-colors"
                />
              </div>

            </div>

            <!-- Row 2: Interested In & Message -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3.5">
              
              <!-- Interested In -->
              <div class="sm:col-span-5 space-y-1">
                <label for="contact-interest" class="block text-xs font-semibold text-slate-700">
                  Interested In <span class="text-emerald-600">*</span>
                </label>
                <select
                  id="contact-interest"
                  name="interest"
                  required
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-xs sm:text-sm text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 focus:outline-none transition-colors cursor-pointer bg-white"
                >
                  <option value="" disabled selected>Select an option</option>
                  <option value="Agricultural Products">Agricultural Products</option>
                  <option value="Food & Grains">Food & Grains</option>
                  <option value="Textiles & Garments">Textiles & Garments</option>
                  <option value="Industrial Supplies">Industrial Supplies</option>
                  <option value="Consumer Goods">Consumer Goods</option>
                  <option value="Custom Sourcing">Custom Sourcing</option>
                  <option value="Multi-Mode Logistics">Multi-Mode Logistics</option>
                </select>
              </div>

              <!-- Message -->
              <div class="sm:col-span-7 space-y-1">
                <label for="contact-message" class="block text-xs font-semibold text-slate-700">
                  Message <span class="text-emerald-600">*</span>
                </label>
                <input
                  type="text"
                  id="contact-message"
                  name="message"
                  required
                  placeholder="Tell us about your requirements..."
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 focus:outline-none transition-colors"
                />
              </div>

            </div>

            <!-- Submit Button Matching Mockup -->
            <div class="pt-2">
              <button
                type="submit"
                class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-md hover:shadow-lg group cursor-pointer"
              >
                <span>Submit Inquiry</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Simple inquiry form mailto handler
  const form = document.getElementById('landing-contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') || '';
      const email = formData.get('email') || '';
      const company = formData.get('company') || '';
      const interest = formData.get('interest') || '';
      const message = formData.get('message') || '';

      const subject = encodeURIComponent(`Trade Inquiry: ${interest} - ${company || name}`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\nCompany: ${company}\nInterest: ${interest}\n\nRequirements:\n${message}`
      );

      window.location.href = `mailto:info@ziyazaratrading.com?subject=${subject}&body=${body}`;
    });
  }
</script>
