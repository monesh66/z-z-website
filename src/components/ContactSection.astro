---
import { siteConfig } from '../data/site';
import { productCategories } from '../data/products';
---

<section id="contact" class="py-20 lg:py-28 bg-[#F8FAFC] text-navy-950 border-t border-slate-200/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Executive Trade Invitation & Contact Details -->
      <div class="lg:col-span-5 space-y-8 scroll-reveal-left">
        
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
            <span class="w-8 h-0.5 bg-emerald-600"></span>
            <span>Get in Touch</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-navy-950 tracking-tight leading-tight">
            Let's Create <br />
            <span class="text-emerald-700 font-editorial-serif italic font-normal">Global Opportunities.</span>
          </h2>
          <p class="text-base text-slate-600 font-normal leading-relaxed pt-2">
            We are always open to new trading opportunities, procurement requirements, and strategic global partnerships. Share your specifications with our trade desk.
          </p>
        </div>

        <!-- Contact Channels List -->
        <div class="space-y-4 pt-4 border-t border-slate-200">
          
          <!-- Email Channel -->
          <a
            href={`mailto:${siteConfig.email}`}
            class="flex items-start gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-xs hover:border-emerald-500/50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500">Official Trade Inquiries</div>
              <div class="text-sm font-semibold text-navy-950 group-hover:text-emerald-700 transition-colors mt-0.5">
                {siteConfig.email}
              </div>
            </div>
          </a>

          <!-- Phone Channel -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500">Trade Desk Direct</div>
              <div class="text-sm font-semibold text-navy-950 mt-0.5">
                {siteConfig.phone}
              </div>
            </div>
          </div>

          <!-- Location Channel -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500">Commercial Operations</div>
              <div class="text-sm font-semibold text-navy-950 mt-0.5">
                {siteConfig.location}
              </div>
            </div>
          </div>

        </div>

        <!-- Static Website Transparency Notice -->
        <div class="p-4 rounded-xl bg-white border border-slate-200 text-xs text-slate-600 leading-relaxed shadow-xs">
          <span class="font-semibold text-emerald-700">Direct Communication Guarantee:</span> Submitting an inquiry will prepare an official structured email addressed directly to our trade officer for immediate evaluation.
        </div>

      </div>

      <!-- Right Column: Interactive Commercial Inquiry Form -->
      <div class="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 lg:p-10 border border-slate-200 shadow-xl scroll-reveal-right stagger-1">
        
        <div class="mb-8">
          <h3 class="text-2xl font-bold font-display text-navy-950">Send an Inquiry</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Specify your commercial requirements below. Our sourcing desk will review and reply with feasibility and price indications.
          </p>
        </div>

        <form id="trade-inquiry-form" class="space-y-5" novalidate>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Full Name -->
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-semibold text-slate-700">
                Your Name <span class="text-emerald-600">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Johnathan Miller"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
              />
            </div>

            <!-- Business Email -->
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-semibold text-slate-700">
                Business Email <span class="text-emerald-600">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="name@company.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Company Name -->
            <div class="space-y-1.5">
              <label for="contact-company" class="block text-xs font-semibold text-slate-700">
                Company / Organization <span class="text-emerald-600">*</span>
              </label>
              <input
                type="text"
                id="contact-company"
                name="company"
                required
                placeholder="e.g. Miller Commodities Ltd."
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
              />
            </div>

            <!-- Product / Sourcing Interest -->
            <div class="space-y-1.5">
              <label for="contact-interest" class="block text-xs font-semibold text-slate-700">
                Product Interest <span class="text-emerald-600">*</span>
              </label>
              <select
                id="contact-interest"
                name="interest"
                required
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors cursor-pointer"
              >
                <option value="" disabled selected>Select Product Category</option>
                {productCategories.map((cat) => (
                  <option value={cat.title}>{cat.title}</option>
                ))}
                <option value="Multi-Modal Logistics Consultation">Multi-Modal Logistics Solutions</option>
                <option value="General Commercial Partnership">General Trade Partnership</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Destination Country / Port -->
            <div class="space-y-1.5">
              <label for="contact-destination" class="block text-xs font-semibold text-slate-700">
                Destination Country / Port
              </label>
              <input
                type="text"
                id="contact-destination"
                name="destination"
                placeholder="e.g. Rotterdam Port / Jebel Ali"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
              />
            </div>

            <!-- Approximate Volume / Quantity -->
            <div class="space-y-1.5">
              <label for="contact-volume" class="block text-xs font-semibold text-slate-700">
                Estimated Volume / Target Incoterms
              </label>
              <input
                type="text"
                id="contact-volume"
                name="volume"
                placeholder="e.g. 5 x 40ft FCL / CIF terms"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
              />
            </div>
          </div>

          <!-- Message / Detailed Requirements -->
          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-semibold text-slate-700">
              Requirement Details & Technical Specifications <span class="text-emerald-600">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Please describe technical specifications, required grading/certifications, preferred delivery timeline, and port of discharge..."
              class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors"
            ></textarea>
          </div>

          <!-- Submission Feedback Box -->
          <div id="form-error-msg" class="hidden p-3 rounded-lg bg-red-50 border border-red-300 text-red-700 text-xs">
            Please fill in all required fields marked with an asterisk (*).
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-inquiry-btn"
              class="trade-btn-primary w-full py-4 text-base font-semibold shadow-md group cursor-pointer"
            >
              <span>Submit Inquiry</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>

          <!-- Instructions Notice -->
          <p class="text-[11px] text-slate-500 text-center leading-normal pt-1">
            Clicking Submit prepares an email addressed to <span class="text-emerald-700 font-mono font-semibold">{siteConfig.email}</span> with your inquiry structured for immediate trade review.
          </p>

        </form>

        <!-- Dynamic Success & Fallback Modal Drawer -->
        <div id="inquiry-fallback-modal" class="hidden mt-6 p-6 rounded-xl bg-slate-50 border border-emerald-300 text-left space-y-4">
          <div class="flex items-center gap-3 text-emerald-800">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <h4 class="text-sm font-bold">Email Client Opened</h4>
          </div>
          <p class="text-xs text-slate-600">
            If your email application did not launch automatically, you can copy the pre-composed inquiry below and email it directly to <strong class="text-navy-950 font-mono">{siteConfig.email}</strong>.
          </p>
          <div class="bg-white p-3 rounded-lg text-xs font-mono text-slate-800 overflow-x-auto max-h-36 whitespace-pre-wrap border border-slate-200" id="inquiry-text-preview"></div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="copy-inquiry-btn"
              class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors flex items-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span id="copy-btn-text">Copy Inquiry Details</span>
            </button>
            <a
              id="manual-mailto-link"
              href={`mailto:${siteConfig.email}`}
              class="text-xs text-emerald-700 hover:underline font-semibold"
            >
              Open Direct Mailto Link
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  // Handle URL query parameters for pre-filling category
  const urlParams = new URLSearchParams(window.location.search);
  const interestParam = urlParams.get('interest');
  const interestSelect = document.getElementById('contact-interest') as HTMLSelectElement | null;
  if (interestParam && interestSelect) {
    for (let i = 0; i < interestSelect.options.length; i++) {
      if (interestSelect.options[i].value.toLowerCase().includes(interestParam.toLowerCase()) ||
          interestParam.toLowerCase().includes(interestSelect.options[i].value.toLowerCase())) {
        interestSelect.selectedIndex = i;
        break;
      }
    }
  }

  // Handle Form Submission
  const form = document.getElementById('trade-inquiry-form') as HTMLFormElement | null;
  const errorMsg = document.getElementById('form-error-msg');
  const fallbackModal = document.getElementById('inquiry-fallback-modal');
  const inquiryTextPreview = document.getElementById('inquiry-text-preview');
  const copyBtn = document.getElementById('copy-inquiry-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const manualMailtoLink = document.getElementById('manual-mailto-link') as HTMLAnchorElement | null;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const companyInput = document.getElementById('contact-company') as HTMLInputElement | null;
      const interestInput = document.getElementById('contact-interest') as HTMLSelectElement | null;
      const destinationInput = document.getElementById('contact-destination') as HTMLInputElement | null;
      const volumeInput = document.getElementById('contact-volume') as HTMLInputElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const company = companyInput?.value.trim() || '';
      const interest = interestInput?.value || '';
      const destination = destinationInput?.value.trim() || 'Not specified';
      const volume = volumeInput?.value.trim() || 'Not specified';
      const message = messageInput?.value.trim() || '';

      if (!name || !email || !company || !interest || !message) {
        if (errorMsg) errorMsg.classList.remove('hidden');
        return;
      }

      if (errorMsg) errorMsg.classList.add('hidden');

      const subject = `Trade Sourcing Inquiry: ${interest} - ${company}`;
      const body = `Dear ZIYA ZARA Trading Desk,

I would like to discuss a trade sourcing requirement:

- Full Name: ${name}
- Business Email: ${email}
- Company: ${company}
- Product Category / Interest: ${interest}
- Target Destination Port / Country: ${destination}
- Estimated Volume / Incoterms: ${volume}

Requirements & Specifications:
${message}

Please advise on feasibility, availability, and quotation terms at your earliest convenience.

Kind regards,
${name}
${company}`;

      const recipientEmail = "info@ziyazaratrading.com";
      const mailtoUrl = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      // Show fallback box and preview
      if (fallbackModal && inquiryTextPreview) {
        inquiryTextPreview.textContent = body;
        fallbackModal.classList.remove('hidden');
      }

      if (manualMailtoLink) {
        manualMailtoLink.href = mailtoUrl;
      }

      // Trigger mailto link
      window.location.href = mailtoUrl;
    });
  }

  // Copy details button
  if (copyBtn && inquiryTextPreview && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const textToCopy = inquiryTextPreview.textContent || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        copyBtnText.textContent = "Copied to Clipboard!";
        setTimeout(() => {
          copyBtnText.textContent = "Copy Inquiry Details";
        }, 3000);
      });
    });
  }
</script>
