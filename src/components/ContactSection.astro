---
import { siteConfig } from '../data/site';
import { productCategories } from '../data/products';
---

<section id="contact" class="py-16 lg:py-20 bg-[#0B1F36] text-white relative overflow-hidden">
  <!-- Subtle Industrial Harbor Silhouette Background Overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FFFFFF_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Executive Trade Invitation & Contact Details (col-span-5) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Get in Touch</span>
            <span class="w-8 h-[2px] bg-[#138848]"></span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-editorial-serif text-white tracking-tight leading-tight">
            Let's Create<br />
            Global Opportunities
          </h2>

          <p class="text-xs sm:text-sm text-slate-300 font-normal leading-relaxed pt-1 max-w-md">
            We are always open to new opportunities, partnerships and inquiries. Reach out to us and our team will get back to you shortly.
          </p>
        </div>

        <!-- Verified Contact Details List with Icons -->
        <div class="space-y-4 pt-2">
          
          <!-- Email -->
          <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-200">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center flex-shrink-0 text-slate-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-emerald-400 transition-colors">
              {siteConfig.email}
            </a>
          </div>

          <!-- Phone -->
          <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-200">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center flex-shrink-0 text-slate-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <span>{siteConfig.phone}</span>
          </div>

          <!-- Location -->
          <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-200">
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center flex-shrink-0 text-slate-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span>{siteConfig.location}</span>
          </div>

        </div>

      </div>

      <!-- Right Column: White Card Form (col-span-7) -->
      <div class="lg:col-span-7 bg-white text-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl">
        
        <div class="mb-6 space-y-1">
          <h3 class="text-xl sm:text-2xl font-bold font-editorial-serif text-[#0B1F36]">
            Send an Inquiry
          </h3>
          <p class="text-xs text-slate-500">
            Tell us about your requirements and our team will get back to you:
          </p>
        </div>

        <form id="trade-inquiry-form" class="space-y-4" novalidate>
          
          <!-- Row 1: Name, Email, Company -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="space-y-1">
              <label for="contact-name" class="block text-[11px] font-semibold text-slate-700">
                Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Your name"
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#138848]"
              />
            </div>

            <div class="space-y-1">
              <label for="contact-email" class="block text-[11px] font-semibold text-slate-700">
                Business Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="your@email.com"
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#138848]"
              />
            </div>

            <div class="space-y-1">
              <label for="contact-company" class="block text-[11px] font-semibold text-slate-700">
                Company
              </label>
              <input
                type="text"
                id="contact-company"
                name="company"
                placeholder="Your company name"
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#138848]"
              />
            </div>
          </div>

          <!-- Row 2: Interested In & Message -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
            <!-- Interested In (col-span-5) -->
            <div class="sm:col-span-5 space-y-1">
              <label for="contact-interest" class="block text-[11px] font-semibold text-slate-700">
                Interested In <span class="text-red-500">*</span>
              </label>
              <select
                id="contact-interest"
                name="interest"
                required
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 text-slate-800 bg-white focus:outline-none focus:border-[#138848] cursor-pointer"
              >
                <option value="" disabled selected>Select an option</option>
                {productCategories.map((cat) => (
                  <option value={cat.title}>{cat.title}</option>
                ))}
                <option value="Multi-Mode Logistics Solutions">Multi-Mode Logistics</option>
                <option value="General Trade Partnership">General Trade Partnership</option>
              </select>
            </div>

            <!-- Message (col-span-7) -->
            <div class="sm:col-span-7 space-y-1">
              <label for="contact-message" class="block text-[11px] font-semibold text-slate-700">
                Message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="2"
                required
                placeholder="Tell us about your requirements..."
                class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#138848]"
              ></textarea>
            </div>
          </div>

          <!-- Validation Error Message -->
          <div id="form-error-msg" class="hidden p-2 text-xs text-red-600 bg-red-50 rounded-md">
            Please fill in all required fields marked with an asterisk (*).
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-inquiry-btn"
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm cursor-pointer group"
            >
              <span>Submit Inquiry</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>

        </form>

        <!-- Dynamic Success & Fallback Modal -->
        <div id="inquiry-fallback-modal" class="hidden mt-4 p-4 rounded-xl bg-slate-50 border border-emerald-500 text-left space-y-3">
          <div class="flex items-center gap-2 text-[#138848]">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <h4 class="text-xs font-bold">Email Client Opened</h4>
          </div>
          <p class="text-[11px] text-slate-600">
            If your email app did not launch automatically, you can copy the inquiry details below and email them directly to <strong class="text-slate-900">{siteConfig.email}</strong>:
          </p>
          <div class="bg-white p-2.5 rounded-lg text-xs font-mono text-slate-700 overflow-x-auto max-h-28 whitespace-pre-wrap border border-slate-200" id="inquiry-text-preview"></div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="copy-inquiry-btn"
              class="px-3 py-1.5 rounded-md bg-[#138848] text-white text-xs font-medium hover:bg-[#0f6f3b] transition-colors"
            >
              <span id="copy-btn-text">Copy Inquiry Details</span>
            </button>
            <a
              id="manual-mailto-link"
              href={`mailto:${siteConfig.email}`}
              class="text-xs text-[#138848] underline font-medium"
            >
              Open Direct Mailto
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('trade-inquiry-form') as HTMLFormElement | null;
  const errorMsg = document.getElementById('form-error-msg');
  const fallbackModal = document.getElementById('inquiry-fallback-modal');
  const inquiryTextPreview = document.getElementById('inquiry-text-preview');
  const copyBtn = document.getElementById('copy-inquiry-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const manualMailtoLink = document.getElementById('manual-mailto-link') as HTMLAnchorElement | null;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const companyInput = document.getElementById('contact-company') as HTMLInputElement | null;
      const interestInput = document.getElementById('contact-interest') as HTMLSelectElement | null;
      const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const name = nameInput?.value.trim() || '';
      const email = emailInput?.value.trim() || '';
      const company = companyInput?.value.trim() || '';
      const interest = interestInput?.value || '';
      const message = messageInput?.value.trim() || '';

      if (!name || !email || !interest || !message) {
        if (errorMsg) errorMsg.classList.remove('hidden');
        return;
      }

      if (errorMsg) errorMsg.classList.add('hidden');

      const subject = `Trade Sourcing Inquiry: ${interest} - ${company || name}`;
      const body = `Dear ZIYA ZARA Trading Desk,

I would like to submit a trade sourcing inquiry:

- Name: ${name}
- Business Email: ${email}
- Company: ${company || 'N/A'}
- Interested In: ${interest}

Requirements / Message:
${message}

Looking forward to your response.

Best regards,
${name}`;

      const recipientEmail = "your@email.com";
      const mailtoUrl = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (fallbackModal && inquiryTextPreview) {
        inquiryTextPreview.textContent = body;
        fallbackModal.classList.remove('hidden');
      }

      if (manualMailtoLink) {
        manualMailtoLink.href = mailtoUrl;
      }

      window.location.href = mailtoUrl;
    });
  }

  if (copyBtn && inquiryTextPreview && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const textToCopy = inquiryTextPreview.textContent || '';
      navigator.clipboard.writeText(textToCopy).then(() => {
        copyBtnText.textContent = "Copied!";
        setTimeout(() => {
          copyBtnText.textContent = "Copy Inquiry Details";
        }, 3000);
      });
    });
  }
</script>
