          const ringAlpha = (1 - ringProgress) * 0.8;

          ctx.beginPath();
          ctx.arc(h.x, h.y, ringR, 0, Math.PI * 2);
          ctx.strokeStyle = h.color;
          ctx.globalAlpha = ringAlpha;
          ctx.lineWidth = 1.6 * (1 - ringProgress * 0.6);
          ctx.stroke();
        }

        // Pin base shadow & ring
        ctx.globalAlpha = 1;
        ctx.beginPath();
        ctx.arc(h.x, h.y, 7.5, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = 'rgba(15, 23, 42, 0.25)';
        ctx.shadowBlur = 4;
        ctx.shadowOffsetY = 2;
        ctx.fill();
        ctx.shadowColor = 'transparent';

        ctx.beginPath();
        ctx.arc(h.x, h.y, 6.0, 0, Math.PI * 2);
        ctx.fillStyle = h.color;
        ctx.fill();

        // Beating white core
        const heart = 2.6 + Math.sin(now * 3.5) * 0.5;
        ctx.beginPath();
        ctx.arc(h.x, h.y, heart, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      }

      ctx.restore();
      animId = requestAnimationFrame(render);
    }

    // IntersectionObserver halts RAF when scrolled away (0% CPU load)
    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      isVisible = entry.isIntersecting;
      if (isVisible && !animId) {
        animId = requestAnimationFrame(render);
      } else if (!isVisible && animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    }, { threshold: 0.05 });
    observer.observe(wrapper);

    animId = requestAnimationFrame(render);
  })();
</script>
