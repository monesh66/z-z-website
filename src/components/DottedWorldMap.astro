<style>
  /* Base Dot Matrix Styling */
  .world-dots-matrix circle {
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.3s ease, fill 0.3s ease;
  }

  /* High-Contrast Shimmer Wave Sweeping from West to East across Longitude Bands */
  .dot-band {
    animation: radarScanWave 4.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: opacity, transform;
  }

  .dot-band-0  { animation-delay: 0.0s; }
  .dot-band-1  { animation-delay: 0.35s; }
  .dot-band-2  { animation-delay: 0.70s; }
  .dot-band-3  { animation-delay: 1.05s; }
  .dot-band-4  { animation-delay: 1.40s; }
  .dot-band-5  { animation-delay: 1.75s; }
  .dot-band-6  { animation-delay: 2.10s; }
  .dot-band-7  { animation-delay: 2.45s; }
  .dot-band-8  { animation-delay: 2.80s; }
  .dot-band-9  { animation-delay: 3.15s; }
  .dot-band-10 { animation-delay: 3.50s; }
  .dot-band-11 { animation-delay: 3.85s; }

  @keyframes radarScanWave {
    0%, 100% {
      opacity: 0.52;
    }
    30% {
      opacity: 1;
    }
  }

  /* Default Dot Colors */
  .map-dot {
    fill: #7daeed;
    opacity: 0.55;
  }

  /* Asynchronous Organic Twinkle on Active Digital Nodes */
  .tw-0 { animation: dotTwinkle 3.2s ease-in-out infinite 0.1s; }
  .tw-1 { animation: dotTwinkle 3.6s ease-in-out infinite 0.7s; }
  .tw-2 { animation: dotTwinkle 4.0s ease-in-out infinite 1.3s; }
  .tw-3 { animation: dotTwinkle 3.4s ease-in-out infinite 1.9s; }
  .tw-4 { animation: dotTwinkle 4.2s ease-in-out infinite 2.5s; }
  .tw-5 { animation: dotTwinkle 3.8s ease-in-out infinite 3.1s; }

  @keyframes dotTwinkle {
    0%, 100% {
      opacity: 0.40;
      fill: #82b2ec;
      transform: scale(0.9);
    }
    50% {
      opacity: 0.98;
      fill: #2563eb;
      transform: scale(1.35);
    }
  }

  /* Active Trade Route Hub Area Dots (Glowing Green/Emerald Pulse) */
  .act-dot {
    animation: tradeNodePulse 3s ease-in-out infinite;
  }

  @keyframes tradeNodePulse {
    0%, 100% {
      fill: #60a5fa;
      opacity: 0.5;
      transform: scale(0.95);
    }
    50% {
      fill: #10b981;
      opacity: 1;
      transform: scale(1.4);
    }
  }

  /* Faint background guide arc for trade routes */
  .trade-route-base {
    fill: none;
    stroke: #86efac;
    stroke-width: 1.2;
    opacity: 0.35;
    stroke-linecap: round;
  }

  /* Flowing Green Dashed Trade Corridors */
  .trade-route-path {
    fill: none;
    stroke: #10b981;
    stroke-width: 2.0;
    stroke-dasharray: 5, 6;
    stroke-linecap: round;
    animation: flowRoutes linear infinite;
    opacity: 0.95;
