<style>
  /* Base Dot Matrix Styling - Static styles, 0 reflow overhead */
  .world-dots-matrix circle {
    fill: #7cb3ea;
    opacity: 0.65;
  }

  /* West-to-East Staggered Shimmer Wave on only 12 group nodes (GPU Composited) */
  .dot-band {
    animation: waveShimmer 5s ease-in-out infinite;
    will-change: opacity;
  }

  .dot-band-0  { animation-delay: 0.0s; }
  .dot-band-1  { animation-delay: 0.4s; }
  .dot-band-2  { animation-delay: 0.8s; }
  .dot-band-3  { animation-delay: 1.2s; }
  .dot-band-4  { animation-delay: 1.6s; }
  .dot-band-5  { animation-delay: 2.0s; }
  .dot-band-6  { animation-delay: 2.4s; }
  .dot-band-7  { animation-delay: 2.8s; }
  .dot-band-8  { animation-delay: 3.2s; }
  .dot-band-9  { animation-delay: 3.6s; }
  .dot-band-10 { animation-delay: 4.0s; }
  .dot-band-11 { animation-delay: 4.4s; }

  @keyframes waveShimmer {
    0%, 100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.95;
    }
  }

  /* Animated Trade Route Corridors */
  .trade-route-path {
    fill: none;
    stroke: #10b981;
    stroke-width: 1.8;
    stroke-dasharray: 4, 4.5;
    stroke-linecap: round;
    animation: flowRoutes linear infinite;
    opacity: 0.95;
    will-change: stroke-dashoffset;
  }

  @keyframes flowRoutes {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Hub Radar Ripple Animation */
  .radar-ring {
    fill: none;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .radar-ring.ring-1 {
    animation: radarExpand 2.8s cubic-bezier(0.1, 0.4, 0.6, 1) infinite;
  }

  .radar-ring.ring-2 {
    animation: radarExpand 2.8s cubic-bezier(0.1, 0.4, 0.6, 1) infinite 1.4s;
  }

  @keyframes radarExpand {
    0% {
      r: 4;
      opacity: 0.9;
      stroke-width: 2;
    }
    80% {
      opacity: 0.25;
      stroke-width: 1;
    }
    100% {
      r: 22;
      opacity: 0;
      stroke-width: 0.5;
    }
  }

  /* Interactive Hover on Hubs */
  .hub-beacon {
    cursor: pointer;
  }

  .hub-tooltip {
    opacity: 0;
    transform: translateY(4px);
  }

  .hub-beacon:hover .hub-tooltip {
    opacity: 1;
    transform: translateY(0);
  }
</style>
