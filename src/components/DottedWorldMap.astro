<style>
  /* Base Dot Matrix Styling matching mockup rich blue tone */
  .world-dots-matrix circle {
    fill: #7cb3ea;
    opacity: 0.62;
    transition: opacity 0.3s ease, fill 0.3s ease;
  }

  /* West-to-East Staggered Shimmer Wave */
  .dot-band {
    animation: waveShimmer 6s ease-in-out infinite;
  }

  .dot-band-0  { animation-delay: 0.0s; }
  .dot-band-1  { animation-delay: 0.35s; }
  .dot-band-2  { animation-delay: 0.70s; }
  .dot-band-3  { animation-delay: 1.05s; }
  .dot-band-4  { animation-delay: 1.40s; }
  .dot-band-5  { animation-delay: 1.75s; }
  .dot-band-6  { animation-delay: 2.10s; }
  .dot-band-7  { animation-delay: 2.45s; }
  .dot-band-8  { animation-delay: 2.80s; }
  .dot-band-9  { animation-delay: 3.15s; }
  .dot-band-10 { animation-delay: 3.50s; }
  .dot-band-11 { animation-delay: 3.85s; }
  .dot-band-12 { animation-delay: 4.20s; }
  .dot-band-13 { animation-delay: 4.55s; }
  .dot-band-14 { animation-delay: 4.90s; }
  .dot-band-15 { animation-delay: 5.25s; }

  @keyframes waveShimmer {
    0%, 100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }

  .dot-band:nth-child(even) circle {
    animation: dotBreathe 4s ease-in-out infinite alternate;
  }

  @keyframes dotBreathe {
    0% {
      opacity: 0.50;
      fill: #7cb3ea;
    }
    100% {
      opacity: 0.95;
      fill: #3b82f6;
    }
  }

  /* Animated Trade Route Corridors */
  .trade-route-path {
    fill: none;
    stroke: #10b981;
    stroke-width: 1.8;
    stroke-dasharray: 4, 4.5;
    stroke-linecap: round;
    animation: flowRoutes linear infinite;
    opacity: 0.95;
  }

  @keyframes flowRoutes {
    from {
      stroke-dashoffset: 36;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Hub Radar Ripple Animation */
  .radar-ring {
    fill: none;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    pointer-events: none;
  }

  .radar-ring.ring-1 {
    animation: radarExpand 2.8s cubic-bezier(0.1, 0.4, 0.6, 1) infinite;
  }

  .radar-ring.ring-2 {
    animation: radarExpand 2.8s cubic-bezier(0.1, 0.4, 0.6, 1) infinite 1.4s;
  }

  @keyframes radarExpand {
    0% {
      r: 4;
      opacity: 0.9;
      stroke-width: 2;
    }
    80% {
      opacity: 0.25;
      stroke-width: 1;
    }
    100% {
      r: 22;
      opacity: 0;
      stroke-width: 0.5;
    }
  }

  /* Interactive Hover on Hubs */
  .hub-beacon {
    cursor: pointer;
  }

  .hub-tooltip {
    opacity: 0;
    transform: translateY(4px);
  }

  .hub-beacon:hover .hub-tooltip {
    opacity: 1;
    transform: translateY(0);
  }
</style>
