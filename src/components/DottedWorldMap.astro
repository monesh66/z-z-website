<style>
  .hub-interactive-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 24px;
    height: 24px;
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hub-pin-target {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hub-interactive-pin:hover .hub-pin-target {
    transform: scale(1.35);
  }

  .hub-tooltip {
    position: absolute;
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(4px);
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 11px;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hub-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .hub-interactive-pin:hover .hub-tooltip,
  .hub-interactive-pin:focus .hub-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

