---
import { siteConfig } from '../data/site';
---

<footer class="bg-[#050E1A] text-white pt-14 pb-10 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Footer 5-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-white/10">
      
      <!-- Col 1: Brand & Positioning (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-block" aria-label="ZIYA ZARA TRADING COMPANY">
          <img
            src="/images/logo/logo-dark.png"
            alt="ZIYA ZARA TRADING COMPANY Logo"
            width="240"
            height="60"
            class="h-10 sm:h-12 w-auto object-contain"
            loading="lazy"
          />
        </a>

        <p class="text-xs text-slate-400 font-normal leading-relaxed max-w-sm">
          Connecting Markets, Delivering Possibilities.
        </p>
      </div>

      <!-- Col 2: Quick Links 1 (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">
          Quick Links
        </div>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/" class="hover:text-emerald-400 transition-colors">Home</a></li>
          <li><a href="/#about" class="hover:text-emerald-400 transition-colors">About</a></li>
          <li><a href="/#sourcing" class="hover:text-emerald-400 transition-colors">Sourcing</a></li>
          <li><a href="/#products" class="hover:text-emerald-400 transition-colors">Products</a></li>
        </ul>
      </div>

      <!-- Col 3: Quick Links 2 (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-transparent font-mono select-none hidden lg:block">
          More Links
        </div>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/#network" class="hover:text-emerald-400 transition-colors">Global Reach</a></li>
          <li><a href="/#founders" class="hover:text-emerald-400 transition-colors">Founders</a></li>
          <li><a href="/#contact" class="hover:text-emerald-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact Details (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">
          Contact
        </div>
        <ul class="space-y-2 text-xs text-slate-400">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-emerald-300 truncate">
              {siteConfig.email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{siteConfig.phone}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="truncate">{siteConfig.location}</span>
          </li>
        </ul>
      </div>

      <!-- Col 5: Follow Us Social (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">
          Follow Us
        </div>
        <div class="flex items-center gap-2 pt-1">
          <!-- LinkedIn -->
          <a href="#" class="w-7 h-7 rounded-full bg-white/10 hover:bg-emerald-600 flex items-center justify-center text-white transition-colors" aria-label="LinkedIn">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </a>
          <!-- Facebook -->
          <a href="#" class="w-7 h-7 rounded-full bg-white/10 hover:bg-emerald-600 flex items-center justify-center text-white transition-colors" aria-label="Facebook">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
          </a>
          <!-- Twitter / X -->
          <a href="#" class="w-7 h-7 rounded-full bg-white/10 hover:bg-emerald-600 flex items-center justify-center text-white transition-colors" aria-label="Twitter">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- YouTube -->
          <a href="#" class="w-7 h-7 rounded-full bg-white/10 hover:bg-emerald-600 flex items-center justify-center text-white transition-colors" aria-label="YouTube">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <!-- Instagram -->
          <a href="#" class="w-7 h-7 rounded-full bg-white/10 hover:bg-emerald-600 flex items-center justify-center text-white transition-colors" aria-label="Instagram">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; {new Date().getFullYear()} ZIYA ZARA TRADING COMPANY. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <span class="text-slate-700">|</span>
        <a href="#" class="hover:text-slate-400 transition-colors">Terms of Use</a>
        <span class="text-slate-700">|</span>
        <a href="/sitemap.xml" class="hover:text-slate-400 transition-colors">Sitemap</a>
      </div>
    </div>

  </div>
</footer>
