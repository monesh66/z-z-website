---
import { siteConfig } from '../data/site';
---

<footer class="bg-[#071524] text-white border-t border-slate-800 pt-12 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Logo, Links, Contact, Social -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-10 border-b border-slate-800">
      
      <!-- Brand & Tagline (col-span-4) -->
      <div class="lg:col-span-4 space-y-3">
        <a href="/" class="inline-block" aria-label="ZIYA ZARA TRADING COMPANY">
          <img
            src="/images/logo/logo-dark.svg"
            alt="ZIYA ZARA TRADING COMPANY Logo"
            width="220"
            height="44"
            class="h-9 sm:h-10 w-auto object-contain"
            loading="lazy"
          />
        </a>

        <p class="text-[11px] text-slate-400 font-normal pt-0.5">
          {siteConfig.tagline}
        </p>
      </div>

      <!-- Quick Links Column 1 (col-span-2) -->
      <div class="lg:col-span-2 space-y-2.5">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Quick Links
        </div>
        <ul class="space-y-1.5 text-xs text-slate-400">
          <li><a href="/" class="hover:text-emerald-400 transition-colors">Home</a></li>
          <li><a href="/#about" class="hover:text-emerald-400 transition-colors">About</a></li>
          <li><a href="/#sourcing-process" class="hover:text-emerald-400 transition-colors">Sourcing</a></li>
          <li><a href="/#products" class="hover:text-emerald-400 transition-colors">Products</a></li>
        </ul>
      </div>

      <!-- Quick Links Column 2 (col-span-2) -->
      <div class="lg:col-span-2 space-y-2.5 pt-6 sm:pt-0">
        <ul class="space-y-1.5 text-xs text-slate-400 mt-0 sm:mt-6">
          <li><a href="/#global-reach" class="hover:text-emerald-400 transition-colors">Global Reach</a></li>
          <li><a href="/#founders" class="hover:text-emerald-400 transition-colors">Founders</a></li>
          <li><a href="/#contact" class="hover:text-emerald-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Contact Info (col-span-2) -->
      <div class="lg:col-span-2 space-y-2.5">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Contact
        </div>
        <ul class="space-y-2 text-xs text-slate-400">
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-emerald-400 transition-colors truncate">
              {siteConfig.email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{siteConfig.phone}</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteConfig.location}</span>
          </li>
        </ul>
      </div>

      <!-- Follow Us (col-span-2) -->
      <div class="lg:col-span-2 space-y-2.5">
        <div class="text-xs font-bold text-white uppercase tracking-wider">
          Follow Us
        </div>
        <div class="flex items-center gap-2">
          <!-- LinkedIn -->
          <a href="#" class="w-7 h-7 rounded-full bg-slate-800 hover:bg-[#138848] flex items-center justify-center text-white transition-colors" aria-label="LinkedIn">
            <span class="text-[11px] font-bold">in</span>
          </a>
          <!-- Facebook -->
          <a href="#" class="w-7 h-7 rounded-full bg-slate-800 hover:bg-[#138848] flex items-center justify-center text-white transition-colors" aria-label="Facebook">
            <span class="text-[11px] font-bold">f</span>
          </a>
          <!-- YouTube -->
          <a href="#" class="w-7 h-7 rounded-full bg-slate-800 hover:bg-[#138848] flex items-center justify-center text-white transition-colors" aria-label="YouTube">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 22c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 2c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="#" class="w-7 h-7 rounded-full bg-slate-800 hover:bg-[#138848] flex items-center justify-center text-white transition-colors" aria-label="Instagram">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Row: Copyright & Legal -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; 2026 {siteConfig.legalName}. All rights reserved.
      </div>

      <div class="flex items-center gap-4 text-xs">
        <a href="#" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <span>|</span>
        <a href="#" class="hover:text-slate-300 transition-colors">Terms of Use</a>
        <span>|</span>
        <a href="/sitemap.xml" class="hover:text-slate-300 transition-colors">Sitemap</a>
      </div>
    </div>

  </div>
</footer>
