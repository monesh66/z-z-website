---
const founders = [
  {
    name: "Founder 01",
    role: "Co-Founder",
    bio: "Driving strategic growth and global partnerships.",
    photo: "/images/founders/mockup-founder-01.png",
  },
  {
    name: "Founder 02",
    role: "Co-Founder",
    bio: "Focused on operations and customer success.",
    photo: "/images/founders/mockup-founder-02.png",
  },
];
---

<section id="founders" class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal text-xs font-bold uppercase tracking-widest text-emerald-600 font-mono">
          OUR FOUNDERS
        </div>

        <!-- Headline -->
        <h2 class="scroll-reveal stagger-1 text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-navy-950 tracking-tight leading-tight">
          Built on Trust.<br />
          Driven by Opportunity.
        </h2>

        <!-- Description -->
        <p class="scroll-reveal stagger-2 text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          Our founders bring a shared vision to connect global markets through integrity, quality and long-term partnerships.
        </p>

      </div>

      <!-- Right Column: 2 Founder Cards -->
      <div class="lg:col-span-7">
        <div data-reveal-group data-reveal-stagger="90" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {founders.map((founder) => (
            <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 flex items-center gap-4 group">
              
              <!-- Silhouette Portrait Photo -->
              <div class="w-20 h-24 sm:w-24 sm:h-28 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
                <img
                  src={founder.photo}
                  alt={`${founder.name} - ${founder.role}`}
                  width="100"
                  height="120"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>

              <!-- Information Details -->
              <div class="flex-grow space-y-1">
                <h3 class="text-base sm:text-lg font-bold text-navy-950 font-display">
                  {founder.name}
                </h3>
                <p class="text-xs text-slate-500 font-medium">
                  {founder.role}
                </p>
                <p class="text-[11px] text-slate-500 leading-relaxed pt-1">
                  {founder.bio}
                </p>
                <!-- LinkedIn Icon -->
                <div class="pt-1.5">
                  <a
                    href="#founders"
                    class="inline-flex items-center justify-center w-6 h-6 rounded-sm bg-[#0077b5] text-white hover:opacity-90 transition-opacity"
                    aria-label={`${founder.name} LinkedIn Profile`}
                  >
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
