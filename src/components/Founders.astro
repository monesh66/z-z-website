---
// Founders Section matching reference mockup 100%
const founders = [
  {
    name: "Founder 01",
    role: "Co-Founder",
    bio: "Driving strategic growth and global partnerships.",
    photo: "/images/founders/founder_01_hd.jpg",
  },
  {
    name: "Founder 02",
    role: "Co-Founder",
    bio: "Focused on operations and customer success.",
    photo: "/images/founders/founder_02_hd.jpg",
  },
];
---

<section id="founders" class="py-16 lg:py-24 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy -->
      <div class="lg:col-span-5 space-y-3">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal flex items-center gap-2.5">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-navy-950 font-mono">
            OUR FOUNDERS
          </span>
          <span class="w-8 h-0.5 bg-emerald-500"></span>
        </div>

        <!-- Headline -->
        <h2 class="scroll-reveal text-2xl sm:text-3xl lg:text-4xl font-bold font-serif text-navy-950 tracking-tight leading-snug">
          Built on Trust.<br class="hidden sm:inline" />
          Driven by Opportunity.
        </h2>

        <!-- Description -->
        <p class="scroll-reveal text-xs sm:text-sm text-slate-600 leading-relaxed font-normal pt-1 max-w-md">
          Our founders bring a shared vision to connect global markets through integrity, quality and long-term partnerships.
        </p>

      </div>

      <!-- Right Column: 2 Founder Cards Matching Mockup 100% -->
      <div class="lg:col-span-7">
        <div data-reveal-group data-reveal-stagger="90" class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
          {founders.map((founder) => (
            <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 flex items-center gap-4 group hover:-translate-y-1">
              
              <!-- HD Silhouette Portrait Photo -->
              <div class="w-22 h-28 sm:w-24 sm:h-30 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
                <img
                  src={founder.photo}
                  alt={`${founder.name} - ${founder.role}`}
                  width="180"
                  height="220"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>

              <!-- Information Details -->
              <div class="flex-grow space-y-1">
                <h3 class="text-sm sm:text-base font-bold text-navy-950">
                  {founder.name}
                </h3>
                <p class="text-xs text-slate-500 font-medium">
                  {founder.role}
                </p>
                
                <!-- Divider -->
                <div class="w-full h-px bg-slate-100 my-1.5"></div>

                <p class="text-[11px] text-slate-600 leading-relaxed font-normal">
                  {founder.bio}
                </p>
                
                <!-- LinkedIn Icon -->
                <div class="pt-1">
                  <a
                    href="#founders"
                    class="inline-flex items-center justify-center w-5 h-5 rounded-sm bg-[#0077b5] text-white hover:opacity-90 transition-opacity"
                    aria-label={`${founder.name} LinkedIn Profile`}
                  >
                    <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                </div>
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
