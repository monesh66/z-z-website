---
import { siteConfig } from '../data/site';
---

<section id="founders" class="py-12 lg:py-14 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Headline & Vision (col-span-5) -->
      <div class="lg:col-span-5 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Our Founders</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-editorial-serif text-[#0B1F36] leading-[1.15] tracking-tight">
          Built on Trust.<br class="hidden sm:inline" />
          Driven by Opportunity.
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal max-w-sm">
          Our founders bring a shared vision to connect global markets through integrity, quality and long-term partnerships.
        </p>
      </div>

      <!-- Right Column: 2 Founder Cards (col-span-7) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {siteConfig.founders.map((founder) => (
          <div class="flex items-center gap-4 p-2">
            
            <!-- Silhouette Photo from Mockup -->
            <div class="w-20 h-20 sm:w-22 sm:h-22 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200/60 shadow-xs">
              <img
                src={founder.image}
                alt={founder.name}
                width="88"
                height="88"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <!-- Details -->
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-bold text-[#0B1F36] leading-tight">
                {founder.name}
              </h3>
              <div class="text-[11px] font-medium text-slate-500 mt-0.5">
                {founder.role}
              </div>
              
              <!-- Subtle Hairline Divider -->
              <div class="w-full h-px bg-slate-200 my-1.5"></div>

              <p class="text-[11px] text-slate-500 leading-snug line-clamp-2">
                {founder.bio}
              </p>
              
              <!-- LinkedIn Circle Icon -->
              <div class="mt-1.5">
                <a
                  href={founder.linkedin}
                  class="w-4 h-4 rounded-full bg-[#0A66C2] text-white inline-flex items-center justify-center hover:opacity-90 transition-opacity"
                  aria-label={`${founder.name} LinkedIn Profile`}
                >
                  <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>
