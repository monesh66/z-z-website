---
import { siteConfig } from '../data/site';
---

<section id="founders" class="py-14 lg:py-16 bg-white border-b border-slate-100">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Headline & Vision (approx 36%) -->
      <div class="lg:col-span-5 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#2E8B2E]">Our Founders</span>
          <span class="w-7 h-[2px] bg-[#2E8B2E]"></span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-[30px] font-bold font-editorial-serif text-[#0B1F3A] leading-[1.15] tracking-tight">
          Built on Trust. Driven by Opportunity.
        </h2>

        <p class="text-[13px] sm:text-[14px] text-[#5B6573] leading-relaxed font-normal max-w-sm">
          Our founders bring a shared vision to connect global markets through integrity, quality and long-term partnerships.
        </p>
      </div>

      <!-- Right Column: 2 Founder Cards (approx 64%) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
        {siteConfig.founders.map((founder) => (
          <div class="flex items-center gap-4">
            
            <!-- Rounded Rectangle Photo matching reference -->
            <div class="w-20 h-20 sm:w-22 sm:h-22 rounded-xl overflow-hidden bg-slate-200 flex-shrink-0 border border-slate-200/80 shadow-xs">
              <img
                src={founder.image}
                alt={founder.name}
                width="88"
                height="88"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <!-- Details -->
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-bold text-[#0B1F3A] leading-tight">
                {founder.name}
              </h3>
              <div class="text-[11px] font-medium text-[#5B6573] mt-0.5">
                {founder.role}
              </div>
              
              <!-- Subtle Hairline Divider matching reference -->
              <div class="w-full h-px bg-slate-200 my-1.5"></div>

              <p class="text-[11px] text-[#5B6573] leading-snug line-clamp-2">
                {founder.bio}
              </p>
              
              <!-- LinkedIn Icon -->
              <div class="mt-1.5">
                <a
                  href={founder.linkedin}
                  class="w-5 h-5 rounded-[3px] bg-[#0B1F3A] text-white inline-flex items-center justify-center hover:bg-[#2E8B2E] transition-colors"
                  aria-label={`${founder.name} LinkedIn Profile`}
                >
                  <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>
