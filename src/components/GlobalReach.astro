<!-- Client Script for Interactive Country Hotspot Tooltips (Zero-Lag, No Moving Ball) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('country-hover-tooltip');
    const tName = document.getElementById('tooltip-country-name');
    const tCode = document.getElementById('tooltip-country-code');
    const tRole = document.getElementById('tooltip-country-role');
    const tComm = document.getElementById('tooltip-country-commodities');
    const tPortsText = document.getElementById('tooltip-country-ports-text');

    const pinNodes = document.querySelectorAll('.country-pin-node');

    pinNodes.forEach((pin) => {
      const name = pin.getAttribute('data-name');
      const code = pin.getAttribute('data-id');
      const role = pin.getAttribute('data-role');
      const comm = pin.getAttribute('data-commodities');
      const ports = pin.getAttribute('data-ports');

      pin.addEventListener('mouseenter', (e) => {
        if (!tooltip) return;
        tName.textContent = name;
        tCode.textContent = code;
        tRole.textContent = role;
        tComm.textContent = 'Commodities: ' + comm;
        tPortsText.textContent = ports;

        tooltip.classList.remove('hidden');
        tooltip.style.opacity = '1';
      });

      pin.addEventListener('mousemove', (e) => {
        if (!tooltip) return;
        const x = e.clientX;
        const y = e.clientY;
        tooltip.style.left = `${x}px`;
        tooltip.style.top = `${y}px`;
      });

      pin.addEventListener('mouseleave', () => {
        if (!tooltip) return;
        tooltip.style.opacity = '0';
        tooltip.classList.add('hidden');
      });
    });
  });
</script>

<style>
  /* Subtle Stationary Halo on Country Nodes - No moving side-to-side animation */
  .country-pin-node {
    cursor: pointer;
  }

  .country-pin-node .pin-halo {
    transition: transform 0.25s ease, stroke 0.25s ease, opacity 0.25s ease;
  }

  .country-pin-node:hover .pin-halo {
    transform: scale(1.6);
    stroke: #34d399;
    opacity: 1;
  }

  .country-pin-node:hover .pin-core {
    fill: #ffffff;
    filter: drop-shadow(0 0 10px #34d399);
  }
</style>
