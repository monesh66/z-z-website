---
---

<section id="global-reach" class="py-12 lg:py-14 bg-[#EDF4F9] border-b border-slate-200/60 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
      
      <!-- Left Column: Headline & Description (col-span-4) -->
      <div class="lg:col-span-4 space-y-4">
        
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Global Reach</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-editorial-serif text-[#0B1F36] leading-tight tracking-tight">
          Importing & Exporting<br />
          <span class="text-[#138848]">Across Continents</span>
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          We work with a wide network of suppliers and buyers across the globe, enabling seamless import and export operations to key international markets.
        </p>

        <div class="pt-1">
          <a
            href="/global-reach"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Our Global Reach</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Center Column: Ultra-Sharp Dot-Matrix World Map from Mockup (col-span-5) -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative w-full max-w-xl group">
          <img
            src="/images/reach/map_hd_transparent.png"
            alt="World trade routes map"
            width="1376"
            height="768"
            class="w-full h-auto object-contain filter drop-shadow-xs transition-transform duration-700 ease-out group-hover:scale-102"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Column: 3 Strategic Pillars (col-span-3) -->
      <div class="lg:col-span-3 space-y-5">
        
        <!-- 1. Import Markets -->
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <!-- Commercial Airplane Icon -->
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36]">Import Markets</h3>
            <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
              Sourcing quality products from global markets.
            </p>
          </div>
        </div>

        <!-- 2. Export Markets -->
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <!-- Cargo Container Ship Icon -->
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2 17l2 3h16l2-3-4-1H6l-4 1zM6 16V9a1 1 0 011-1h10a1 1 0 011 1v7M9 8V5a1 1 0 011-1h4a1 1 0 011 1v3" />
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36]">Export Markets</h3>
            <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
              Supplying products to international destinations.
            </p>
          </div>
        </div>

        <!-- 3. Logistics Network -->
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 flex items-center justify-center text-[#0B1F36] flex-shrink-0 mt-0.5">
            <!-- Freight Truck Icon -->
            <svg class="w-5 h-5 text-[#0B1F36]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-[#0B1F36]">Logistics Network</h3>
            <p class="text-[11px] text-slate-500 mt-0.5 leading-normal">
              Integrated air, sea and road transport solutions.
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
