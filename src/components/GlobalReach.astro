---
// Global Reach Section matching reference mockup 100%
// Pale ice-blue background, dot-matrix world map with teardrop pins and trade route arcs, 3 clean logistics features
---

<section id="network" class="py-16 lg:py-24 bg-[#EAF3FA] text-navy-950 border-b border-slate-200/80 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Action -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal flex items-center gap-2.5">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-navy-950 font-mono">
            GLOBAL REACH
          </span>
          <span class="w-8 h-0.5 bg-emerald-500"></span>
        </div>

        <!-- Headline -->
        <h2 class="scroll-reveal text-3xl sm:text-4xl lg:text-[42px] font-bold font-serif text-navy-950 tracking-tight leading-[1.15]">
          Importing & Exporting<br />
          <span class="text-emerald-600 font-serif font-bold">Across Continents</span>
        </h2>

        <!-- Description -->
        <p class="scroll-reveal text-xs sm:text-sm text-slate-600 leading-relaxed font-normal max-w-sm">
          We work with a wide network of suppliers and buyers across the globe, enabling seamless import and export operations to key international markets.
        </p>

        <!-- CTA Button -->
        <div class="scroll-reveal pt-2">
          <a
            href="/global-reach"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-md hover:shadow-lg group"
            id="our-global-reach-btn"
          >
            <span>Our Global Reach</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Center: Dot-Matrix Light Blue World Map with Pins & Trade Arcs Matching Mockup -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="scroll-reveal relative w-full aspect-[16/10] max-w-xl mx-auto flex items-center justify-center">
          <img
            src="/images/network/world_network_map.svg"
            alt="Ziya Zara Global Trade Network Map"
            width="800"
            height="440"
            class="w-full h-auto object-contain select-none filter drop-shadow-xs"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Column: 3 Clean Feature Rows Matching Mockup -->
      <div class="lg:col-span-3 space-y-7" data-reveal-group data-reveal-stagger="80">
        
        <!-- 1. Import Markets (Airplane) -->
        <div class="flex items-start gap-4 group">
          <div class="w-8 h-8 text-navy-950 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:text-emerald-600 transition-all">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-navy-950">Import Markets</h3>
            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Sourcing quality products from global markets.
            </p>
          </div>
        </div>

        <!-- 2. Export Markets (Cargo Ship) -->
        <div class="flex items-start gap-4 group">
          <div class="w-8 h-8 text-navy-950 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:text-emerald-600 transition-all">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l2-8h14l2 8H3zm4-8V5h3v4m4-4h3v4M2 20h20" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-navy-950">Export Markets</h3>
            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Supplying products to international destinations.
            </p>
          </div>
        </div>

        <!-- 3. Logistics Network (Delivery Truck) -->
        <div class="flex items-start gap-4 group">
          <div class="w-8 h-8 text-navy-950 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:text-emerald-600 transition-all">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-navy-950">Logistics Network</h3>
            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Integrated air, sea and road transport solutions.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
