    <circle r="20" fill="transparent" class="cursor-pointer" />
    <!-- Stationary Halo Ring (NO moving side-to-side animation) -->
    <circle r="9" fill="none" stroke="#10b981" stroke-width="1.2" opacity="0.6" class="pin-halo" />
    <!-- Core Beacon Dot -->
    <circle r="5" fill="#34d399" class="pin-core" filter="drop-shadow(0 0 6px #34d399)" />
