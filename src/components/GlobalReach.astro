---
---

<section id="global-reach" class="py-16 lg:py-20 bg-[#F2F6FA] border-b border-slate-200/60 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Headline & Description (col-span-4) -->
      <div class="lg:col-span-4 space-y-4">
        
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Global Reach</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-editorial-serif text-[#0B1F36] leading-tight tracking-tight">
          Importing & Exporting<br />
          <span class="text-[#138848]">Across Continents</span>
        </h2>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          We work with a wide network of suppliers and buyers across the globe, enabling seamless import and export operations to key international markets.
        </p>

        <div class="pt-2">
          <a
            href="/global-reach"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Our Global Reach</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Center Column: World Map Illustration (col-span-5) -->
      <div class="lg:col-span-5 flex items-center justify-center">
        <div class="relative w-full aspect-[16/10] max-w-lg">
          <svg viewBox="0 0 800 450" class="w-full h-full select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="mapGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#138848" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#0B1F36" stop-opacity="0.8" />
              </linearGradient>
            </defs>

            <!-- Light Cyan/Blue Silhouette Map of Continents -->
            <g fill="#CBDDEB" opacity="0.85">
              <!-- North America -->
              <path d="M90 70 Q 150 50, 220 80 Q 200 150, 160 190 Q 120 170, 80 120 Z" />
              <path d="M140 190 Q 180 210, 190 250 Q 160 270, 130 230 Z" />
              <!-- South America -->
              <path d="M210 250 Q 280 270, 260 360 Q 220 410, 190 370 Q 180 300, 210 250 Z" />
              <!-- Europe -->
              <path d="M380 80 Q 460 60, 470 130 Q 430 160, 380 140 Q 360 110, 380 80 Z" />
              <!-- Africa -->
              <path d="M390 160 Q 490 150, 480 250 Q 440 350, 400 320 Q 350 250, 370 180 Z" />
              <!-- Asia -->
              <path d="M470 70 Q 640 50, 720 120 Q 690 220, 580 210 Q 500 180, 470 70 Z" />
              <!-- India Subcontinent (Accented) -->
              <path d="M530 160 Q 600 170, 570 250 Q 530 260, 510 200 Z" fill="#A8C8E2" />
              <!-- Australia / Oceania -->
              <path d="M640 310 Q 740 300, 730 380 Q 670 400, 630 360 Z" />
            </g>

            <!-- Curved Dashed Trade Routes connecting Hubs -->
            <path d="M 545 210 Q 460 160, 400 120" stroke="#138848" stroke-width="2" stroke-dasharray="4,4" />
            <path d="M 550 210 Q 630 170, 690 130" stroke="#138848" stroke-width="2" stroke-dasharray="4,4" />
            <path d="M 540 215 Q 470 260, 420 300" stroke="#138848" stroke-width="2" stroke-dasharray="4,4" />
            <path d="M 395 120 Q 280 100, 180 130" stroke="#138848" stroke-width="1.8" stroke-dasharray="4,4" />
            <path d="M 550 215 Q 610 270, 670 330" stroke="#138848" stroke-width="1.8" stroke-dasharray="4,4" />

            <!-- Trade Location Pins -->
            <!-- South Asia Hub (Large Pin) -->
            <g transform="translate(545, 210)">
              <circle r="7" fill="#138848" />
              <circle r="3" fill="#FFFFFF" />
            </g>

            <!-- Middle East Pin -->
            <g transform="translate(470, 170)">
              <circle r="5" fill="#0B1F36" />
              <circle r="2" fill="#FFFFFF" />
            </g>

            <!-- Europe Pin -->
            <g transform="translate(400, 120)">
              <circle r="5" fill="#0B1F36" />
              <circle r="2" fill="#FFFFFF" />
            </g>

            <!-- East Asia Pin -->
            <g transform="translate(680, 140)">
              <circle r="5" fill="#138848" />
              <circle r="2" fill="#FFFFFF" />
            </g>

            <!-- North America Pin -->
            <g transform="translate(180, 130)">
              <circle r="5" fill="#0B1F36" />
              <circle r="2" fill="#FFFFFF" />
            </g>

            <!-- South America Pin -->
            <g transform="translate(240, 310)">
              <circle r="4.5" fill="#0B1F36" />
              <circle r="2" fill="#FFFFFF" />
            </g>

            <!-- Africa Pin -->
            <g transform="translate(430, 260)">
              <circle r="4.5" fill="#138848" />
              <circle r="2" fill="#FFFFFF" />
            </g>
          </svg>
        </div>
      </div>

      <!-- Right Column: 3 Strategic Pillars (col-span-3) -->
      <div class="lg:col-span-3 space-y-6">
        
        <!-- 1. Import Markets -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-white shadow-xs border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-[#0B1F36]">Import Markets</h3>
            <p class="text-xs text-slate-500 mt-0.5 leading-normal">
              Sourcing quality products from global markets.
            </p>
          </div>
        </div>

        <!-- 2. Export Markets -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-white shadow-xs border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-[#0B1F36]">Export Markets</h3>
            <p class="text-xs text-slate-500 mt-0.5 leading-normal">
              Supplying products to international destinations.
            </p>
          </div>
        </div>

        <!-- 3. Logistics Network -->
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-white shadow-xs border border-slate-200 flex items-center justify-center text-slate-800 flex-shrink-0">
            <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-[#0B1F36]">Logistics Network</h3>
            <p class="text-xs text-slate-500 mt-0.5 leading-normal">
              Integrated air, sea and road transport solutions.
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
