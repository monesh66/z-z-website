---
// Global Reach Section matching root website mockup design
// Night lights satellite map with global trade route web and unified frosted glass stat card
---

<section
  class="relative py-20 lg:py-28 bg-[#0B1F3A] overflow-hidden text-white border-b border-[#112847]"
  id="network"
>
  <!-- Background Image: Earth at Night with Golden Web Connections -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-95">
    <img
      src="/images/network/mockup-network-map.jpg"
      alt="Ziya Zara Global Trade Network Map"
      width="1376"
      height="768"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <!-- Subtle gradient vignettes on edges to blend seamlessly -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A]/85 via-transparent to-[#0B1F3A]/70"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0B1F3A]/40 via-transparent to-[#0B1F3A]/50"></div>
  </div>

  <!-- Interactive SVG Layer: Global Trade Hotspots & Country Details (NO moving ball) -->
  <div class="absolute inset-0 z-10 pointer-events-none">
    <svg
      viewBox="0 0 1376 768"
      preserveAspectRatio="xMidYMid slice"
      class="w-full h-full pointer-events-auto"
      id="night-map-svg"
      aria-label="Interactive global trade network hotspots"
    >
      <defs>
        <filter id="goldenGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Hotspots for Trade Partner Countries -->
      <g id="country-hotspots-group">
