---
---

<section id="global-reach" class="py-20 lg:py-28 bg-white border-b border-subtle relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Introduction Row -->
    <div class="max-w-3xl mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
        <span class="w-8 h-0.5 bg-emerald-600"></span>
        <span>Global Reach</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-navy-950 tracking-tight">
        Importing & Exporting <br />
        <span class="text-emerald-700 font-editorial-serif italic font-normal">Across Continents.</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed pt-1">
        We bridge international trade hubs, coordinating reliable import and export operations that link strategic producer zones with key global consuming markets.
      </p>
    </div>

    <!-- Main Grid: SVG Map Visualization on Left, Capability Pillars on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left/Center: Interactive SVG World Trade Map Visualization -->
      <div class="lg:col-span-8 bg-navy-950 rounded-2xl p-6 sm:p-8 border border-navy-800 shadow-2xl relative overflow-hidden">
        
        <!-- Header Info in Visualization -->
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4 text-xs">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-mono uppercase tracking-wider text-emerald-400 font-bold">Strategic Trade Corridors</span>
          </div>
          <div class="font-mono text-slate-400 text-[11px] hidden sm:block">
            Cross-Border Logistics Network
          </div>
        </div>

        <!-- SVG Map Composition -->
        <div class="relative w-full aspect-[16/9] sm:aspect-[2/1] flex items-center justify-center">
          <svg
            viewBox="0 0 1000 500"
            class="w-full h-full select-none"
            aria-label="Interactive world map showing global trade corridors and maritime routes"
          >
            <defs>
              <!-- Route Gradient -->
              <linearGradient id="routeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#D6B879" stop-opacity="0.9" />
              </linearGradient>

              <!-- Glow Filter -->
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>

            <!-- Abstract World Continents (Geometric/Dotted Silhouette) -->
            <g fill="#162E4A" opacity="0.6">
              <!-- North America -->
              <path d="M120 100 Q 180 80, 260 110 Q 240 180, 200 230 Q 150 210, 110 160 Z" />
              <path d="M180 230 Q 220 250, 230 300 Q 200 320, 170 280 Z" />
              
              <!-- South America -->
              <path d="M260 300 Q 340 320, 310 420 Q 270 480, 240 430 Q 230 350, 260 300 Z" />
              
              <!-- Europe & UK -->
              <path d="M470 110 Q 550 90, 560 160 Q 520 200, 470 170 Q 450 140, 470 110 Z" />
              <path d="M430 110 Q 460 100, 450 140 Q 420 130, 430 110 Z" />

              <!-- Africa -->
              <path d="M480 200 Q 590 190, 580 300 Q 540 410, 490 380 Q 440 300, 460 220 Z" />

              <!-- Asia -->
              <path d="M570 100 Q 750 80, 850 150 Q 820 250, 700 250 Q 600 220, 570 100 Z" />
              
              <!-- India & South Asia Hub -->
              <path d="M640 200 Q 720 210, 690 300 Q 640 310, 620 240 Z" fill="#1C3F66" opacity="0.9" />

              <!-- Southeast Asia & Oceania -->
              <path d="M750 270 Q 820 280, 810 330 Q 750 350, 740 300 Z" />
              <path d="M780 370 Q 890 360, 880 450 Q 810 470, 770 420 Z" />
            </g>

            <!-- Trade Route Arcs (Connecting Major Global Port Regions) -->
            <!-- Route 1: South Asia to Middle East / Europe -->
            <path
              d="M 660 260 Q 560 200, 490 150"
              fill="none"
              stroke="url(#routeGrad)"
              stroke-width="2.5"
              stroke-dasharray="6,6"
              class="animate-dash-flow"
            />
            
            <!-- Route 2: South Asia to East Asia / Pacific -->
            <path
              d="M 670 260 Q 740 220, 820 180"
              fill="none"
              stroke="url(#routeGrad)"
              stroke-width="2.5"
              stroke-dasharray="6,6"
              class="animate-dash-flow"
            />

            <!-- Route 3: South Asia to East Africa / Southern Corridors -->
            <path
              d="M 660 265 Q 580 310, 530 350"
              fill="none"
              stroke="url(#routeGrad)"
              stroke-width="2"
              stroke-dasharray="6,6"
              class="animate-dash-flow"
            />

            <!-- Route 4: Europe to Americas Transatlantic -->
            <path
              d="M 480 140 Q 340 120, 230 150"
              fill="none"
              stroke="#10B981"
              stroke-opacity="0.6"
              stroke-width="2"
              stroke-dasharray="6,6"
              class="animate-dash-flow"
            />

            <!-- Key Trade Hub Nodes -->
            <!-- South Asia Hub (Primary) -->
            <g transform="translate(660, 260)" class="cursor-pointer">
              <circle r="16" fill="#10B981" opacity="0.2" class="animate-pulse-node" />
              <circle r="7" fill="#10B981" filter="url(#glow)" />
              <circle r="3" fill="#FFFFFF" />
              <text x="12" y="4" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">South Asia Hub</text>
            </g>

            <!-- Middle East Hub -->
            <g transform="translate(560, 210)" class="cursor-pointer">
              <circle r="5" fill="#D6B879" filter="url(#glow)" />
              <circle r="2" fill="#FFFFFF" />
              <text x="9" y="3" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#E5C583">Middle East Gateway</text>
            </g>

            <!-- European Hub -->
            <g transform="translate(485, 145)" class="cursor-pointer">
              <circle r="5" fill="#10B981" filter="url(#glow)" />
              <circle r="2" fill="#FFFFFF" />
              <text x="-95" y="3" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#FFFFFF">European Corridors</text>
            </g>

            <!-- East Asia Hub -->
            <g transform="translate(820, 180)" class="cursor-pointer">
              <circle r="5" fill="#10B981" filter="url(#glow)" />
              <circle r="2" fill="#FFFFFF" />
              <text x="10" y="3" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#FFFFFF">East Asia Ports</text>
            </g>

            <!-- Americas Port Gateway -->
            <g transform="translate(230, 160)" class="cursor-pointer">
              <circle r="5" fill="#D6B879" filter="url(#glow)" />
              <circle r="2" fill="#FFFFFF" />
              <text x="10" y="3" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#FFFFFF">Americas Trade</text>
            </g>
          </svg>
        </div>

        <!-- Explanatory Footer inside map card -->
        <div class="mt-4 pt-3 border-t border-white/10 flex flex-wrap items-center justify-between text-[11px] text-slate-400 font-mono">
          <div>* Illustrative trade corridors and multimodal freight connections.</div>
          <div class="text-emerald-400 font-semibold">Continuous Port Coordination</div>
        </div>

      </div>

      <!-- Right Column: Capability Pillars -->
      <div class="lg:col-span-4 space-y-5">
        
        <!-- Pillar 1: Import Markets -->
        <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-6 hover:border-emerald-600 transition-colors shadow-sm group">
          <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-emerald-700 flex items-center justify-center mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-colors shadow-xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <h3 class="text-lg font-bold font-display text-navy-950">Import Markets</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Sourcing high-demand raw materials, agricultural commodities, and industrial components from accredited international producers.
          </p>
        </div>

        <!-- Pillar 2: Export Markets -->
        <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-6 hover:border-emerald-600 transition-colors shadow-sm group">
          <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-emerald-700 flex items-center justify-center mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-colors shadow-xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
          </div>
          <h3 class="text-lg font-bold font-display text-navy-950">Export Markets</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Supplying graded products, grains, textiles, and specialty items to international commercial destinations with strict customs compliance.
          </p>
        </div>

        <!-- Pillar 3: Logistics Network -->
        <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-6 hover:border-emerald-600 transition-colors shadow-sm group">
          <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-emerald-700 flex items-center justify-center mb-4 group-hover:bg-emerald-600 group-hover:text-white transition-colors shadow-xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold font-display text-navy-950">Logistics Network</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Integrated maritime freight, air express routing, and inland haulage synchronized for predictable port turnaround.
          </p>
        </div>

        <!-- Action Link -->
        <div class="pt-2">
          <a
            href="/global-reach"
            class="trade-btn-primary w-full justify-center group"
          >
            <span>Explore Trade Capabilities</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
