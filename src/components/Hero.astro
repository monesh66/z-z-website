---
// Hero Section matching reference mockup 100%
// Full-bleed vibrant sunset logistics background with airplane, cargo ship, truck, gantry cranes
// No cluttering badges or wave cuts at the bottom - pure visual match to mockup
import { siteConfig } from '../data/site';
---

<section class="relative bg-white text-navy-950 overflow-hidden min-h-[580px] lg:min-h-[660px] flex items-center" id="hero">
  
  <!-- High-Resolution Full-Bleed Logistics Background Scene with Per-Image Progressive Loader -->
  <div class="absolute inset-0 z-0 bg-slate-100 progressive-image-container" data-progressive-image>
    <img
      src="/images/hero/hero_full_hd.jpg"
      alt="Ziya Zara Global Logistics - Air Freight, Ocean Cargo Ship, Container Truck, and Port Terminal at Sunset"
      width="1376"
      height="768"
      class="w-full h-full object-cover object-[70%_center] sm:object-center opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <!-- Individual Small Looping Logo Video Loader Overlay (loops until hero image is downloaded & decoded) -->
    <div class="progressive-loader-overlay absolute inset-0 z-5 flex items-center justify-center sm:justify-end sm:pr-24 lg:pr-36 bg-slate-100/50 backdrop-blur-[2px] transition-all duration-500 ease-out pointer-events-none select-none">
      <div class="flex flex-col items-center bg-white/95 backdrop-blur-md rounded-2xl p-3 sm:p-4 shadow-xl border border-white/90 max-w-[170px] sm:max-w-[190px] text-center will-change-transform">
        <div class="w-28 sm:w-32 aspect-[16/9] overflow-hidden rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center">
          <video autoplay muted loop playsinline preload="auto" class="w-full h-full object-contain">
            <source src="/videos/zz_loading_loop.webm" type="video/webm" />
            <source src="/videos/zz_loading_loop.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="flex items-center gap-1.5 mt-2">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#16a34a]"></span>
          </span>
          <span class="text-[9px] font-mono font-semibold tracking-wider text-navy-950 uppercase">Loading Image...</span>
        </div>
      </div>
    </div>

    <!-- Subtle Left Gradient: Preserves Vibrant Sunset, Waterfront Skyline and Ship while keeping text readable -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-3/4 md:w-3/5 lg:w-1/2 bg-gradient-to-r from-white/95 via-white/70 to-transparent pointer-events-none z-10"></div>
  </div>

  <!-- Elegant "Global Reach" Script in the sky on the right -->
  <div class="absolute top-10 right-6 sm:top-14 sm:right-12 lg:right-24 xl:right-32 pointer-events-none select-none z-20 hidden sm:block">
    <div class="transform -rotate-6 text-right drop-shadow-md">
      <span class="block text-[#0B1F3A] text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight" style="font-family: 'Caveat', cursive, serif;">
        Global
      </span>
      <span class="block text-[#16a34a] text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight -mt-1 flex items-center justify-end gap-1.5" style="font-family: 'Caveat', cursive, serif;">
        Reach
        <svg class="w-8 h-2.5 text-[#16a34a] inline-block -mb-0.5" viewBox="0 0 60 12" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round">
          <path d="M2 9 C 20 2, 42 2, 58 8" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Hero Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-16 sm:py-20 lg:py-24 w-full">
    
    <div class="max-w-xl lg:max-w-xl space-y-5 sm:space-y-6">
      
      <!-- Eyebrow -->
      <div class="scroll-reveal text-[11px] sm:text-xs font-bold tracking-[0.2em] text-slate-700 uppercase font-mono">
        IMPORT | EXPORT | GLOBAL SOURCING
      </div>

      <!-- Main Headline in Serif matching mockup -->
      <h1 class="scroll-reveal stagger-1 text-4xl sm:text-5xl lg:text-[56px] font-bold font-serif text-navy-950 tracking-tight leading-[1.08]">
        Bridging<br />
        <span class="text-[#16a34a] italic font-normal">Markets</span><br />
        Worldwide
      </h1>

      <!-- Description Paragraph -->
      <p class="scroll-reveal stagger-2 text-xs sm:text-sm md:text-base text-slate-700 leading-relaxed font-normal max-w-md pt-1">
        ZIYA ZARA TRADING COMPANY connects global markets by sourcing and supplying quality products with reliability, integrity and long-term partnerships.
      </p>

      <!-- CTA Buttons Matching Mockup Exactly -->
      <div class="scroll-reveal stagger-3 flex flex-wrap items-center gap-3 sm:gap-4 pt-3">
        <a
          href="/#products"
          class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 rounded-full bg-[#16a34a] hover:bg-[#15803d] text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-md hover:shadow-lg group"
          id="hero-explore-products-btn"
        >
          <span>Explore Our Products</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/#contact"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3 rounded-full bg-white hover:bg-slate-50 border border-slate-300 text-navy-950 font-semibold text-xs sm:text-sm transition-all duration-300 shadow-xs"
          id="hero-get-quote-btn"
        >
          <span>Get a Quote</span>
        </a>
      </div>

      <!-- 4 Value Highlights Matching Mockup Exactly -->
      <div class="scroll-reveal stagger-4 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-4 sm:pt-5 border-t border-slate-300/40 max-w-xl bg-gradient-to-r from-white/70 via-white/50 to-white/20 backdrop-blur-[2px] rounded-xl px-3 py-2.5 -mx-3">
        <!-- 1. Reliable Sourcing -->
        <div class="flex items-center gap-2.5">
          <div class="text-[#0B1F3A] flex-shrink-0">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="text-[11px] sm:text-xs font-bold text-navy-950 font-display leading-tight">
            Reliable<br />Sourcing
          </div>
        </div>

        <!-- 2. Global Network -->
        <div class="flex items-center gap-2.5">
          <div class="text-[#0B1F3A] flex-shrink-0">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
            </svg>
          </div>
          <div class="text-[11px] sm:text-xs font-bold text-navy-950 font-display leading-tight">
            Global<br />Network
          </div>
        </div>

        <!-- 3. Long-term Partnerships -->
        <div class="flex items-center gap-2.5">
          <div class="text-[#0B1F3A] flex-shrink-0">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="text-[11px] sm:text-xs font-bold text-navy-950 font-display leading-tight">
            Long-term<br />Partnerships
          </div>
        </div>

        <!-- 4. Sustainable Growth -->
        <div class="flex items-center gap-2.5">
          <div class="text-[#0B1F3A] flex-shrink-0">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 20A7 7 0 019.8 6.1C15.5 5 17 4.5 19 2c0 4-1.5 8.5-4 11-1.5 1.5-2.5 2.5-4 3m0 4v-4" />
            </svg>
          </div>
          <div class="text-[11px] sm:text-xs font-bold text-navy-950 font-display leading-tight">
            Sustainable<br />Growth
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- Gentle Organic Bottom Wave Transition to About Section -->
  <div class="absolute bottom-0 left-0 right-0 z-10 pointer-events-none overflow-hidden leading-none">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="w-full h-8 sm:h-11 lg:h-13 fill-white block">
      <path d="M0,25 C320,10 640,48 960,52 C1180,54 1340,46 1440,35 L1440,60 L0,60 Z" />
    </svg>
  </div>

</section>
