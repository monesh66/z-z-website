---
import { siteConfig } from '../data/site';
---

<section class="relative bg-white border-b border-slate-100 overflow-hidden min-h-[520px] lg:min-h-[580px] flex flex-col justify-between">
  
  <!-- Full-Width Panoramic Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero_hd.jpg"
      alt="International multimodal freight logistics showing container vessel, aircraft, and freight truck"
      width="1440"
      height="800"
      class="w-full h-full object-cover object-[75%_center] sm:object-[68%_center] lg:object-[65%_center]"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Left Atmospheric White Wash to ensure 100% text legibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 sm:via-white/80 md:via-white/60 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 left-0 w-full sm:w-7/12 bg-white/40 sm:bg-transparent backdrop-blur-[1px] sm:backdrop-blur-none z-10 pointer-events-none"></div>
  </div>

  <!-- Content Container -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 lg:pt-16 pb-6">
    <div class="max-w-xl lg:max-w-xl text-left space-y-4 sm:space-y-5">
      
      <!-- Eyebrow -->
      <div class="text-[11px] font-semibold tracking-widest text-slate-600 uppercase">
        {siteConfig.heroEyebrow}
      </div>

      <!-- Display Headline matching reference typography -->
      <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-bold font-editorial-serif tracking-tight text-[#08182B] leading-[1.06]">
        Bridging<br />
        <span class="text-[#138848]">Markets</span><br />
        Worldwide
      </h1>

      <!-- Subheadline -->
      <p class="text-xs sm:text-[13px] text-slate-700 leading-relaxed max-w-md font-normal">
        {siteConfig.heroSubheadline}
      </p>

      <!-- Two Buttons side by side -->
      <div class="pt-1 flex flex-wrap items-center gap-3">
        <a
          href="/#products"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm hover:shadow-md group"
        >
          <span>Explore Our Products</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/#contact"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-[#08182B] bg-white/95 border border-[#08182B] hover:bg-[#08182B] hover:text-white transition-all duration-200 shadow-2xs"
        >
          <span>Get a Quote</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Realistic Cinematic Cargo Aircraft Flight Animation Layer -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-15 hidden sm:block" aria-hidden="true">
    <div class="cargo-aircraft-flight absolute top-[1.5%] left-[2%] w-[96px] lg:w-[110px] h-auto">
      <img
        src="/images/hero/cargo_aircraft.svg"
        alt=""
        width="110"
        height="32"
        class="w-full h-auto object-contain filter drop-shadow-[0_2px_4px_rgba(11,31,54,0.18)]"
        loading="eager"
      />
    </div>
  </div>

  <!-- Elegant Script Badge in the sky on the right matching reference style -->
  <div class="absolute top-10 right-6 sm:top-14 sm:right-12 lg:right-20 pointer-events-none select-none z-20">
    <div class="transform -rotate-6 text-right">
      <span class="block text-[#08182B] text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight drop-shadow-sm" style="font-family: 'Caveat', 'Dancing Script', cursive, serif;">
        Global
      </span>
      <span class="block text-[#138848] text-lg sm:text-xl lg:text-2xl font-bold tracking-tight -mt-1 drop-shadow-sm flex items-center justify-end gap-1.5" style="font-family: 'Caveat', 'Dancing Script', cursive, serif;">
        Reach
        <svg class="w-7 h-2 text-[#138848] inline-block -mb-0.5" viewBox="0 0 60 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M2 9 C 20 2, 42 2, 58 8" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Full-Width Trust Strip with 4 Items at bottom left -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pb-6 pt-4">
    <div class="max-w-xl grid grid-cols-4 divide-x divide-slate-300/60">
      
      <!-- 1. Reliable Sourcing -->
      <div class="flex flex-col items-center text-center space-y-1 px-1 sm:px-2">
        <svg class="w-5 h-5 text-[#08182B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-[10px] sm:text-[11px] font-semibold text-slate-800 leading-tight">Reliable<br />Sourcing</span>
      </div>

      <!-- 2. Global Network -->
      <div class="flex flex-col items-center text-center space-y-1 px-1 sm:px-2">
        <svg class="w-5 h-5 text-[#08182B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="text-[10px] sm:text-[11px] font-semibold text-slate-800 leading-tight">Global<br />Network</span>
      </div>

      <!-- 3. Long-term Partnerships -->
      <div class="flex flex-col items-center text-center space-y-1 px-1 sm:px-2">
        <svg class="w-5 h-5 text-[#08182B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span class="text-[10px] sm:text-[11px] font-semibold text-slate-800 leading-tight">Long-term<br />Partnerships</span>
      </div>

      <!-- 4. Sustainable Growth -->
      <div class="flex flex-col items-center text-center space-y-1 px-1 sm:px-2">
        <svg class="w-5 h-5 text-[#08182B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.5 2 8 5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v10l4-4" />
        </svg>
        <span class="text-[10px] sm:text-[11px] font-semibold text-slate-800 leading-tight">Sustainable<br />Growth</span>
      </div>

    </div>
  </div>

  <!-- Bottom Elegant Curve Wave divider into About section -->
  <div class="absolute bottom-0 inset-x-0 z-10 pointer-events-none overflow-hidden leading-none">
    <svg class="relative block w-full h-8 sm:h-12 text-white" viewBox="0 0 1440 48" fill="none" preserveAspectRatio="none">
      <path d="M0,48 C360,48 720,24 1080,48 C1260,60 1380,24 1440,0 L1440,48 L0,48 Z" fill="currentColor"></path>
    </svg>
  </div>

</section>

<style>
  /* Cinematic Realistic Cargo Aircraft Flight Animation */
  .cargo-aircraft-flight {
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform-origin: center center;
    /* Initial state: distant, slight bank */
    opacity: 0;
    transform: translate3d(-6vw, -1vh, 0) scale(0.38) rotate(1.5deg);
    /* Plays once per page load: 16s majestic cinematic approach */
    animation: cinematicCargoApproach 16s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.6s 1 normal forwards;
  }

  @keyframes cinematicCargoApproach {
    0% {
      opacity: 0;
      transform: translate3d(-4vw, 0vh, 0) scale(0.38) rotate(1.8deg);
    }
    /* Emerges gracefully from distant atmospheric horizon */
    8% {
      opacity: 0.75;
      transform: translate3d(6vw, 1.2vh, 0) scale(0.42) rotate(2.2deg);
    }
    /* Smooth cruising glide across mid-sky, well above text */
    35% {
      opacity: 0.90;
      transform: translate3d(30vw, 5.5vh, 0) scale(0.56) rotate(3.0deg);
    }
    /* Sinking smoothly along glide-slope toward horizon */
    65% {
      opacity: 0.85;
      transform: translate3d(58vw, 11.2vh, 0) scale(0.70) rotate(2.6deg);
    }
    /* Approaching distant sunset horizon above cranes */
    85% {
      opacity: 0.55;
      transform: translate3d(78vw, 15.8vh, 0) scale(0.78) rotate(2.0deg);
    }
    /* Fades gently into distant sunset haze */
    96% {
      opacity: 0.15;
      transform: translate3d(88vw, 18.2vh, 0) scale(0.82) rotate(1.8deg);
    }
    100% {
      opacity: 0;
      transform: translate3d(94vw, 19.5vh, 0) scale(0.84) rotate(1.5deg);
    }
  }

  /* Accessibility: Respect user motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .cargo-aircraft-flight {
      animation: none !important;
      display: none !important;
    }
  }
</style>

