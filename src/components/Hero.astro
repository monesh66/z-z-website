---
import { siteConfig } from '../data/site';
---

<section class="relative overflow-hidden bg-white text-navy-950 pt-10 sm:pt-14 lg:pt-20" id="hero">
  <!-- Background Media: Cargo Vessel & Global Logistics -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/mockup-hero-sunset.jpg"
      alt="Ziya Zara Global Cargo Container Vessel and Air Logistics"
      width="1920"
      height="1080"
      class="w-full h-full object-cover object-[85%_center] sm:object-center opacity-85"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Luminous Light Gradient Overlay ensuring high contrast for editorial typography -->
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/90 sm:via-white/80 md:via-white/65 to-white/20"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-2xl space-y-6 pt-4 sm:pt-6">
      
      <!-- Top Eyebrow Badge -->
      <div class="inline-flex flex-wrap items-center gap-2 sm:gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-emerald-800 backdrop-blur-md">
        <span>GLOBAL SOURCING</span>
        <span class="text-emerald-300 font-normal">|</span>
        <span>INTERNATIONAL TRADE</span>
        <span class="text-emerald-300 font-normal">|</span>
        <span>RELIABLE PARTNERSHIP</span>
      </div>

      <!-- Main Headline in Luxury Editorial Serif -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-editorial-serif tracking-tight text-navy-950 leading-[1.12]">
        Connecting Markets.<br />
        <span class="text-emerald-700 italic font-normal">Delivering Possibilities.</span>
      </h1>

      <!-- Description -->
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal max-w-xl">
        <strong class="font-semibold text-navy-950">ZIYA ZARA TRADING COMPANY</strong> bridges global markets by sourcing and supplying quality products across borders with reliability, integrity and a commitment to long-term partnerships.
      </p>

      <!-- CTA Actions -->
      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 max-w-md sm:max-w-none">
        <a
          href="/products"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm sm:text-base shadow-lg shadow-emerald-950/20 transition-all duration-300 hover:-translate-y-0.5 group"
          id="hero-explore-products-btn"
        >
          <span>Explore Our Products</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/network"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-white hover:bg-slate-50 border border-navy-950 text-navy-950 font-semibold text-sm sm:text-base transition-all duration-300 hover:-translate-y-0.5 shadow-sm"
          id="hero-global-reach-btn"
        >
          <span>Our Global Reach</span>
          <svg class="w-4 h-4 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>
      </div>

    </div>

    <!-- 4 Bottom Features Strip directly on light background -->
    <div class="mt-16 sm:mt-20 pt-8 pb-4 border-t border-slate-200/90 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- 1. Global Network -->
      <div class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-navy-950 leading-snug">Global Network</h4>
          <p class="text-xs text-slate-600 mt-0.5">Trusted partners worldwide</p>
        </div>
      </div>

      <!-- 2. Quality Assurance -->
      <div class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-navy-950 leading-snug">Quality Assurance</h4>
          <p class="text-xs text-slate-600 mt-0.5">Consistent quality and compliance</p>
        </div>
      </div>

      <!-- 3. Reliable Supply -->
      <div class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-navy-950 leading-snug">Reliable Supply</h4>
          <p class="text-xs text-slate-600 mt-0.5">On-time delivery and transparency</p>
        </div>
      </div>

      <!-- 4. Sustainable Growth -->
      <div class="flex items-center gap-3.5 group">
        <div class="w-11 h-11 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-navy-950 leading-snug">Sustainable Growth</h4>
          <p class="text-xs text-slate-600 mt-0.5">Creating value for a better tomorrow</p>
        </div>
      </div>

    </div>

  </div>

  <!-- Signature Wave Curve Divider Transition into next section -->
  <div class="w-full leading-none -mb-px relative z-20">
    <svg viewBox="0 0 1440 95" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-12 sm:h-16 lg:h-20 block">
      <!-- Green Accent Stroke along the crest -->
      <path d="M0,75 C360,10 880,95 1440,25" stroke="#2E8B2E" stroke-width="4.5" stroke-linecap="round" fill="none" opacity="0.95" />
      <!-- Solid ground filling into next section -->
      <path d="M0,80 C360,15 880,100 1440,30 L1440,95 L0,95 Z" fill="#ffffff" />
    </svg>
  </div>
</section>
