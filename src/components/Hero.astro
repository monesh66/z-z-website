---
import { siteConfig } from '../data/site';
---

<section class="relative bg-white text-navy-950 pt-8 sm:pt-12 lg:pt-16 pb-12 overflow-hidden" id="hero">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Hero Main 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-5 space-y-6 sm:space-y-7">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal text-xs sm:text-sm font-bold tracking-widest text-navy-950 uppercase font-mono">
          IMPORT | EXPORT | GLOBAL SOURCING
        </div>

        <!-- Main Headline in Display Serif -->
        <h1 class="scroll-reveal stagger-1 text-4xl sm:text-5xl lg:text-6xl font-bold font-display text-navy-950 tracking-tight leading-[1.08]">
          Bridging<br />
          <span class="text-emerald-600 font-editorial-serif italic font-normal">Markets</span><br />
          Worldwide
        </h1>

        <!-- Subtitle Paragraph -->
        <p class="scroll-reveal stagger-2 text-base text-slate-600 leading-relaxed font-normal max-w-lg">
          ZIYA ZARA TRADING COMPANY connects global markets by sourcing and supplying quality products with reliability, integrity and long-term partnerships.
        </p>

        <!-- CTA Buttons -->
        <div class="scroll-reveal stagger-3 flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
          <a
            href="/#products"
            class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all duration-300 hover:shadow-lg shadow-emerald-900/10 group"
          >
            <span>Explore Our Products</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="/#contact"
            class="inline-flex items-center justify-center px-6 sm:px-7 py-3 rounded-full bg-white hover:bg-slate-50 border border-navy-950 text-navy-950 font-semibold text-sm transition-all duration-300"
          >
            <span>Get a Quote</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Cinematic Logistics Composite Visual -->
      <div class="lg:col-span-7 relative">
        <div class="scroll-reveal-right stagger-1 relative rounded-2xl overflow-hidden shadow-xl border border-slate-100 group">
          <img
            src="/images/reference_crops/hero_logistics_ref.png"
            alt="ZIYA ZARA Multi-Modal Logistics - Air, Sea, and Road Shipping"
            width="1000"
            height="620"
            class="w-full h-auto object-cover object-center transform transition-transform duration-700 group-hover:scale-102"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

    </div>

    <!-- 4 Bottom Highlights Bar in Floating Clean Card -->
    <div
      data-reveal-group
      data-reveal-stagger="90"
      class="mt-12 sm:mt-16 bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-7 shadow-sm grid grid-cols-2 md:grid-cols-4 gap-6 text-center"
    >
      <!-- 1. Reliable Sourcing -->
      <div class="flex flex-col items-center justify-center space-y-2 group">
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="text-xs sm:text-sm font-bold text-navy-950 font-display">Reliable Sourcing</span>
      </div>

      <!-- 2. Global Network -->
      <div class="flex flex-col items-center justify-center space-y-2 group">
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <span class="text-xs sm:text-sm font-bold text-navy-950 font-display">Global Network</span>
      </div>

      <!-- 3. Long-term Partnerships -->
      <div class="flex flex-col items-center justify-center space-y-2 group">
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <span class="text-xs sm:text-sm font-bold text-navy-950 font-display">Long-term Partnerships</span>
      </div>

      <!-- 4. Sustainable Growth -->
      <div class="flex flex-col items-center justify-center space-y-2 group">
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="text-xs sm:text-sm font-bold text-navy-950 font-display">Sustainable Growth</span>
      </div>

    </div>

  </div>
</section>
