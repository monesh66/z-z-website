---
import { siteConfig } from '../data/site';
---

<section class="relative bg-white pt-8 pb-14 lg:pt-12 lg:pb-16 border-b border-slate-100 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Editorial Headline & Copy -->
      <div class="lg:col-span-6 space-y-6 text-left">
        
        <!-- Eyebrow Tag -->
        <div class="text-[11px] sm:text-xs font-semibold tracking-wider text-slate-700 uppercase">
          {siteConfig.heroEyebrow}
        </div>

        <!-- Display Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold font-editorial-serif tracking-tight text-[#0B1F36] leading-[1.12]">
          Bridging<br />
          <span class="text-[#138848]">Markets</span><br />
          Worldwide
        </h1>

        <!-- Subheadline Paragraph -->
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-lg font-normal">
          {siteConfig.heroSubheadline}
        </p>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/#products"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Explore Our Products</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="/#contact"
            class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold text-[#0B1F36] bg-white border border-[#0B1F36] hover:bg-[#0B1F36] hover:text-white transition-all duration-200"
          >
            <span>Get a Quote</span>
          </a>
        </div>

        <!-- 4 Value Badges Strip directly under buttons -->
        <div class="pt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-slate-100">
          
          <!-- Badge 1: Reliable Sourcing -->
          <div class="flex flex-col items-center text-center space-y-1.5 p-2 rounded-lg hover:bg-slate-50 transition-colors">
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-700">
              <svg class="w-4 h-4 text-[#138848]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-slate-800">Reliable<br />Sourcing</span>
          </div>

          <!-- Badge 2: Global Network -->
          <div class="flex flex-col items-center text-center space-y-1.5 p-2 rounded-lg hover:bg-slate-50 transition-colors">
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-700">
              <svg class="w-4 h-4 text-[#138848]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <span class="text-xs font-semibold text-slate-800">Global<br />Network</span>
          </div>

          <!-- Badge 3: Long-term Partnerships -->
          <div class="flex flex-col items-center text-center space-y-1.5 p-2 rounded-lg hover:bg-slate-50 transition-colors">
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-700">
              <svg class="w-4 h-4 text-[#138848]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-slate-800">Long-term<br />Partnerships</span>
          </div>

          <!-- Badge 4: Sustainable Growth -->
          <div class="flex flex-col items-center text-center space-y-1.5 p-2 rounded-lg hover:bg-slate-50 transition-colors">
            <div class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-700">
              <svg class="w-4 h-4 text-[#138848]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 0 1-9-9c0-4.97 4.03-9 9-9 3.5 0 6.5 2 8 5" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v10l4-4" />
              </svg>
            </div>
            <span class="text-xs font-semibold text-slate-800">Sustainable<br />Growth</span>
          </div>

        </div>

      </div>

      <!-- Right Column: Cinematic Composite Image & Script Overlay -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-100 bg-slate-900 group">
          <img
            src="/images/hero/hero_composite.jpg"
            alt="International multimodal freight logistics showing container vessel, aircraft, and freight truck"
            width="800"
            height="600"
            class="w-full h-[360px] sm:h-[430px] lg:h-[460px] object-cover transition-transform duration-700 ease-out group-hover:scale-102"
            loading="eager"
            fetchpriority="high"
          />

          <!-- Floating "From Anywhere to Everywhere" Cursive Tag with Arrow -->
          <div class="absolute top-4 right-4 pointer-events-none select-none drop-shadow-md">
            <img
              src="/images/hero/anywhere_everywhere.svg"
              alt="From Anywhere to Everywhere"
              width="210"
              height="85"
              class="w-36 sm:w-48 h-auto"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
