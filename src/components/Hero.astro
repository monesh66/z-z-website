---
import { siteConfig } from '../data/site';
---

<section class="relative bg-white text-navy-950 overflow-hidden min-h-[640px] lg:min-h-[720px] flex flex-col justify-between" id="hero">
  
  <!-- High-Resolution Full-Bleed Logistics Background Scene -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero/hero_full_hd.jpg"
      alt="Ziya Zara Global Logistics - Air Freight, Ocean Cargo Ship, Container Truck, and Port Terminal"
      width="1376"
      height="768"
      class="w-full h-full object-cover object-[75%_center] sm:object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Smooth Linear Gradient Overlay: Pure Crisp White on Left, Seamless Fade to Right -->
    <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 sm:via-white/80 md:via-white/60 to-transparent"></div>
  </div>

  <!-- "From Anywhere to Everywhere" Floating Handwritten Script Accent -->
  <div class="hidden md:block absolute right-8 lg:right-16 xl:right-28 top-36 lg:top-44 z-10 text-right pointer-events-none select-none">
    <div class="font-script text-3xl lg:text-4xl text-[#0B1F3A] font-bold tracking-wide -rotate-6 drop-shadow-sm leading-tight">
      From<br />
      Anywhere<br />
      to Everywhere
    </div>
    <!-- Green Accent Underline Swoosh -->
    <svg class="w-20 lg:w-28 h-4 ml-auto -rotate-6 text-emerald-600" viewBox="0 0 100 15" fill="none">
      <path d="M2 10 C 30 2, 70 2, 98 12" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" />
    </svg>
  </div>

  <!-- Hero Content Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 pt-10 sm:pt-14 lg:pt-16 w-full">
    
    <div class="max-w-xl lg:max-w-2xl space-y-5 sm:space-y-6">
      
      <!-- Eyebrow -->
      <div class="scroll-reveal text-[11px] sm:text-xs font-bold tracking-[0.2em] text-slate-700 uppercase font-mono">
        IMPORT | EXPORT | GLOBAL SOURCING
      </div>

      <!-- Main Headline in Luxury Editorial Serif -->
      <h1 class="scroll-reveal stagger-1 text-4xl sm:text-5xl lg:text-6xl font-bold font-editorial-serif text-navy-950 tracking-tight leading-[1.08]">
        Bridging<br />
        <span class="text-emerald-600 italic font-normal">Markets</span><br />
        Worldwide
      </h1>

      <!-- Description Paragraph -->
      <p class="scroll-reveal stagger-2 text-sm sm:text-base text-slate-700 leading-relaxed font-normal max-w-lg">
        ZIYA ZARA TRADING COMPANY connects global markets by sourcing and supplying quality products with reliability, integrity and long-term partnerships.
      </p>

      <!-- CTA Buttons -->
      <div class="scroll-reveal stagger-3 flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
        <a
          href="/#products"
          class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm transition-all duration-300 shadow-md hover:shadow-lg shadow-emerald-900/10 group"
          id="hero-explore-products-btn"
        >
          <span>Explore Our Products</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a
          href="/#contact"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3 rounded-full bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold text-xs sm:text-sm transition-all duration-300 shadow-xs"
          id="hero-get-quote-btn"
        >
          <span>Get a Quote</span>
        </a>
      </div>

    </div>

  </div>

  <!-- Bottom 4 Highlights Directly on Light Canvas (No Box Container) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pt-10 pb-8 sm:pb-10">
    <div
      data-reveal-group
      data-reveal-stagger="80"
      class="max-w-xl sm:max-w-2xl grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8 items-start bg-white/70 backdrop-blur-xs sm:bg-transparent rounded-xl p-3 sm:p-0"
    >
      <!-- 1. Reliable Sourcing -->
      <div class="flex flex-col items-start space-y-1.5 group">
        <div class="w-7 h-7 flex items-center justify-center text-navy-950">
          <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-navy-950 font-display leading-tight">
          Reliable<br />Sourcing
        </div>
      </div>

      <!-- 2. Global Network -->
      <div class="flex flex-col items-start space-y-1.5 group">
        <div class="w-7 h-7 flex items-center justify-center text-navy-950">
          <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <div class="text-xs font-bold text-navy-950 font-display leading-tight">
          Global<br />Network
        </div>
      </div>

      <!-- 3. Long-term Partnerships -->
      <div class="flex flex-col items-start space-y-1.5 group">
        <div class="w-7 h-7 flex items-center justify-center text-navy-950">
          <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-navy-950 font-display leading-tight">
          Long-term<br />Partnerships
        </div>
      </div>

      <!-- 4. Sustainable Growth -->
      <div class="flex flex-col items-start space-y-1.5 group">
        <div class="w-7 h-7 flex items-center justify-center text-navy-950">
          <svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
        </div>
        <div class="text-xs font-bold text-navy-950 font-display leading-tight">
          Sustainable<br />Growth
        </div>
      </div>
    </div>
  </div>

  <!-- Organic Wave Transition into About Section at Bottom Right -->
  <div class="w-full leading-none -mb-px relative z-20 pointer-events-none overflow-hidden">
    <svg viewBox="0 0 1440 60" fill="none" class="w-full h-8 sm:h-12 md:h-14 block" preserveAspectRatio="none">
      <path d="M0 60 L1440 60 L1440 0 C1100 50, 750 60, 0 20 Z" fill="#FFFFFF" />
    </svg>
  </div>

</section>
