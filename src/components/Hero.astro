---
import { siteConfig } from '../data/site';
---

<section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-50/60 pt-8 pb-16 lg:pt-14 lg:pb-24 border-b border-subtle">
  <!-- Subtle Architectural Grid Background -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#0B1F36_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Editorial Headline & Actions -->
      <div class="lg:col-span-6 space-y-6 text-left">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-100 border border-slate-200/80 text-xs font-semibold uppercase tracking-wider text-slate-800">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>{siteConfig.heroEyebrow}</span>
        </div>

        <!-- Display Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display tracking-tight text-navy-950 leading-[1.12]">
          Bridging Markets <br class="hidden sm:inline" />
          <span class="text-emerald-700 italic font-editorial-serif font-normal">Worldwide.</span>
        </h1>

        <!-- Persuasive Description -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl font-normal">
          <strong class="font-semibold text-navy-950">ZIYA ZARA TRADING COMPANY</strong> connects global markets by sourcing and supplying quality commodities, raw materials, and manufactured goods with commercial precision, integrity, and enduring partnerships.
        </p>

        <!-- Meaningful Actions -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/products"
            class="trade-btn-primary group"
            id="hero-explore-products-btn"
          >
            <span>Explore Our Products</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="/contact"
            class="trade-btn-secondary"
            id="hero-discuss-sourcing-btn"
          >
            <span>Discuss Sourcing</span>
          </a>
        </div>

        <!-- Micro Social Proof / Assurance Notice -->
        <div class="pt-4 flex items-center gap-6 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Verified Global Suppliers</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Direct Port Dispatch</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Cinematic Layered Multimodal Composition -->
      <div class="lg:col-span-6 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Primary Cinematic Visual: Ocean Container Vessel -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200/80 bg-navy-950 group">
            <img
              src="/images/hero/cargo_ship.jpg"
              alt="Deep ocean container cargo vessel navigating international waters at dusk"
              width="800"
              height="500"
              class="w-full h-[320px] sm:h-[400px] object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-navy-950/20"></div>

            <!-- Floating Badge: "From Anywhere to Everywhere" Handwritten Tag -->
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/40 shadow-lg flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="font-editorial-serif italic text-xs font-semibold text-navy-950">From Anywhere to Everywhere</span>
            </div>

            <!-- Vessel Status Label -->
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white text-xs">
              <div class="flex items-center gap-2 bg-navy-950/70 backdrop-blur-sm px-3 py-1.5 rounded-lg border border-white/10">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span class="font-medium tracking-wide">Multi-Modal Logistics Synchronization</span>
              </div>
            </div>
          </div>

          <!-- Secondary Layer: Floating Air Cargo Card (Top-Left Accent) -->
          <div class="hidden sm:flex absolute -top-6 -left-6 bg-white/95 backdrop-blur-md p-2.5 rounded-xl shadow-xl border border-slate-200/80 items-center gap-3 transition-transform hover:-translate-y-1 duration-300">
            <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-navy-900">
              <img
                src="/images/hero/air_freight.jpg"
                alt="Air freight logistics airliner"
                width="80"
                height="80"
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="pr-3">
              <div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider">Air Freight</div>
              <div class="text-xs font-bold text-navy-950">Time-Critical Routing</div>
            </div>
          </div>

          <!-- Tertiary Layer: Floating Road Transport Card (Bottom-Right Accent) -->
          <div class="hidden sm:flex absolute -bottom-6 -right-6 bg-white/95 backdrop-blur-md p-2.5 rounded-xl shadow-xl border border-slate-200/80 items-center gap-3 transition-transform hover:translate-y-1 duration-300">
            <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-navy-900">
              <img
                src="/images/hero/road_truck.jpg"
                alt="Commercial freight truck"
                width="80"
                height="80"
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="pr-3">
              <div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider">Overland Haulage</div>
              <div class="text-xs font-bold text-navy-950">Door-to-Port Delivery</div>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Horizontal Badges Strip: Key Values -->
    <div class="mt-16 pt-10 border-t border-slate-200/80 grid grid-cols-2 md:grid-cols-4 gap-6">
      
      <!-- 1. Reliable Sourcing -->
      <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-navy-950">Reliable Sourcing</h3>
          <p class="text-xs text-slate-500 mt-0.5">Vetted suppliers & specification fidelity.</p>
        </div>
      </div>

      <!-- 2. Global Network -->
      <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"></circle>
            <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-navy-950">Global Network</h3>
          <p class="text-xs text-slate-500 mt-0.5">Established links across key corridors.</p>
        </div>
      </div>

      <!-- 3. Long-Term Partnerships -->
      <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-navy-950">Long-Term Partners</h3>
          <p class="text-xs text-slate-500 mt-0.5">Committed commercial relationships.</p>
        </div>
      </div>

      <!-- 4. Sustainable Growth -->
      <div class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-slate-50 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-navy-950">Sustainable Trade</h3>
          <p class="text-xs text-slate-500 mt-0.5">Reliability and commercial continuity.</p>
        </div>
      </div>

    </div>

  </div>
</section>
