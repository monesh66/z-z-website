---
const modes = [
  {
    title: "AIR FREIGHT",
    subtitle: "Fast. Reliable. Global.",
    image: "/images/reference_crops/logistics_air_ref.png",
  },
  {
    title: "SEA FREIGHT",
    subtitle: "Cost-effective. High Capacity.",
    image: "/images/reference_crops/logistics_sea_ref.png",
  },
  {
    title: "ROAD TRANSPORT",
    subtitle: "Flexible. Door-to-Door.",
    image: "/images/reference_crops/logistics_road_ref.png",
  },
];
---

<section id="logistics" class="py-16 lg:py-24 bg-[#0A192F] text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Action -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Eyebrow -->
        <div class="scroll-reveal text-xs font-bold uppercase tracking-widest text-emerald-400 font-mono">
          MULTI-MODE LOGISTICS
        </div>

        <!-- Headline -->
        <h2 class="scroll-reveal stagger-1 text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-white tracking-tight leading-tight">
          By Air, Sea and Road<br />
          <span class="text-white">Across the World</span>
        </h2>

        <!-- Description -->
        <p class="scroll-reveal stagger-2 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          We ensure efficient and cost-effective delivery through a well-connected network of air, sea and road transport partners, giving you reliable logistics solutions for every shipment.
        </p>

        <!-- CTA Button -->
        <div class="scroll-reveal stagger-3 pt-2">
          <a
            href="/#contact?interest=Logistics"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all duration-300 shadow-md hover:shadow-lg shadow-emerald-950/20 group"
          >
            <span>Our Logistics Solutions</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: 3 Photo Cards Side-by-Side -->
      <div class="lg:col-span-7">
        <div data-reveal-group data-reveal-stagger="90" class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {modes.map((mode) => (
            <div class="rounded-2xl overflow-hidden bg-[#0F2242] border border-white/10 group hover:-translate-y-1.5 transition-all duration-300 shadow-xl flex flex-col">
              
              <!-- Photo Box -->
              <div class="relative aspect-[4/3] overflow-hidden bg-slate-900">
                <img
                  src={mode.image}
                  alt={mode.title}
                  width="400"
                  height="300"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0F2242] via-transparent to-transparent opacity-80"></div>
              </div>

              <!-- Card Info -->
              <div class="p-4 sm:p-5 flex-grow flex flex-col justify-end text-center sm:text-left">
                <h3 class="text-sm sm:text-base font-bold font-display text-white tracking-wide">
                  {mode.title}
                </h3>
                <p class="text-[11px] sm:text-xs text-slate-300 mt-1 font-normal">
                  {mode.subtitle}
                </p>
              </div>

            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
