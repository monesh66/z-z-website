---
import { siteConfig } from '../data/site';
---

<section id="logistics" class="py-16 lg:py-20 bg-[#0B1F3A] text-white overflow-hidden">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Headline & Description (approx 35%) -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#2E8B2E]">Multi-Mode Logistics</span>
          <span class="w-7 h-[2px] bg-[#2E8B2E]"></span>
        </div>

        <h2 class="text-2xl sm:text-3xl lg:text-[32px] font-bold font-editorial-serif text-white tracking-tight leading-snug">
          By Air, Sea and Road<br />
          Across the World
        </h2>

        <p class="text-[14px] text-white/80 leading-relaxed font-normal max-w-md">
          We ensure efficient and cost-effective delivery through a well-connected network of air, sea and road transport partners, giving you reliable logistics solutions for every shipment.
        </p>

        <div class="pt-2">
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 px-6 h-[44px] rounded-[6px] text-sm font-semibold text-white bg-[#2E8B2E] hover:bg-[#257325] transition-all duration-200 shadow-sm hover:shadow-md group"
          >
            <span>Our Logistics Solutions</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: 3 Slanted Photo Panels matching reference (approx 65%) -->
      <div class="lg:col-span-7 flex flex-col sm:flex-row items-stretch gap-2.5 sm:gap-2 h-auto sm:h-56 lg:h-60">
        
        <!-- Air Freight -->
        <div class="relative flex-1 rounded-lg sm:rounded-none overflow-hidden h-48 sm:h-full bg-slate-900 group shadow-md sm:transform sm:-skew-x-6 border-y sm:border-y-0 sm:border-r border-white/20">
          <div class="w-full h-full sm:transform sm:skew-x-6 sm:scale-115">
            <img
              src="/images/logistics/air.jpg"
              alt="Air Freight logistics cargo aircraft"
              width="600"
              height="400"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 p-3.5 bg-gradient-to-t from-[#0B1F3A] via-[#0B1F3A]/85 to-transparent">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
                Air Freight
              </h3>
              <p class="text-[11px] text-slate-300 mt-0.5">
                Fast. Reliable. Global.
              </p>
            </div>
          </div>
        </div>

        <!-- Sea Freight -->
        <div class="relative flex-1 rounded-lg sm:rounded-none overflow-hidden h-48 sm:h-full bg-slate-900 group shadow-md sm:transform sm:-skew-x-6 border-y sm:border-y-0 sm:border-r border-white/20">
          <div class="w-full h-full sm:transform sm:skew-x-6 sm:scale-115">
            <img
              src="/images/logistics/sea.jpg"
              alt="Sea Freight container ship"
              width="600"
              height="400"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 p-3.5 bg-gradient-to-t from-[#0B1F3A] via-[#0B1F3A]/85 to-transparent">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
                Sea Freight
              </h3>
              <p class="text-[11px] text-slate-300 mt-0.5">
                Cost-effective. High Capacity.
              </p>
            </div>
          </div>
        </div>

        <!-- Road Transport -->
        <div class="relative flex-1 rounded-lg sm:rounded-none overflow-hidden h-48 sm:h-full bg-slate-900 group shadow-md sm:transform sm:-skew-x-6">
          <div class="w-full h-full sm:transform sm:skew-x-6 sm:scale-115">
            <img
              src="/images/logistics/road.jpg"
              alt="Road Transport cargo truck"
              width="600"
              height="400"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-x-0 bottom-0 p-3.5 bg-gradient-to-t from-[#0B1F3A] via-[#0B1F3A]/85 to-transparent">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
                Road Transport
              </h3>
              <p class="text-[11px] text-slate-300 mt-0.5">
                Flexible. Door-to-Door.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
