---
import { siteConfig } from '../data/site';
---

<section id="logistics" class="py-16 lg:py-20 bg-[#0B1F36] text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column: Headline & Description (col-span-5) -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Multi-Mode Logistics</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-bold font-editorial-serif text-white tracking-tight leading-tight">
          By Air, Sea and Road<br />
          Across the World
        </h2>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
          We ensure efficient and cost-effective delivery through a well-connected network of air, sea and road transport partners, giving you reliable logistics solutions for every shipment.
        </p>

        <div class="pt-2">
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#138848] hover:bg-[#0f6f3b] transition-all duration-200 shadow-sm group"
          >
            <span>Our Logistics Solutions</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: 3 Photo Cards (col-span-7) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <!-- Air Freight -->
        <div class="rounded-2xl overflow-hidden bg-slate-900 border border-white/10 group shadow-md flex flex-col justify-between">
          <div class="relative h-44 overflow-hidden">
            <img
              src="/images/logistics/air.jpg"
              alt="Air Freight"
              width="300"
              height="200"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-3.5 bg-[#09182B]">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
              Air Freight
            </h3>
            <p class="text-[11px] text-slate-300 mt-0.5">
              Fast. Reliable. Global.
            </p>
          </div>
        </div>

        <!-- Sea Freight -->
        <div class="rounded-2xl overflow-hidden bg-slate-900 border border-white/10 group shadow-md flex flex-col justify-between">
          <div class="relative h-44 overflow-hidden">
            <img
              src="/images/logistics/sea.jpg"
              alt="Sea Freight"
              width="300"
              height="200"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-3.5 bg-[#09182B]">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
              Sea Freight
            </h3>
            <p class="text-[11px] text-slate-300 mt-0.5">
              Cost-effective, High Capacity.
            </p>
          </div>
        </div>

        <!-- Road Transport -->
        <div class="rounded-2xl overflow-hidden bg-slate-900 border border-white/10 group shadow-md flex flex-col justify-between">
          <div class="relative h-44 overflow-hidden">
            <img
              src="/images/logistics/road.jpg"
              alt="Road Transport"
              width="300"
              height="200"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-3.5 bg-[#09182B]">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-display">
              Road Transport
            </h3>
            <p class="text-[11px] text-slate-300 mt-0.5">
              Flexible. Door-to-Door.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
