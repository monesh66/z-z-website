---
import ProgressiveImage from './ui/ProgressiveImage.astro';

interface ProductItem {
  title: string;
  desc: string;
  image: string;
  href: string;
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
---

<div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between group">
  <!-- Card Image with Individual Progressive Loader -->
  <ProgressiveImage
    src={product.image}
    alt={product.title}
    width="400"
    height="280"
    containerClass="aspect-[16/11]"
    class="transition-transform duration-500 ease-out group-hover:scale-105"
    size="sm"
    showText={false}
  />

  <!-- Card Body -->
  <div class="p-4 sm:p-5 flex-grow flex flex-col justify-between space-y-3">
    <div>
      <h3 class="text-sm sm:text-base font-bold text-navy-950 group-hover:text-emerald-700 transition-colors leading-snug">
        {product.title}
      </h3>
      <p class="text-[11px] sm:text-xs text-slate-500 mt-1.5 leading-relaxed">
        {product.desc}
      </p>
    </div>

    <!-- Bottom Arrow Circle Button -->
    <div class="flex items-center justify-end pt-1">
      <a
        href={product.href}
        class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#0A192F] text-white flex items-center justify-center transition-transform group-hover:scale-110 group-hover:bg-emerald-600 shadow-xs"
        aria-label={`View ${product.title}`}
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
