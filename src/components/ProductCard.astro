---
import type { ProductCategory } from '../data/products';

interface Props {
  product: ProductCategory;
}

const { product } = Astro.props;
---

<div class="flex flex-col bg-white rounded-[10px] overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-300 group">
  <!-- Image Container -->
  <div class="relative h-[130px] overflow-hidden bg-slate-100">
    <img
      src={product.image}
      alt={product.title}
      width="300"
      height="180"
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
    />
  </div>

  <!-- Content & Bottom Arrow Button -->
  <div class="p-3.5 flex-grow flex flex-col justify-between space-y-2">
    <div>
      <h3 class="text-sm font-bold text-[#0B1F3A] leading-tight">
        {product.title}
      </h3>
      <p class="text-[12px] text-[#5B6573] mt-1 leading-snug line-clamp-2">
        {product.shortDescription}
      </p>
    </div>

    <!-- Bottom Arrow Button matching reference mockup -->
    <div class="pt-1 flex justify-end">
      <a
        href={`/#contact?interest=${encodeURIComponent(product.title)}`}
        class="w-6 h-6 rounded-full bg-[#0B1F3A] text-white flex items-center justify-center transition-transform hover:scale-110 hover:bg-[#2E8B2E]"
        title={`Inquire about ${product.title}`}
        aria-label={`Inquire about ${product.title}`}
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</div>
