---
import ProgressiveImage from './ui/ProgressiveImage.astro';

export interface ProductItem {
  title: string;
  desc: string;
  image: string;
  href: string;
  badge?: string;
  count?: string;
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
---

<a
  href={product.href}
  class="group bg-white rounded-2xl overflow-hidden border border-slate-200/90 shadow-xs hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between will-change-transform block"
>
  <!-- Card Image with Individual Progressive Loader -->
  <div class="relative overflow-hidden aspect-[16/11] bg-slate-100">
    <ProgressiveImage
      src={product.image}
      alt={product.title}
      width="400"
      height="280"
      containerClass="w-full h-full"
      class="transition-transform duration-500 ease-out group-hover:scale-105"
      size="sm"
      showText={false}
    />
    {product.badge && (
      <div class="absolute top-2.5 left-2.5 z-20 bg-white/95 backdrop-blur-xs px-2 py-0.5 rounded-md border border-slate-200/80 shadow-xs pointer-events-none">
        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-slate-800 uppercase tracking-wider">
          {product.badge}
        </span>
      </div>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-3.5 sm:p-4 flex-grow flex flex-col justify-between space-y-2.5">
    <div>
      <h3 class="text-xs sm:text-sm md:text-base font-bold font-display text-navy-950 group-hover:text-emerald-700 transition-colors leading-snug line-clamp-1">
        {product.title}
      </h3>
      <p class="text-[11px] sm:text-xs text-slate-500 mt-1 leading-relaxed line-clamp-2">
        {product.desc}
      </p>
    </div>

    <!-- Bottom Info & Arrow -->
    <div class="flex items-center justify-between pt-2 border-t border-slate-100/90">
      {product.count ? (
        <span class="text-[10px] sm:text-[11px] font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full">
          {product.count}
        </span>
      ) : (
        <span class="text-[11px] text-slate-400 font-medium">Explore</span>
      )}
      <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-[#0A192F] text-white flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:bg-[#134E34] shadow-xs">
        <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
  </div>
</a>
