---
import type { ProductCategory } from '../data/products';

interface Props {
  product: ProductCategory;
}

const { product } = Astro.props;
---

<div class="flex flex-col bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 group hover:-translate-y-1">
  <!-- Image Container -->
  <div class="relative h-44 sm:h-48 overflow-hidden bg-slate-100">
    <img
      src={product.image}
      alt={product.title}
      width="400"
      height="300"
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
    />
  </div>

  <!-- Content & Bottom Arrow Button -->
  <div class="p-4 sm:p-5 flex-grow flex flex-col justify-between space-y-3">
    <div>
      <h3 class="text-base sm:text-lg font-bold font-display text-[#0B1F36] leading-snug">
        {product.title}
      </h3>
      <p class="text-xs text-slate-500 mt-1.5 leading-relaxed font-normal">
        {product.shortDescription}
      </p>
    </div>

    <!-- Bottom Arrow Button -->
    <div class="pt-2 flex justify-end">
      <a
        href={`/#contact?interest=${encodeURIComponent(product.title)}`}
        class="w-8 h-8 rounded-full bg-[#0B1F36] text-white flex items-center justify-center transition-transform hover:scale-110 hover:bg-[#138848]"
        title={`Inquire about ${product.title}`}
        aria-label={`Inquire about ${product.title}`}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</div>
