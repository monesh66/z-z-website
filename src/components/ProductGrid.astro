---
import ProductCard from './ProductCard.astro';

const landingProducts = [
  {
    title: "Agricultural Products",
    desc: "Grains, pulses, spices and more.",
    image: "/images/products/agricultural.jpg",
    href: "/products?category=agricultural",
  },
  {
    title: "Food & Grains",
    desc: "Rice, wheat, pulses, edible oils and food items.",
    image: "/images/products/food_grains.jpg",
    href: "/products?category=food-grains",
  },
  {
    title: "Textiles & Garments",
    desc: "Fabrics, apparel and textile raw materials.",
    image: "/images/products/textiles.jpg",
    href: "/products?category=textiles",
  },
  {
    title: "Industrial Supplies",
    desc: "Metals, pipes, machinery and industrial materials.",
    image: "/images/products/industrial.jpg",
    href: "/products?category=industrial",
  },
  {
    title: "Consumer Goods",
    desc: "Daily use and general merchandise.",
    image: "/images/products/consumer.jpg",
    href: "/products?category=consumer",
  },
  {
    title: "Custom Sourcing",
    desc: "Tailored sourcing as per your requirements.",
    image: "/images/products/custom_sourcing.jpg",
    href: "/products?category=custom",
  },
];
---

<section id="products" class="py-16 lg:py-24 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="scroll-reveal flex flex-col sm:flex-row sm:items-end justify-between mb-10 lg:mb-12 gap-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2.5">
          <span class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-navy-950 font-mono">
            OUR PRODUCTS
          </span>
          <span class="w-8 h-0.5 bg-emerald-500"></span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold font-serif text-navy-950 tracking-tight">
          Diverse Products for Global Markets
        </h2>
      </div>

      <div class="flex-shrink-0">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-50 border border-slate-300 text-navy-950 text-xs sm:text-sm font-semibold transition-all duration-300 shadow-xs hover:border-slate-400 group"
          id="view-all-products-btn"
        >
          <span>View All Products</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Product Grid: 6 Columns on Desktop -->
    <div data-reveal-group data-reveal-stagger="70" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-5">
      {landingProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

  </div>
</section>
