---
import ProductCard from './ProductCard.astro';
import { productCategories } from '../data/products';

interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit = 6, showAllLink = true } = Astro.props;
const displayCategories = productCategories.slice(0, limit);
---

<section id="products" class="py-16 lg:py-20 bg-white border-b border-slate-100">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#2E8B2E]">Our Products</span>
          <span class="w-7 h-[2px] bg-[#2E8B2E]"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold font-editorial-serif text-[#0B1F3A] tracking-tight">
          Diverse Products for Global Markets
        </h2>
      </div>

      {showAllLink && (
        <div class="flex-shrink-0">
          <a
            href="/products"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-[6px] text-sm font-semibold text-[#0B1F3A] bg-white border border-[#0B1F3A] hover:bg-[#0B1F3A] hover:text-white transition-all duration-200"
          >
            <span>View All Products</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      )}
    </div>

    <!-- Product Grid: 6 Categories matching the mockup in 1 row on desktop -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4">
      {displayCategories.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

  </div>
</section>
