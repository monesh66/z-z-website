---
import ProductCard from './ProductCard.astro';
import { productCategories } from '../data/products';

interface Props {
  limit?: number;
  showAllLink?: boolean;
}

const { limit = 6, showAllLink = true } = Astro.props;
const displayCategories = productCategories.slice(0, limit);
---

<section id="products" class="py-20 lg:py-28 bg-slate-50/70 border-b border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
          <span class="w-8 h-0.5 bg-emerald-600"></span>
          <span>Our Products</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-navy-950 tracking-tight">
          Diverse Products for <br class="hidden sm:inline" />
          <span class="text-emerald-700 font-editorial-serif italic font-normal">Global Markets.</span>
        </h2>
        <p class="text-base text-slate-600 font-normal pt-1">
          Explore our primary trade categories, spanning certified agricultural commodities, refined food staples, premium textiles, and heavy industrial supplies.
        </p>
      </div>

      {showAllLink && (
        <div class="flex-shrink-0">
          <a
            href="/products"
            class="trade-btn-secondary group"
            id="view-all-products-btn"
          >
            <span>View All Products</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      )}
    </div>

    <!-- Product Grid: 6 Cards in 3x2 on desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {displayCategories.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

  </div>
</section>
