---
const steps = [
  {
    num: "01",
    title: "Understand",
    desc: "Your requirements, specifications and target markets.",
    icon: `<svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  },
  {
    num: "02",
    title: "Source",
    desc: "We identify and engage trusted suppliers globally to source the right products.",
    icon: `<svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
  },
  {
    num: "03",
    title: "Verify",
    desc: "We ensure quality, compliance and documentation.",
    icon: `<svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    num: "04",
    title: "Deliver",
    desc: "We manage logistics and coordinate delivery to your destination.",
    icon: `<svg class="w-6 h-6 text-navy-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>`,
  },
];
---

<section id="sourcing" class="py-16 lg:py-24 bg-[#0A192F] text-white relative overflow-hidden">
  
  <!-- Faint Port Gantry Cranes Watermark on Right -->
  <div class="absolute inset-y-0 right-0 w-full lg:w-1/2 opacity-15 pointer-events-none z-0">
    <img
      src="/images/contact/port_twilight.jpg"
      alt="Shipping port gantry cranes"
      class="w-full h-full object-cover object-right"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A192F] via-[#0A192F]/80 to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="scroll-reveal space-y-2 mb-12 lg:mb-16">
      <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 font-mono">
        OUR SOURCING PROCESS
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-white tracking-tight">
        From Demand to Delivery
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-normal max-w-2xl pt-1">
        A streamlined process to ensure quality, reliability and on-time delivery.
      </p>
    </div>

    <!-- 4 Connected Process Cards -->
    <div data-reveal-group data-reveal-stagger="90" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch relative">
      {steps.map((item, idx) => (
        <div class="relative flex items-center">
          
          <!-- White Card -->
          <div class="w-full h-full bg-white text-navy-950 rounded-2xl p-6 sm:p-7 shadow-lg flex flex-col justify-between group hover:-translate-y-1 transition-all duration-300">
            
            <!-- Top Row: Green Number Badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="w-8 h-8 rounded-full bg-emerald-600 text-white text-xs font-bold font-mono flex items-center justify-center shadow-sm">
                {item.num}
              </span>
            </div>

            <!-- Icon & Title -->
            <div class="flex flex-col items-center text-center my-2">
              <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mb-3 group-hover:bg-emerald-50 transition-colors">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-base sm:text-lg font-bold font-display text-navy-950 mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>

            <!-- Empty bottom spacer to align cards -->
            <div class="h-2"></div>

          </div>

          <!-- Connecting Arrow Between Cards (Desktop Only) -->
          {idx < steps.length - 1 && (
            <div class="hidden lg:flex absolute -right-3.5 z-20 w-7 h-7 rounded-full bg-[#0A192F] border border-white/20 items-center justify-center text-white">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          )}

        </div>
      ))}
    </div>

  </div>
</section>
