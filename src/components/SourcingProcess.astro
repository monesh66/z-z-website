---
import { siteConfig } from '../data/site';
---

<section id="sourcing-process" class="py-16 lg:py-20 bg-[#0B1F3A] text-white relative overflow-hidden">
  
  <!-- Right Port Container Terminal Background Atmosphere -->
  <div class="absolute inset-y-0 right-0 w-full lg:w-7/12 opacity-50 pointer-events-none mix-blend-screen z-0">
    <img
      src="/images/contact/harbor_hd.jpg"
      alt="Port terminal cranes and shipping containers"
      class="w-full h-full object-cover object-right"
      loading="lazy"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A] via-[#0B1F3A]/85 to-[#0B1F3A]/20 pointer-events-none z-0"></div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="mb-12 space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#2E8B2E]">Our Sourcing Process</span>
        <span class="w-7 h-[2px] bg-[#2E8B2E]"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-[36px] font-bold font-editorial-serif text-white tracking-tight">
        From Demand to Delivery
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 font-normal">
        A streamlined process to ensure quality, reliability and on-time delivery.
      </p>
    </div>

    <!-- 4 Connected White Cards with Overlapping Badges -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-5 items-stretch relative pt-3">
      {siteConfig.sourcingSteps.map((step, index) => (
        <div class="relative bg-white text-slate-800 rounded-[10px] pt-7 pb-6 px-5 shadow-lg flex flex-col items-center text-center justify-between group">
          
          <!-- Green Number Circle overlapping top-left border -->
          <div class="absolute -top-3.5 left-4 w-8 h-8 rounded-full bg-[#2E8B2E] text-white text-xs font-bold flex items-center justify-center shadow-md">
            {step.step}
          </div>

          <!-- Centered Navy Outline Icon matching reference -->
          <div class="w-9 h-9 flex items-center justify-center text-[#0B1F3A] mb-3">
            {step.step === '01' && (
              <svg class="w-7 h-7 text-[#0B1F3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            )}
            {step.step === '02' && (
              <svg class="w-7 h-7 text-[#0B1F3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            )}
            {step.step === '03' && (
              <svg class="w-7 h-7 text-[#0B1F3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
              </svg>
            )}
            {step.step === '04' && (
              <svg class="w-7 h-7 text-[#0B1F3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <rect x="1" y="3" width="15" height="13" rx="1"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            )}
          </div>

          <!-- Title -->
          <h3 class="text-sm sm:text-[15px] font-bold text-[#0B1F3A] mb-1 font-display">
            {step.title}
          </h3>

          <!-- Description -->
          <p class="text-[12px] text-[#5B6573] leading-relaxed max-w-[210px]">
            {step.description}
          </p>

          <!-- Connector Arrow to next card on desktop -->
          {index < 3 && (
            <div class="hidden lg:flex absolute -right-3.5 top-1/2 -translate-y-1/2 z-20 pointer-events-none items-center justify-center text-slate-300">
              <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <polyline points="14 6 20 12 14 18"></polyline>
              </svg>
            </div>
          )}

        </div>
      ))}
    </div>

  </div>
</section>
