---
import { siteConfig } from '../data/site';
---

<section id="sourcing-process" class="py-16 lg:py-20 bg-[#0B1F36] text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-300">Our Sourcing Process</span>
        <span class="w-8 h-[2px] bg-[#138848]"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-editorial-serif text-white tracking-tight">
        From Demand to Delivery
      </h2>
      <p class="text-sm sm:text-base text-slate-300 font-normal">
        A streamlined process to ensure quality, reliability and on-time delivery:
      </p>
    </div>

    <!-- 4 Connected White Cards with Arrow Connectors -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {siteConfig.sourcingSteps.map((step, index) => (
        <div class="relative flex flex-col justify-between bg-white text-slate-800 rounded-2xl p-6 shadow-lg border border-slate-100 group hover:-translate-y-1 transition-all duration-300">
          
          <div>
            <!-- Header with Number Pill and Icon -->
            <div class="flex items-center justify-between mb-4">
              <!-- Green Number Circle -->
              <span class="w-8 h-8 rounded-full bg-[#138848] text-white text-xs font-bold flex items-center justify-center">
                {step.step}
              </span>
              
              <!-- Clean Icon -->
              <div class="w-9 h-9 rounded-lg bg-slate-50 flex items-center justify-center text-slate-700">
                {step.step === '01' && (
                  <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                )}
                {step.step === '02' && (
                  <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                )}
                {step.step === '03' && (
                  <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {step.step === '04' && (
                  <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                )}
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-base font-bold text-[#0B1F36] mb-2 font-display">
              {step.title}
            </h3>

            <!-- Description -->
            <p class="text-xs text-slate-600 leading-relaxed">
              {step.description}
            </p>
          </div>

          <!-- Connector Arrow to next card (visible on desktop for first 3 cards) -->
          {index < 3 && (
            <div class="hidden lg:flex absolute -right-3.5 top-1/2 -translate-y-1/2 z-20 w-7 h-7 rounded-full bg-[#0B1F36] border border-white/20 items-center justify-center text-white text-xs">
              <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          )}

        </div>
      ))}
    </div>

  </div>
</section>
