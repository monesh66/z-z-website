---
import { siteConfig } from '../data/site';
---

<section id="sourcing-process" class="py-20 lg:py-28 bg-navy-950 text-white relative overflow-hidden">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none bg-[radial-gradient(#FFFFFF_1px,transparent_1px)] [background-size:28px_28px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-400">
        <span class="w-8 h-0.5 bg-emerald-500"></span>
        <span>Our Sourcing Process</span>
        <span class="w-8 h-0.5 bg-emerald-500"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display tracking-tight text-white">
        From Demand <span class="text-emerald-400 font-editorial-serif italic font-normal">to Delivery</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed pt-2">
        A disciplined, 4-stage international trade workflow structured to eliminate commercial risks, guarantee specification compliance, and ensure punctual port delivery.
      </p>
    </div>

    <!-- 4 Connected Process Steps -->
    <div class="relative">
      
      <!-- Desktop Connecting Line Behind Steps -->
      <div class="hidden lg:block absolute top-1/2 left-12 right-12 h-0.5 bg-gradient-to-r from-emerald-500/20 via-emerald-500/80 to-emerald-500/20 -translate-y-12 z-0"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative z-10">
        {siteConfig.sourcingSteps.map((item, index) => (
          <div class="relative bg-navy-900/90 backdrop-blur-md rounded-2xl p-6 sm:p-7 border border-white/10 hover:border-emerald-500/50 transition-all duration-300 group hover:-translate-y-1.5 flex flex-col justify-between shadow-xl">
            
            <div>
              <!-- Step Header & Number Pill -->
              <div class="flex items-center justify-between mb-6">
                <span class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-display font-bold text-lg flex items-center justify-center group-hover:bg-emerald-500 group-hover:text-navy-950 transition-colors">
                  {item.step}
                </span>
                <span class="text-[11px] font-mono tracking-widest uppercase text-champagne/80 font-semibold">
                  Stage {index + 1}
                </span>
              </div>

              <!-- Step Title -->
              <h3 class="text-xl font-bold font-display text-white mb-3 group-hover:text-emerald-300 transition-colors">
                {item.title}
              </h3>

              <!-- Step Description -->
              <p class="text-sm text-slate-300 leading-relaxed font-normal mb-6">
                {item.description}
              </p>
            </div>

            <!-- Deliverables List -->
            <div class="pt-4 border-t border-white/10 space-y-2">
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-semibold">Key Deliverables:</div>
              <ul class="space-y-1.5">
                {item.deliverables.map((deliv) => (
                  <li class="flex items-center gap-2 text-xs text-slate-300">
                    <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{deliv}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        ))}
      </div>

    </div>

    <!-- Sourcing Assistance Callout Banner -->
    <div class="mt-16 bg-navy-900 rounded-2xl p-6 sm:p-8 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center md:text-left">
        <h4 class="text-lg font-bold text-white font-display">Have a bespoke commodity or technical procurement specification?</h4>
        <p class="text-sm text-slate-300">Our international sourcing team reviews technical specifications and delivers origin feasibility within 48 hours.</p>
      </div>
      <a
        href="/contact"
        class="trade-btn-primary flex-shrink-0"
      >
        <span>Request Sourcing Consultation</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

  </div>
</section>
