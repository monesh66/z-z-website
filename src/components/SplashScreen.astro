---
// src/components/SplashScreen.astro
---

<!-- Instant Return-Visit Script (Zero layout shift, zero FOUC) -->
<script is:inline>
  (function () {
    try {
      var isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      var isForced = window.location.search.indexOf('splash=true') !== -1;
      if (!isLocal && !isForced && sessionStorage.getItem('ziya_zara_splash_shown') === 'true') {
        document.documentElement.classList.add('splash-dismissed');
      }
    } catch (e) {}
  })();
</script>

<style>
  html.splash-dismissed #splash-screen-root {
    display: none !important;
  }

  /* GPU-Accelerated 3D Viewport */
  .perspective-viewport {
    perspective: 1200px;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  /* =========================================================================
     SILKY-SMOOTH 60/120 FPS FLIGHT TRAJECTORY
     - Strictly monotonic coordinates (continuous forward & upward climb)
     - Identical properties across all keyframes to eliminate compositor stalls
     - Zero filter:blur or drop-shadow recalculations
     ========================================================================= */
  @keyframes flightSmoothCinematic {
    0% {
      opacity: 0;
      transform: translate3d(-38vw, 24vh, -240px) scale(0.28) rotateZ(-7deg);
    }
    12% {
      opacity: 1;
      transform: translate3d(-26vw, 15vh, -160px) scale(0.44) rotateZ(-5deg);
    }
    35% {
      opacity: 1;
      transform: translate3d(-10vw, 5vh, -70px) scale(0.68) rotateZ(-2deg);
    }
    62% {
      opacity: 1;
      transform: translate3d(8vw, -6vh, 20px) scale(0.96) rotateZ(1deg);
    }
    85% {
      opacity: 1;
      transform: translate3d(25vw, -16vh, 90px) scale(1.22) rotateZ(4deg);
    }
    100% {
      opacity: 0.95;
      transform: translate3d(42vw, -25vh, 150px) scale(1.45) rotateZ(6deg);
    }
  }

  @keyframes flightSmoothTablet {
    0% {
      opacity: 0;
      transform: translate3d(-32vw, 20vh, -180px) scale(0.3) rotateZ(-6deg);
    }
    15% {
      opacity: 1;
      transform: translate3d(-20vw, 12vh, -110px) scale(0.48) rotateZ(-4deg);
    }
    50% {
      opacity: 1;
      transform: translate3d(0vw, 0vh, 0px) scale(0.78) rotateZ(0deg);
    }
    85% {
      opacity: 1;
      transform: translate3d(20vw, -12vh, 60px) scale(1.08) rotateZ(3deg);
    }
    100% {
      opacity: 0.95;
      transform: translate3d(36vw, -20vh, 100px) scale(1.28) rotateZ(5deg);
    }
  }

  @keyframes flightSmoothMobile {
    0% {
      opacity: 0;
      transform: translate3d(-26vw, 16vh, -120px) scale(0.35) rotateZ(-5deg);
    }
    18% {
      opacity: 1;
      transform: translate3d(-14vw, 8vh, -60px) scale(0.55) rotateZ(-3deg);
    }
    55% {
      opacity: 1;
      transform: translate3d(2vw, -2vh, 10px) scale(0.85) rotateZ(1deg);
    }
    100% {
      opacity: 0.95;
      transform: translate3d(26vw, -16vh, 60px) scale(1.15) rotateZ(4deg);
    }
  }

  /* Pure GPU-accelerated motion classes */
  .splash-actor-running {
    will-change: transform, opacity;
    animation: flightSmoothCinematic 2.0s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  @media (max-width: 1024px) {
    .splash-actor-running {
      animation: flightSmoothTablet 2.0s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
  }

  @media (max-width: 640px) {
    .splash-actor-running {
      animation: flightSmoothMobile 2.0s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
    }
  }

  /* Dynamic Contrail Trails (using gradient opacity, zero filter blur) */
  @keyframes contrailStream {
    0% {
      opacity: 0.2;
      transform: scaleX(0.7) translate3d(0, 0, 0);
    }
    50% {
      opacity: 0.65;
      transform: scaleX(1.3) translate3d(-8px, 0, 0);
    }
    100% {
      opacity: 0.2;
      transform: scaleX(0.7) translate3d(0, 0, 0);
    }
  }

  .contrail-trail {
    will-change: transform, opacity;
    animation: contrailStream 1.2s ease-in-out infinite;
  }

  /* Tagline Smooth Slide In */
  @keyframes headlineFadeUp {
    0% {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .splash-headline-running {
    will-change: transform, opacity;
    animation: headlineFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* SVG Flight Corridor Stroke */
  @keyframes corridorDrawSmooth {
    0% {
      stroke-dashoffset: 1600;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  .splash-corridor-running {
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    will-change: stroke-dashoffset;
    animation: corridorDrawSmooth 1.3s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  /* Radar Pulse */
  @keyframes radarPulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .splash-radar-pulse {
    animation: radarPulse 2.0s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }
</style>

<!-- Fullscreen Splash & Loading Screen Root -->
<div
  id="splash-screen-root"
  role="dialog"
  aria-modal="true"
  aria-label="Welcome to ZIYA ZARA Trading Company"
  class="fixed inset-0 z-[100] overflow-hidden bg-white select-none pointer-events-auto transition-opacity duration-600 ease-out"
>
  <!-- Preload flight assets into browser cache -->
  <link rel="preload" as="image" href="/images/hero/hero_hd.jpg" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/hero/cinematic_aircraft.png" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/hero/splash_backdrop.jpg" />
  <link rel="preload" as="video" href="/videos/zz_loading_3s.mp4" type="video/mp4" />

  <!-- =========================================================================
       PHASE 1: 3-SECOND LOADING VIDEO ANIMATION & PROGRESS
       ========================================================================= -->
  <div
    id="splash-loading-phase"
    class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-white px-6 transition-opacity duration-500 ease-out"
  >
    <!-- Ambient emerald/blue radial backdrop glow -->
    <div
      class="absolute w-[450px] h-[450px] sm:w-[650px] sm:h-[650px] rounded-full pointer-events-none blur-3xl opacity-40"
      style="background: radial-gradient(circle, rgba(46, 139, 46, 0.15) 0%, rgba(11, 31, 58, 0.08) 50%, transparent 70%);"
    ></div>

    <!-- Fine Grid texture -->
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none"
      style="background-image: linear-gradient(#0B1F3A 1px, transparent 1px), linear-gradient(90deg, #0B1F3A 1px, transparent 1px); background-size: 60px 60px;"
    ></div>

    <div class="relative flex flex-col items-center max-w-lg w-full text-center">
      <!-- 3-Second Sped-up Loading Video -->
      <div class="relative w-full max-w-[320px] sm:max-w-[420px] md:max-w-[460px] aspect-[16/9] flex items-center justify-center overflow-hidden">
        <video
          id="splash-loading-video"
          autoplay
          muted
          playsinline
          preload="auto"
          class="w-full h-full object-contain"
        >
          <source src="/videos/zz_loading_3s.webm" type="video/webm" />
          <source src="/videos/zz_loading_3s.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- Live Loading Status & Telemetry Bar -->
      <div class="mt-4 sm:mt-6 flex flex-col items-center gap-3 w-full max-w-xs sm:max-w-sm">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#2E8B2E]"></span>
          </span>
          <span
            id="splash-loading-status"
            class="text-xs sm:text-sm font-semibold tracking-wider text-slate-800 uppercase font-mono"
          >
            Connecting Global Markets...
          </span>
        </div>

        <!-- Progress Track -->
        <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden border border-slate-200/80">
          <div
            id="splash-loading-bar"
            class="h-full bg-gradient-to-r from-[#2E8B2E] via-[#34D399] to-[#0B1F3A] w-0 transition-all duration-75 ease-linear rounded-full"
          ></div>
        </div>

        <!-- Percentage Counter -->
        <div class="flex justify-between w-full text-[10px] text-slate-400 font-mono tracking-widest uppercase">
          <span>ZIYA ZARA NETWORK</span>
          <span id="splash-loading-pct" class="text-emerald-600 font-bold">0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       PHASE 2: 3D CINEMATIC FLIGHT ANIMATION
       ========================================================================= -->
  <div
    id="splash-flight-phase"
    class="absolute inset-0 z-10 pointer-events-none opacity-0 transition-opacity duration-500 ease-out"
  >
    <!-- Background Panoramic Atmosphere -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero/splash_backdrop.jpg"
        alt=""
        class="w-full h-full object-cover object-[center_35%] opacity-85"
      />

      <!-- Deep Atmospheric Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#061222]/85 via-[#0B1F3A]/60 to-[#061222]/80"></div>

      <!-- Dawn Glow Core -->
      <div
        class="absolute top-1/4 right-1/4 w-[600px] h-[600px] rounded-full pointer-events-none -translate-y-1/2 translate-x-1/4 blur-3xl opacity-40"
        style="background: radial-gradient(circle, rgba(245, 158, 11, 0.4) 0%, rgba(220, 38, 38, 0.12) 40%, transparent 70%);"
      ></div>
    </div>

    <!-- Global Trade Telemetry HUD -->
    <div class="absolute inset-0 z-10 p-6 sm:p-10 flex flex-col justify-between text-white/50 text-[10px] sm:text-xs font-mono tracking-widest uppercase">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2E8B2E]"></span>
          </span>
          <span class="text-emerald-400 font-semibold tracking-[0.2em]">ZZ-CORRIDOR // INT'L FREIGHT NETWORK</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-emerald-300 font-semibold">
          FLIGHT CLEARANCE: AUTHORIZED
        </div>
      </div>

      <div class="flex items-end justify-between">
        <div class="space-y-0.5">
          <div class="text-[9px] text-white/40 tracking-[0.2em]">MULTIMODAL PRECISION LOGISTICS</div>
          <div class="text-emerald-400/80 font-sans text-xs">AIR FREIGHT &bull; OCEAN CONTAINER &bull; INTERMODAL</div>
        </div>
        <div class="hidden sm:block text-right text-[10px] text-white/50 tracking-widest">
          DESTINATION: <span class="text-emerald-300 font-bold">GLOBAL TRADE HUB</span>
        </div>
      </div>
    </div>

    <!-- Geodesic Flight Route Vector (SVG) -->
    <svg
      id="splash-route-svg"
      class="absolute inset-0 w-full h-full z-15 pointer-events-none"
      viewBox="0 0 1440 900"
      preserveAspectRatio="none"
      fill="none"
    >
      <defs>
        <linearGradient id="corridorGradSmooth" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#2E8B2E" stop-opacity="0.3" />
          <stop offset="40%" stop-color="#34D399" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#A7F3D0" stop-opacity="1" />
        </linearGradient>
      </defs>

      <!-- Main Flight Path -->
      <path
        d="M 100,740 C 300,700 460,540 700,440 C 920,350 1120,260 1340,190"
        stroke="url(#corridorGradSmooth)"
        stroke-width="3"
        stroke-linecap="round"
        class="splash-corridor-running"
      />

      <!-- Parallel Echo Corridor -->
      <path
        d="M 130,760 C 330,720 490,560 730,460 C 950,370 1150,280 1370,210"
        stroke="#2E8B2E"
        stroke-width="1.2"
        stroke-dasharray="6 10"
        stroke-opacity="0.45"
        class="splash-corridor-running"
      />

      <!-- Waypoint 1: Origin -->
      <g transform="translate(160, 725)">
        <circle cx="0" cy="0" r="14" fill="#2E8B2E" fill-opacity="0.25" class="splash-radar-pulse" />
        <circle cx="0" cy="0" r="5" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2" fill="#FFFFFF" />
        <text x="12" y="4" fill="#34D399" font-family="monospace" font-size="10" font-weight="600" letter-spacing="1.5">PACIFIC SOURCING</text>
      </g>

      <!-- Waypoint 2: Hub -->
      <g transform="translate(620, 480)">
        <circle cx="0" cy="0" r="14" fill="#2E8B2E" fill-opacity="0.25" class="splash-radar-pulse" style="animation-delay: 0.4s;" />
        <circle cx="0" cy="0" r="5" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2" fill="#FFFFFF" />
        <text x="12" y="4" fill="#34D399" font-family="monospace" font-size="10" font-weight="600" letter-spacing="1.5">MIDDLE EAST HUB</text>
      </g>

      <!-- Waypoint 3: Destination -->
      <g transform="translate(1260, 215)">
        <circle cx="0" cy="0" r="18" fill="#34D399" fill-opacity="0.3" class="splash-radar-pulse" style="animation-delay: 0.8s;" />
        <circle cx="0" cy="0" r="7" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2.5" fill="#FFFFFF" />
        <text x="-140" y="-12" fill="#FFFFFF" font-family="monospace" font-size="10" font-weight="700" letter-spacing="1.5">GLOBAL DESTINATION</text>
      </g>
    </svg>

    <!-- 3D Airliner Flight Actor (Continuous, Butter-Smooth 60/120 FPS) -->
    <div
      class="absolute inset-0 z-25 perspective-viewport flex items-center justify-center pointer-events-none"
    >
      <div
        id="splash-aircraft-actor"
        class="relative w-[320px] sm:w-[520px] md:w-[700px] lg:w-[820px] aspect-[1254/503] opacity-0"
      >
        <!-- Luminous Engine Contrails (Gradient-based, Zero Rasterization Blur) -->
        <div
          class="contrail-trail absolute top-[48%] -left-36 sm:-left-56 w-40 sm:w-64 h-2 sm:h-2.5 rounded-full pointer-events-none"
          style="background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.4) 60%, rgba(52, 211, 153, 0.6) 100%);"
        ></div>
        <div
          class="contrail-trail absolute top-[62%] -left-32 sm:-left-48 w-36 sm:w-56 h-1.5 sm:h-2 rounded-full pointer-events-none"
          style="background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 60%, rgba(52, 211, 153, 0.5) 100%); animation-delay: 0.2s;"
        ></div>

        <!-- Airliner Image -->
        <img
          src="/images/hero/cinematic_aircraft.png"
          alt="Cargo aircraft in flight"
          width="1254"
          height="503"
          class="w-full h-full object-contain pointer-events-none select-none"
          style="transform: translateZ(0); backface-visibility: hidden;"
        />
      </div>
    </div>

    <!-- Tagline: "GLOBAL REACH" -->
    <div
      id="splash-tagline-container"
      class="absolute bottom-12 sm:bottom-16 left-6 sm:left-12 lg:left-20 z-30 max-w-xl pointer-events-none opacity-0"
    >
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#2E8B2E] shadow-[0_0_8px_#2E8B2E]"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] text-emerald-400 uppercase font-mono">
            INTERNATIONAL TRADE & LOGISTICS
          </span>
        </div>

        <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-editorial-serif tracking-tight leading-none text-white drop-shadow-md">
          <span>Global</span>
          <span class="bg-gradient-to-r from-[#2E8B2E] via-[#34D399] to-[#6EE7B7] bg-clip-text text-transparent ml-2">Reach</span>
        </h2>

        <p class="text-xs sm:text-sm text-slate-200/90 font-sans tracking-wide">
          Connecting Markets &bull; Reliable Sourcing Worldwide
        </p>
      </div>
    </div>
  </div>

  <!-- Accessible Skip Button -->
  <button
    id="splash-skip-btn"
    type="button"
    aria-label="Skip introduction animation"
    class="absolute top-5 right-5 sm:top-7 sm:right-8 z-[60] flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/40 hover:bg-slate-900/60 active:bg-slate-900/80 border border-white/20 backdrop-blur-md text-white text-xs font-medium tracking-wider uppercase transition-all duration-200 cursor-pointer shadow-xl focus:outline-none focus:ring-2 focus:ring-[#2E8B2E]"
  >
    <span>Skip Intro</span>
    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
    </svg>
  </button>
</div>

<!-- High-Performance Orchestration Script -->
<script>
  (function () {
    const SPLASH_KEY = 'ziya_zara_splash_shown';
    const root = document.getElementById('splash-screen-root');
    const loadingPhase = document.getElementById('splash-loading-phase');
    const flightPhase = document.getElementById('splash-flight-phase');
    const video = document.getElementById('splash-loading-video') as HTMLVideoElement | null;
    const statusText = document.getElementById('splash-loading-status');
    const progressBar = document.getElementById('splash-loading-bar');
    const pctText = document.getElementById('splash-loading-pct');
    const skipBtn = document.getElementById('splash-skip-btn');
    const aircraftActor = document.getElementById('splash-aircraft-actor');
    const tagline = document.getElementById('splash-tagline-container');

    if (!root) return;

    const urlParams = new URLSearchParams(window.location.search);
    const forceSplash = urlParams.get('splash') === 'true';
    const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

    let hasSeenSplash = false;
    try {
      hasSeenSplash = !isLocal && !forceSplash && sessionStorage.getItem(SPLASH_KEY) === 'true';
    } catch (e) {}

    const prefersReducedMotion = !forceSplash && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hasSeenSplash || prefersReducedMotion) {
      root.style.display = 'none';
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.add('splash-dismissed');
      return;
    }

    document.body.classList.add('overflow-hidden');

    let isDismissed = false;
    let flightStarted = false;
    let pageLoaded = document.readyState === 'complete';
    let videoCompleted = false;
    let animFrameId: number | null = null;

    const statusMessages = [
      'Connecting Global Markets...',
      'Synchronizing Freight Corridors...',
      'Verifying Multimodal Logistics...',
      'Finalizing Flight Clearance...'
    ];

    const startTime = performance.now();
    const TARGET_DURATION = 3000; // Exact 3.0s loading duration

    function updateProgress() {
      if (flightStarted || isDismissed) return;

      const elapsed = performance.now() - startTime;
      const progress = Math.min(elapsed / TARGET_DURATION, 1.0);
      const pct = Math.floor(progress * 100);

      if (progressBar) progressBar.style.width = pct + '%';
      if (pctText) pctText.textContent = pct + '%';

      if (statusText) {
        const msgIdx = Math.min(Math.floor(progress * statusMessages.length), statusMessages.length - 1);
        if (statusText.textContent !== statusMessages[msgIdx]) {
          statusText.textContent = statusMessages[msgIdx];
        }
      }

      if (progress >= 1.0) {
        videoCompleted = true;
        checkProceedToFlight();
      } else {
        animFrameId = requestAnimationFrame(updateProgress);
      }
    }
    animFrameId = requestAnimationFrame(updateProgress);

    // Page Content Loaded Listener
    if (!pageLoaded) {
      window.addEventListener('load', () => {
        pageLoaded = true;
        checkProceedToFlight();
      });
    }

    if (video) {
      video.addEventListener('ended', () => {
        videoCompleted = true;
        checkProceedToFlight();
      });
      video.play().catch(() => {});
    }

    function checkProceedToFlight() {
      if (flightStarted || isDismissed) return;

      if (videoCompleted && pageLoaded) {
        startFlightPhase();
      } else if (videoCompleted && !pageLoaded) {
        if (statusText && statusText.textContent !== 'Synchronizing Website Content...') {
          statusText.textContent = 'Synchronizing Website Content...';
        }
      }
    }

    // Safety timeout: proceed after 4.5s max
    setTimeout(() => {
      if (!flightStarted && !isDismissed) {
        pageLoaded = true;
        videoCompleted = true;
        startFlightPhase();
      }
    }, 4500);

    // =========================================================================
    // SILKY 60/120 FPS FLIGHT TRANSITION
    // =========================================================================
    function startFlightPhase() {
      if (flightStarted || isDismissed) return;
      flightStarted = true;

      // Stop RAF loop to free CPU completely
      if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }

      // 1. Loading Phase cleanly fades out (zero layout changes)
      if (loadingPhase) {
        loadingPhase.style.opacity = '0';
        loadingPhase.style.pointerEvents = 'none';
      }

      // 2. Flight Phase fades in
      if (flightPhase) {
        flightPhase.style.opacity = '1';
      }

      // 3. Airliner starts smooth continuous trajectory
      if (aircraftActor) {
        aircraftActor.classList.add('splash-actor-running');
      }

      // 4. Headline smoothly appears
      if (tagline) {
        setTimeout(() => {
          if (!isDismissed) {
            tagline.classList.add('splash-headline-running');
          }
        }, 300);
      }

      // 5. Complete flight and seamlessly unveil main website
      setTimeout(() => {
        if (!isDismissed) {
          completeSplash();
        }
      }, 1900);
    }

    // =========================================================================
    // SEAMLESS TRANSITION TO MAIN WEBSITE
    // =========================================================================
    function completeSplash() {
      if (isDismissed) return;
      isDismissed = true;

      // Crossfade out entire splash screen to reveal main homepage
      root.style.opacity = '0';
      root.style.pointerEvents = 'none';

      // Restore scroll immediately
      document.body.classList.remove('overflow-hidden');

      setTimeout(() => {
        root.style.display = 'none';
        root.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.add('splash-dismissed');

        try {
          sessionStorage.setItem(SPLASH_KEY, 'true');
        } catch (e) {}
      }, 600);
    }

    // Controls
    if (skipBtn) {
      skipBtn.addEventListener('click', (e) => {
        e.preventDefault();
        completeSplash();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!isDismissed && (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter')) {
        completeSplash();
      }
    });
  })();
</script>
