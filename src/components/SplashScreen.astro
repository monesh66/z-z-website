---
// src/components/SplashScreen.astro
---

<!-- Instant Return-Visit Script (Zero layout shift, zero FOUC) -->
<script is:inline>
  (function () {
    try {
      var isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      var isForced = window.location.search.indexOf('splash=true') !== -1;
      var isSkipped = window.location.search.indexOf('splash=false') !== -1;
      if (isSkipped || (!isLocal && !isForced && sessionStorage.getItem('ziya_zara_splash_shown') === 'true')) {
        document.documentElement.classList.add('splash-dismissed');
      }
    } catch (e) {}
  })();
</script>

<style>
  html.splash-dismissed #splash-screen-root {
    display: none !important;
  }

  /* GPU-Accelerated 3D Perspective Viewport */
  .flight-perspective-container {
    perspective: 1200px;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  /* Waypoint Radar Pulse */
  @keyframes waypointRadar {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .splash-radar-pulse {
    animation: waypointRadar 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }
</style>

<!-- Fullscreen Splash & Loading Screen Root -->
<div
  id="splash-screen-root"
  role="dialog"
  aria-modal="true"
  aria-label="Welcome to ZIYA ZARA Trading Company"
  class="fixed inset-0 z-[100] overflow-hidden bg-white/55 backdrop-blur-[3px] select-none pointer-events-auto transition-opacity duration-700 ease-out"
>
  <!-- Preload flight & hero assets into browser cache -->
  <link rel="preload" as="image" href="/images/hero/hero_full_hd.jpg" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/hero/cinematic_aircraft.png" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/hero/splash_backdrop.jpg" />
  <link rel="preload" as="video" href="/videos/zz_loading_loop.mp4" type="video/mp4" />

  <!-- =========================================================================
       PHASE 1: COMPACT LOGO ANIMATION (UNDER 2s LOOP) OVER VISIBLE LOADING IMAGE
       ========================================================================= -->
  <div
    id="splash-loading-phase"
    class="absolute inset-0 z-50 flex flex-col items-center justify-center px-4 transition-all duration-500 ease-out"
  >
    <!-- Elegant Glassmorphic Floating Card in Small Size -->
    <div
      id="splash-loader-card"
      class="relative flex flex-col items-center bg-white/95 backdrop-blur-md rounded-2xl p-4 sm:p-5 shadow-[0_20px_50px_rgba(11,31,58,0.22)] border border-white/90 max-w-[210px] sm:max-w-[230px] w-full mx-auto text-center will-change-transform transition-all duration-400 ease-out"
    >
      <!-- Sped-up Looping Logo Video in Small Size (Under 2s Loop) -->
      <div class="relative w-full aspect-[16/9] flex items-center justify-center overflow-hidden rounded-xl bg-slate-50 border border-slate-100">
        <video
          id="splash-loading-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          class="w-full h-full object-contain"
        >
          <source src="/videos/zz_loading_loop.webm" type="video/webm" />
          <source src="/videos/zz_loading_loop.mp4" type="video/mp4" />
        </video>
      </div>

      <!-- Live Loading Image Telemetry & Status -->
      <div class="mt-3 flex flex-col items-center w-full">
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#16a34a]"></span>
          </span>
          <span
            id="splash-loading-status"
            class="text-[11px] font-semibold tracking-wider text-navy-950 font-mono uppercase"
          >
            Loading Image...
          </span>
        </div>

        <!-- Mini Progress Track -->
        <div class="w-full h-1 bg-slate-100 rounded-full overflow-hidden border border-slate-200/80 mt-2">
          <div
            id="splash-loading-bar"
            class="h-full bg-gradient-to-r from-[#16a34a] via-emerald-400 to-[#0B1F3A] w-0 transition-all duration-100 ease-out rounded-full"
          ></div>
        </div>

        <!-- Percentage Counter -->
        <div class="flex justify-between w-full text-[9px] text-slate-400 font-mono tracking-widest uppercase mt-1">
          <span>ZIYA ZARA</span>
          <span id="splash-loading-pct" class="text-emerald-600 font-bold">0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       PHASE 2: 3D CINEMATIC REALISTIC FLIGHT ANIMATION
       Continuous Single-Arc Aerodynamic Glide (Zero intermediate keyframe hitches)
       ========================================================================= -->
  <div
    id="splash-flight-phase"
    class="absolute inset-0 z-10 pointer-events-none opacity-0 transition-opacity duration-600 ease-out"
  >
    <!-- Background Panoramic Atmosphere -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero/splash_backdrop.jpg"
        alt=""
        class="w-full h-full object-cover object-[center_35%] opacity-85"
      />

      <!-- Deep Twilight Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#061222]/85 via-[#0B1F3A]/60 to-[#061222]/80"></div>

      <!-- Dawn Glow Core -->
      <div
        class="absolute top-1/4 right-1/4 w-[600px] h-[600px] rounded-full pointer-events-none -translate-y-1/2 translate-x-1/4 blur-3xl opacity-40"
        style="background: radial-gradient(circle, rgba(245, 158, 11, 0.4) 0%, rgba(220, 38, 38, 0.12) 40%, transparent 70%);"
      ></div>
    </div>

    <!-- Global Trade Telemetry HUD (Cleanly separated without any text collision) -->
    <div class="absolute inset-0 z-10 p-6 sm:p-10 flex flex-col justify-between text-white/50 text-[10px] sm:text-xs font-mono tracking-widest uppercase">
      <!-- Top HUD Row -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#2E8B2E]"></span>
          </span>
          <span class="text-emerald-400 font-semibold tracking-[0.2em]">ZZ-CORRIDOR // INT'L FREIGHT NETWORK</span>
        </div>

        <!-- Right side empty to prevent collision with Skip button -->
        <div class="w-36 sm:w-44"></div>
      </div>

      <!-- Bottom HUD Row -->
      <div class="flex items-end justify-between">
        <!-- Tagline: "GLOBAL REACH" in dedicated bottom-left position -->
        <div
          id="splash-tagline-container"
          class="max-w-xl pointer-events-none opacity-0 transition-all duration-700 ease-out"
        >
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-[#2E8B2E] shadow-[0_0_8px_#2E8B2E]"></span>
              <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] text-emerald-400 uppercase font-mono">
                INTERNATIONAL TRADE & LOGISTICS
              </span>
            </div>

            <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-editorial-serif tracking-tight leading-none text-white drop-shadow-md">
              <span>Global</span>
              <span class="bg-gradient-to-r from-[#2E8B2E] via-[#34D399] to-[#6EE7B7] bg-clip-text text-transparent ml-2">Reach</span>
            </h2>

            <p class="text-xs sm:text-sm text-slate-200/90 font-sans tracking-wide">
              Connecting Markets &bull; Reliable Sourcing Worldwide
            </p>
          </div>
        </div>

        <!-- Telemetry Info in bottom-right -->
        <div class="hidden sm:block text-right space-y-1">
          <div class="text-[9px] text-white/40 tracking-[0.2em]">MULTIMODAL PRECISION LOGISTICS</div>
          <div class="text-emerald-400/80 font-sans text-xs">AIR FREIGHT &bull; OCEAN CONTAINER &bull; INTERMODAL</div>
          <div class="text-[10px] text-white/50 tracking-widest pt-1">
            DESTINATION: <span class="text-emerald-300 font-bold">GLOBAL TRADE HUB</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Geodesic Flight Route Vector (SVG) -->
    <svg
      id="splash-route-svg"
      class="absolute inset-0 w-full h-full z-15 pointer-events-none"
      viewBox="0 0 1440 900"
      preserveAspectRatio="none"
      fill="none"
    >
      <defs>
        <linearGradient id="corridorGradSmooth" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#2E8B2E" stop-opacity="0.3" />
          <stop offset="40%" stop-color="#34D399" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#A7F3D0" stop-opacity="1" />
        </linearGradient>
      </defs>

      <!-- Main Flight Path -->
      <path
        id="splash-corridor-path-element"
        d="M 100,740 C 300,700 460,540 700,440 C 920,350 1120,260 1340,190"
        stroke="url(#corridorGradSmooth)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray="1600"
        stroke-dashoffset="1600"
      />

      <!-- Parallel Echo Corridor -->
      <path
        id="splash-corridor-echo-element"
        d="M 130,760 C 330,720 490,560 730,460 C 950,370 1150,280 1370,210"
        stroke="#2E8B2E"
        stroke-width="1.2"
        stroke-dasharray="6 10"
        stroke-opacity="0.45"
        stroke-dashoffset="1600"
      />

      <!-- Waypoint 1: Origin -->
      <g transform="translate(160, 725)">
        <circle cx="0" cy="0" r="14" fill="#2E8B2E" fill-opacity="0.25" class="splash-radar-pulse" />
        <circle cx="0" cy="0" r="5" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2" fill="#FFFFFF" />
        <text x="12" y="4" fill="#34D399" font-family="monospace" font-size="10" font-weight="600" letter-spacing="1.5">PACIFIC SOURCING</text>
      </g>

      <!-- Waypoint 2: Hub -->
      <g transform="translate(620, 480)">
        <circle cx="0" cy="0" r="14" fill="#2E8B2E" fill-opacity="0.25" class="splash-radar-pulse" style="animation-delay: 0.4s;" />
        <circle cx="0" cy="0" r="5" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2" fill="#FFFFFF" />
        <text x="12" y="4" fill="#34D399" font-family="monospace" font-size="10" font-weight="600" letter-spacing="1.5">MIDDLE EAST HUB</text>
      </g>

      <!-- Waypoint 3: Destination -->
      <g transform="translate(1260, 215)">
        <circle cx="0" cy="0" r="18" fill="#34D399" fill-opacity="0.3" class="splash-radar-pulse" style="animation-delay: 0.8s;" />
        <circle cx="0" cy="0" r="7" fill="#2E8B2E" />
        <circle cx="0" cy="0" r="2.5" fill="#FFFFFF" />
        <text x="-140" y="-12" fill="#FFFFFF" font-family="monospace" font-size="10" font-weight="700" letter-spacing="1.5">GLOBAL DESTINATION</text>
      </g>
    </svg>

    <!-- =======================================================================
         THE CONTINUOUS SINGLE-ARC AIRLINER (Zero Intermediate Keyframe Hitches)
         Outer Track: Glides smoothly from -55vw to +65vw in ONE uninterrupted curve
         Inner Actor: Handles smooth entry and exit opacity
         ======================================================================= -->
    <div class="absolute inset-0 z-25 flight-perspective-container flex items-center justify-center pointer-events-none">
      <!-- Outer Track: 100% GPU pure transform interpolation -->
      <div
        id="splash-aircraft-track"
        class="relative flex items-center justify-center will-change-transform"
        style="transform: translate3d(-60vw, 38vh, 0) scale(0.28) rotateZ(-4deg);"
      >
        <!-- Inner Actor: Image with gradient contrails -->
        <div
          id="splash-aircraft-actor"
          class="relative w-[340px] sm:w-[560px] md:w-[740px] lg:w-[860px] aspect-[1254/503] opacity-0 will-change-transform"
        >
          <!-- Contrails: Simple static gradients attached to the engines that move with the plane -->
          <div
            class="absolute top-[48%] -left-44 sm:-left-64 w-44 sm:w-64 h-2 sm:h-2.5 rounded-full pointer-events-none"
            style="background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.4) 60%, rgba(52, 211, 153, 0.6) 100%);"
          ></div>
          <div
            class="absolute top-[62%] -left-36 sm:-left-56 w-36 sm:w-56 h-1.5 sm:h-2 rounded-full pointer-events-none"
            style="background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 60%, rgba(52, 211, 153, 0.5) 100%);"
          ></div>

          <!-- Realistic Airliner Image -->
          <img
            src="/images/hero/cinematic_aircraft.png"
            alt="Cargo airliner in flight"
            width="1254"
            height="503"
            class="w-full h-full object-contain pointer-events-none select-none"
            style="transform: translateZ(0); backface-visibility: hidden;"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Accessible Skip Button (Cleanly positioned with ample margin) -->
  <button
    id="splash-skip-btn"
    type="button"
    aria-label="Skip introduction animation"
    class="absolute top-5 right-5 sm:top-7 sm:right-8 z-[70] flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/60 hover:bg-slate-900/80 active:bg-black border border-white/25 backdrop-blur-md text-white text-xs font-medium tracking-wider uppercase transition-all duration-200 cursor-pointer shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#2E8B2E]"
  >
    <span>Skip Intro</span>
    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
    </svg>
  </button>
</div>

<!-- High-Performance Orchestration Script -->
<script>
  (function () {
    const SPLASH_KEY = 'ziya_zara_splash_shown';
    const root = document.getElementById('splash-screen-root');
    const loadingPhase = document.getElementById('splash-loading-phase');
    const flightPhase = document.getElementById('splash-flight-phase');
    const video = document.getElementById('splash-loading-video') as HTMLVideoElement | null;
    const statusText = document.getElementById('splash-loading-status');
    const progressBar = document.getElementById('splash-loading-bar');
    const pctText = document.getElementById('splash-loading-pct');
    const skipBtn = document.getElementById('splash-skip-btn');
    const aircraftTrack = document.getElementById('splash-aircraft-track');
    const aircraftActor = document.getElementById('splash-aircraft-actor');
    const corridorPath = document.getElementById('splash-corridor-path-element');
    const corridorEcho = document.getElementById('splash-corridor-echo-element');
    const tagline = document.getElementById('splash-tagline-container');

    if (!root) return;

    const urlParams = new URLSearchParams(window.location.search);
    const forceSplash = urlParams.get('splash') === 'true';
    const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

    let hasSeenSplash = false;
    try {
      hasSeenSplash = !isLocal && !forceSplash && sessionStorage.getItem(SPLASH_KEY) === 'true';
    } catch (e) {}

    const prefersReducedMotion = !forceSplash && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hasSeenSplash || prefersReducedMotion) {
      root.style.display = 'none';
      root.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.add('splash-dismissed');
      return;
    }

    document.body.classList.add('overflow-hidden');

    let isDismissed = false;
    let flightStarted = false;
    let imagesFullyLoaded = false;
    let minTimeElapsed = false;
    let animFrameId: number | null = null;

    const startTime = performance.now();
    const MIN_ANIM_DURATION = 1800; // Complete at least one 1.8s loop of the animation

    // Primary target: Hero HD image & critical page assets
    const heroImg = document.querySelector('#hero img') as HTMLImageElement | null;
    const criticalImages = Array.from(document.querySelectorAll('#hero img, header img, #site-header img')) as HTMLImageElement[];

    function checkAllImagesLoaded() {
      if (imagesFullyLoaded) return;

      let allDone = true;
      if (heroImg) {
        if (!heroImg.complete || heroImg.naturalWidth === 0) {
          allDone = false;
        }
      }

      for (let i = 0; i < criticalImages.length; i++) {
        const img = criticalImages[i];
        if (!img.complete || img.naturalWidth === 0) {
          allDone = false;
          break;
        }
      }

      if (allDone) {
        if (heroImg && heroImg.decode) {
          heroImg.decode().then(() => {
            onImagesComplete();
          }).catch(() => {
            onImagesComplete();
          });
        } else {
          onImagesComplete();
        }
      }
    }

    function onImagesComplete() {
      if (imagesFullyLoaded) return;
      imagesFullyLoaded = true;

      if (progressBar) progressBar.style.width = '100%';
      if (pctText) pctText.textContent = '100%';
      if (statusText) statusText.textContent = 'Image Ready';

      if (minTimeElapsed) {
        triggerProceed();
      }
    }

    // Attach listeners to detect when images finish loading
    if (heroImg) {
      if (heroImg.complete && heroImg.naturalWidth > 0) {
        checkAllImagesLoaded();
      } else {
        heroImg.addEventListener('load', checkAllImagesLoaded, { once: true });
        heroImg.addEventListener('error', onImagesComplete, { once: true });
      }
    }

    criticalImages.forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', checkAllImagesLoaded, { once: true });
        img.addEventListener('error', checkAllImagesLoaded, { once: true });
      }
    });

    window.addEventListener('load', () => {
      checkAllImagesLoaded();
    });

    // Ensure video is playing and looping continuously under 2s
    if (video) {
      video.loop = true;
      video.playbackRate = 1.0;
      video.play().catch(() => {});
    }

    // Smooth Progress Loop
    function updateProgress() {
      if (flightStarted || isDismissed) return;

      const elapsed = performance.now() - startTime;

      if (!imagesFullyLoaded) {
        // Smoothly advance progress up to 92% while waiting for network
        const progress = Math.min(elapsed / (MIN_ANIM_DURATION * 1.5), 0.92);
        const pct = Math.floor(progress * 100);

        if (progressBar) progressBar.style.width = pct + '%';
        if (pctText) pctText.textContent = pct + '%';

        if (statusText) {
          if (pct < 85) {
            statusText.textContent = 'Loading Image...';
          } else {
            statusText.textContent = 'Finalizing Image...';
          }
        }
      }

      if (!flightStarted) {
        animFrameId = requestAnimationFrame(updateProgress);
      }
    }
    animFrameId = requestAnimationFrame(updateProgress);

    // Minimum display timer (plays at least one full 1.8s loop)
    setTimeout(() => {
      minTimeElapsed = true;
      if (imagesFullyLoaded) {
        triggerProceed();
      }
    }, MIN_ANIM_DURATION);

    // Safety timeout: proceed after 5.0s max even on slowest connections
    setTimeout(() => {
      if (!flightStarted && !isDismissed) {
        onImagesComplete();
        triggerProceed();
      }
    }, 5000);

    function triggerProceed() {
      if (flightStarted || isDismissed) return;

      // Dissolve the floating small card
      const loaderCard = document.getElementById('splash-loader-card');
      if (loaderCard) {
        loaderCard.style.opacity = '0';
        loaderCard.style.transform = 'scale(0.9)';
      }

      setTimeout(() => {
        startFlightPhase();
      }, 300);
    }

    // =========================================================================
    // SILKY-SMOOTH CONTINUOUS FLIGHT TRANSITION (WEB ANIMATIONS API)
    // Single Unbroken Motion Spline — ZERO intermediate stops or deceleration hitches
    // =========================================================================
    function startFlightPhase() {
      if (flightStarted || isDismissed) return;
      flightStarted = true;

      // Stop RAF loop to free CPU completely
      if (animFrameId) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }

      // 1. Loading Phase dissolves cleanly
      if (loadingPhase) {
        loadingPhase.style.opacity = '0';
        loadingPhase.style.pointerEvents = 'none';
      }

      // 2. Flight Phase reveals
      if (flightPhase) {
        flightPhase.style.opacity = '1';
      }

      const FLIGHT_DURATION = 2600; // 2.6 seconds continuous cinematic flight

      // 3. Single-Arc Continuous Flight (Outer Track: Start -> End in ONE unbroken curve!)
      if (aircraftTrack) {
        aircraftTrack.animate([
          {
            transform: 'translate3d(-58vw, 38vh, 0) scale(0.28) rotateZ(-5deg)'
          },
          {
            transform: 'translate3d(62vw, -40vh, 0) scale(1.42) rotateZ(4deg)'
          }
        ], {
          duration: FLIGHT_DURATION,
          easing: 'cubic-bezier(0.2, 0.0, 0.2, 1)', // Continuous aerodynamic momentum
          fill: 'forwards'
        });
      }

      // 4. Smooth Fade-in and Fade-out on the Inner Aircraft Element
      if (aircraftActor) {
        aircraftActor.animate([
          { opacity: 0 },
          { opacity: 1, offset: 0.12 },
          { opacity: 1, offset: 0.85 },
          { opacity: 0, offset: 1.0 }
        ], {
          duration: FLIGHT_DURATION,
          easing: 'linear',
          fill: 'forwards'
        });
      }

      // 5. Flight Corridor SVG Path Stroke
      if (corridorPath) {
        corridorPath.animate([
          { strokeDashoffset: '1600' },
          { strokeDashoffset: '0' }
        ], {
          duration: 1600,
          delay: 150,
          easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)',
          fill: 'forwards'
        });
      }

      if (corridorEcho) {
        corridorEcho.animate([
          { strokeDashoffset: '1600' },
          { strokeDashoffset: '0' }
        ], {
          duration: 1600,
          delay: 250,
          easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)',
          fill: 'forwards'
        });
      }

      // 6. Reveal Tagline
      if (tagline) {
        setTimeout(() => {
          if (!isDismissed) {
            tagline.style.opacity = '1';
          }
        }, 350);
      }

      // 7. Transition smoothly into the main website as the aircraft completes its pass
      setTimeout(() => {
        if (!isDismissed) {
          completeSplash();
        }
      }, 2100);
    }

    // =========================================================================
    // SEAMLESS TRANSITION TO MAIN WEBSITE
    // =========================================================================
    function completeSplash() {
      if (isDismissed) return;
      isDismissed = true;

      // Crossfade out entire splash screen to reveal main homepage
      root.style.opacity = '0';
      root.style.pointerEvents = 'none';

      // Restore scroll immediately
      document.body.classList.remove('overflow-hidden');

      // Notify page components to begin smooth scroll reveals
      window.dispatchEvent(new CustomEvent('splashDismissed'));

      setTimeout(() => {
        root.style.display = 'none';
        root.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.add('splash-dismissed');

        try {
          sessionStorage.setItem(SPLASH_KEY, 'true');
        } catch (e) {}
      }, 700);
    }

    // Controls
    if (skipBtn) {
      skipBtn.addEventListener('click', (e) => {
        e.preventDefault();
        completeSplash();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!isDismissed && (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter')) {
        completeSplash();
      }
    });
  })();
</script>
