---
const testimonials = [
  {
    name: "Ramesh K.",
    role: "Import Manager, India",
    avatar: "/images/testimonials/mockup-avatar-rahul.jpg",
    quote: "Ziya Zara has been a reliable partner for our sourcing needs. Their professionalism and timely delivery have been impressive.",
    rating: 5,
  },
  {
    name: "Fatima Al Nasser",
    role: "Procurement Head, UAE",
    avatar: "/images/testimonials/mockup-avatar-sarah.jpg",
    quote: "Excellent quality products and smooth communication. We highly recommend Ziya Zara for international trade.",
    rating: 5,
  },
  {
    name: "Michael Thompson",
    role: "Supply Chain Director, UK",
    avatar: "/images/testimonials/mockup-avatar-ahmed.jpg",
    quote: "A trusted partner with deep market knowledge and a customer-centric approach. Great experience working with their team.",
    rating: 5,
  },
];
---

<section id="testimonials" class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="scroll-reveal flex items-end justify-between mb-12 gap-4">
      <div class="space-y-1.5">
        <div class="text-xs font-bold uppercase tracking-widest text-emerald-600 font-mono">
          TESTIMONIALS
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-navy-950 tracking-tight">
          Trusted by Our Partners
        </h2>
      </div>

      <!-- Left / Right Carousel Indicator Buttons -->
      <div class="hidden sm:flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 rounded-full border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-50 hover:border-slate-300 transition-colors"
          aria-label="Previous Testimonials"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          class="w-10 h-10 rounded-full border border-slate-200 text-slate-600 flex items-center justify-center hover:bg-slate-50 hover:border-slate-300 transition-colors"
          aria-label="Next Testimonials"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 3 Testimonial Cards -->
    <div data-reveal-group data-reveal-stagger="90" class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.map((item) => (
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Large Quote Symbol & Text -->
            <p class="text-slate-700 text-sm leading-relaxed mb-4 font-normal">
              <span class="font-bold text-navy-950 text-base">“</span> {item.quote}
            </p>

            <!-- 5 Gold Stars -->
            <div class="text-amber-400 text-sm tracking-wider mb-6">
              {"★".repeat(item.rating)}
            </div>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-slate-100 flex items-center gap-3.5">
            <img
              src={item.avatar}
              alt={item.name}
              width="44"
              height="44"
              class="w-11 h-11 rounded-full object-cover border border-slate-200"
              loading="lazy"
            />
            <div>
              <h4 class="font-bold text-navy-950 text-sm leading-snug">
                {item.name}
              </h4>
              <p class="text-xs text-slate-500 font-normal">
                {item.role}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
