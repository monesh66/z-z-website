---
import { siteConfig } from '../data/site';
---

<section id="testimonials" class="py-16 lg:py-20 bg-white border-b border-slate-100 overflow-hidden">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Row -->
    <div class="flex items-end justify-between mb-8 sm:mb-10">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#2E8B2E]">Testimonials</span>
          <span class="w-7 h-[2px] bg-[#2E8B2E]"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold font-editorial-serif text-[#0B1F3A] tracking-tight">
          Trusted by Our Partners
        </h2>
      </div>

      <!-- Carousel Navigation Arrows matching reference -->
      <div class="hidden sm:flex items-center gap-2">
        <button
          type="button"
          class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-[#0B1F3A] hover:text-[#0B1F3A] transition-colors shadow-2xs"
          aria-label="Previous Testimonial"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-[#0B1F3A] hover:text-[#0B1F3A] transition-colors shadow-2xs"
          aria-label="Next Testimonial"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- 3 Testimonial Cards Grid matching reference -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {siteConfig.testimonials.map((item) => (
        <div class="bg-white rounded-[10px] p-5 sm:p-6 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between space-y-4">
          
          <div class="space-y-3">
            <!-- Quote Icon -->
            <div class="text-[#0B1F3A] text-2xl font-serif leading-none">
              &ldquo;
            </div>

            <!-- Quote Text -->
            <p class="text-[13px] text-[#5B6573] leading-relaxed font-normal">
              {item.quote}
            </p>

            <!-- 5 Star Rating in Gold -->
            <div class="flex items-center gap-1 text-[#F5B301]">
              {Array.from({ length: item.rating }).map(() => (
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>

          <!-- Author Info -->
          <div class="pt-3 flex items-center gap-3 border-t border-slate-100">
            <div class="w-10 h-10 rounded-full overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
              <img
                src={item.avatar}
                alt={item.name}
                width="40"
                height="40"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div>
              <div class="text-xs font-bold text-[#0B1F3A]">
                {item.name}
              </div>
              <div class="text-[11px] text-[#5B6573]">
                {item.role}, {item.location}
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
