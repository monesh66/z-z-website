---
import { siteConfig } from '../data/site';
---

<section id="testimonials" class="py-16 lg:py-20 bg-white border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Row -->
    <div class="flex items-end justify-between mb-10">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-800">Testimonials</span>
          <span class="w-8 h-[2px] bg-[#138848]"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold font-editorial-serif text-[#0B1F36] tracking-tight">
          Trusted by Our Partners
        </h2>
      </div>

      <!-- Carousel Navigation Arrows -->
      <div class="hidden sm:flex items-center gap-2">
        <button
          type="button"
          class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-slate-400 hover:text-slate-900 transition-colors"
          aria-label="Previous Testimonial"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:border-slate-400 hover:text-slate-900 transition-colors"
          aria-label="Next Testimonial"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- 3 Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {siteConfig.testimonials.map((item) => (
        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-xs flex flex-col justify-between space-y-5 hover:shadow-md transition-shadow">
          
          <div class="space-y-4">
            <!-- Quote Icon -->
            <div class="text-[#0B1F36] text-3xl font-serif leading-none">
              &ldquo;
            </div>

            <!-- Quote Text -->
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal">
              {item.quote}
            </p>

            <!-- 5 Star Rating -->
            <div class="flex items-center gap-1 text-amber-400">
              {Array.from({ length: item.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
              <img
                src={item.avatar}
                alt={item.name}
                width="40"
                height="40"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div>
              <div class="text-xs sm:text-sm font-bold text-[#0B1F36]">
                {item.name}
              </div>
              <div class="text-[11px] text-slate-500">
                {item.role}, {item.location}
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
