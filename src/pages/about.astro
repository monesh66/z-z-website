---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`About Us | ${siteConfig.legalName}`}
  description="Learn about ZIYA ZARA TRADING COMPANY, our global trade ethos, international sourcing network, and commitment to operational discipline."
>
  <!-- Page Header Banner -->
  <section class="bg-navy-950 text-white py-20 lg:py-24 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#FFFFFF_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-400">
          <span class="w-8 h-0.5 bg-emerald-500"></span>
          <span>Corporate Overview</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display tracking-tight text-white leading-tight">
          Global Trade <br />
          <span class="text-emerald-400 font-editorial-serif italic font-normal">Beyond Borders.</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed pt-2">
          {siteConfig.legalName} is an international trading and global sourcing enterprise dedicated to connecting high-standard producer clusters with demanding worldwide markets.
        </p>
      </div>
    </div>
  </section>

  <!-- Narrative Section with Photography -->
  <section class="py-20 lg:py-24 bg-white border-b border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
            <span>Our Origin & Purpose</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold font-display text-navy-950 tracking-tight">
            Bridging Market Demand with Certified Origins
          </h2>
          <div class="space-y-4 text-slate-600 text-base leading-relaxed">
            <p>
              In today's interconnected global economy, successful international trade requires more than just identifying products—it demands rigorous quality compliance, dependable logistics synchronization, and unwavering commercial integrity.
            </p>
            <p>
              Established with an international outlook, <strong>{siteConfig.legalName}</strong> coordinates cross-border transactions across diverse commodity and manufacturing categories. We bridge the gap between primary producers, processors, and end buyers, ensuring that every shipment meets agreed chemical, physical, and commercial specifications.
            </p>
            <p>
              Whether handling bulk agricultural commodities, certified food grains, specialized textiles, or industrial engineering components, our objective remains constant: to make global sourcing predictable, transparent, and mutually profitable.
            </p>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200">
            <img
              src="/images/about/global_network.jpg"
              alt="Global trade operations"
              width="800"
              height="600"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-navy-950/90 to-transparent p-6 text-white">
              <div class="text-xs font-mono uppercase text-champagne font-bold">Trade Excellence Standard</div>
              <div class="text-sm font-semibold mt-1">Connecting Indian & International Manufacturing Corridors to the World</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Business Principles -->
  <section class="py-20 bg-slate-50 border-b border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <h2 class="text-3xl sm:text-4xl font-bold font-display text-navy-950">
          Our Operational Commitments
        </h2>
        <p class="text-base text-slate-600">
          Four foundational pillars that govern our commercial conduct, risk management, and partner interactions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {siteConfig.principles.map((principle) => (
          <div class="bg-white p-7 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center mb-5">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold font-display text-navy-950 mb-2">
              {principle.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">
              {principle.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-16 bg-navy-950 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h2 class="text-3xl font-display font-bold">Ready to Discuss a Commercial Requirement?</h2>
      <p class="text-slate-300 text-sm max-w-xl mx-auto">
        Speak directly with our trade officers to evaluate specification parameters, origin options, and delivery timelines.
      </p>
      <div>
        <a href="/contact" class="trade-btn-primary">
          <span>Contact Our Trade Desk</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
