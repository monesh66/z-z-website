---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import SourcingProcess from '../components/SourcingProcess.astro';
import ProductGrid from '../components/ProductGrid.astro';
import GlobalReach from '../components/GlobalReach.astro';
import Logistics from '../components/Logistics.astro';
import Testimonials from '../components/Testimonials.astro';
import Founders from '../components/Founders.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout
  title="ZIYA ZARA TRADING COMPANY | International Trade, Import/Export & Global Sourcing"
  description="ZIYA ZARA TRADING COMPANY connects global markets with premium agricultural commodities, textiles, industrial supplies, and multi-modal logistics with integrity and precision."
>
  <!-- Cinematic Loading Animation & 3D Flight Transition -->
  <SplashScreen />

  <!-- Signature Hero Experience (Bridging Markets Worldwide) -->
  <Hero />

  <!-- Company Introduction (Global Trade Partner You Can Trust) -->
  <AboutSection />

  <!-- Sourcing Storytelling (From Demand to Delivery) -->
  <SourcingProcess />

  <!-- Products Discovery (Diverse Products for Global Markets) -->
  <ProductGrid />

  <!-- Global Reach Map (Importing & Exporting Across Continents) -->
  <GlobalReach />

  <!-- Multi-Mode Logistics Capabilities (By Air, Sea and Road) -->
  <Logistics />

  <!-- Testimonials Section (Trusted by Our Partners) -->
  <Testimonials />

  <!-- 2 Founders Section (Built on Trust. Driven by Opportunity.) -->
  <Founders />

  <!-- Contact Experience (Let's Create Global Opportunities) -->
  <ContactSection />
</BaseLayout>
