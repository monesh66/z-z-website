---
import BaseLayout from '../layouts/BaseLayout.astro';
import { productCategories } from '../data/products';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Export Product Catalog & Multi-Commodity Portfolio | ${siteConfig.legalName}`}
  description="Explore the comprehensive export portfolio of ZIYA ZARA TRADING COMPANY: Indian spices, 1121 Basmati rice, millets, pulses, coconut derivatives, ready-to-eat retort meals, food machinery, textiles, and industrial supplies."
>
  <!-- Products Header Banner -->
  <section class="bg-[#0B1F3A] text-white py-16 lg:py-24 border-b border-navy-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none bg-[radial-gradient(#FFFFFF_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-400">
          <span class="w-8 h-0.5 bg-emerald-500"></span>
          <span>Verified Merchant Exporter & Global Sourcing</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-editorial-serif tracking-tight text-white leading-tight">
          Diverse Products for <br />
          <span class="text-emerald-400 font-editorial-serif italic font-normal">Global Commercial Demand.</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed pt-1">
          Supplying international food importers, hypermarket chains, agro-distributors, and industrial contractors across 50+ countries. Sourced directly from certified farmer cooperatives, modern processing mills, and audited manufacturers with strict contract specification compliance.
        </p>

        <!-- Quick Capability Badges -->
        <div class="pt-4 flex flex-wrap gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/15">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            9 Trade Sectors
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/15">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            70+ Export Varieties
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/15">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            APEDA & Spices Board
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/15">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            FCL & LCL Consolidated
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 border border-white/15">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Private Label Available
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Sourcing Flexibility & Multi-Commodity Callout -->
  <section class="bg-gradient-to-r from-emerald-900 to-navy-950 text-white py-6 border-b border-emerald-800/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-start sm:items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center flex-shrink-0 text-emerald-300">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <h2 class="text-sm font-bold text-white tracking-wide">
              Custom Commodity Sourcing & Private Label Packaging on Demand
            </h2>
            <p class="text-xs text-emerald-100/80">
              Need a specific crop grade, custom spice mesh size, private-label retail pouch, or industrial fitting not listed below? We procure directly to your custom contract parameters.
            </p>
          </div>
        </div>
        <button
          type="button"
          data-open-quote-modal
          data-product-name="Custom Multi-Commodity Sourcing Inquiry"
          class="flex-shrink-0 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-navy-950 font-bold text-xs rounded-md transition-all shadow-md hover:shadow-lg flex items-center gap-2"
        >
          <span>Request Custom Sourcing</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Controls: Live Search & Category Filter Bar -->
  <section class="sticky top-[72px] z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        
        <!-- Live Instant Search -->
        <div class="relative w-full lg:w-96 flex-shrink-0">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="product-search-input"
            placeholder="Search commodities, varieties (e.g. 1121 Basmati, Turmeric, Foxtail, Retort, Charcoal...), HS code..."
            class="w-full pl-9 pr-8 py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 focus:bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#2E8B2E] focus:ring-1 focus:ring-[#2E8B2E] transition-all"
          />
          <button
            id="product-search-clear"
            type="button"
            class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600"
            title="Clear search"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Category Filter Pills (Scrollable on small screens) -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0 scrollbar-none" id="category-filter-bar">
          <button
            type="button"
            data-filter="all"
            class="category-pill active flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-semibold transition-all bg-[#0B1F3A] text-white shadow-xs"
          >
            All Sectors ({productCategories.length})
          </button>
          {productCategories.map((cat) => (
            <button
              type="button"
              data-filter={cat.slug}
              class="category-pill flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-all bg-slate-100 text-slate-700 hover:bg-slate-200"
            >
              {cat.title.split('&')[0].trim()}
            </button>
          ))}
        </div>

      </div>

      <!-- Live Search Results Counter -->
      <div id="search-status-bar" class="hidden mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 flex items-center justify-between">
        <span id="search-matches-count">Showing matching items</span>
        <button id="search-reset-btn" class="text-emerald-700 hover:underline font-semibold">Reset search</button>
      </div>
    </div>
  </section>

  <!-- Empty State for Zero Search Results -->
  <div id="no-results-banner" class="hidden max-w-2xl mx-auto px-4 py-16 text-center">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-lg font-bold text-slate-800">No Traded Items Matched Your Query</h3>
    <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
      We frequently trade additional commodities, varieties, and non-standard contract grades that may not be cataloged here.
    </p>
    <div class="mt-5 flex justify-center gap-3">
      <button
        type="button"
        id="clear-filter-btn"
        class="px-4 py-2 text-xs font-semibold rounded-md bg-slate-200 text-slate-700 hover:bg-slate-300"
      >
        View All Categories
      </button>
      <button
        type="button"
        data-open-quote-modal
        data-product-name="Special Commodity Sourcing Request"
        class="px-4 py-2 text-xs font-semibold rounded-md bg-[#2E8B2E] text-white hover:bg-[#257325]"
      >
        Submit Custom Sourcing Request
      </button>
    </div>
  </div>

  <!-- Detailed Categories List -->
  <section class="py-12 lg:py-20 bg-slate-50/70" id="product-catalog-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {productCategories.map((category, index) => {
        const isReversed = index % 2 === 1;
        return (
          <article
            id={category.slug}
            data-category-slug={category.slug}
            data-search-text={`${category.title} ${category.shortDescription} ${category.longDescription} ${category.hsCode} ${category.origin} ${category.items.join(' ')} ${category.keySpecs.join(' ')}`.toLowerCase()}
            class="product-category-card bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden"
          >
            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
              
              <!-- Image Column with Badges -->
              <div class={`lg:col-span-5 relative min-h-[300px] lg:min-h-full overflow-hidden bg-slate-900 ${isReversed ? 'lg:order-2' : ''}`}>
                <img
                  src={category.image}
                  alt={category.title}
                  width="800"
                  height="600"
                  class="w-full h-full object-cover min-h-[300px] lg:min-h-full transition-transform duration-700 ease-out hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/30 to-transparent pointer-events-none"></div>
                
                <!-- Floating Category Number & Regulatory Tag -->
                <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2 pointer-events-none">
                  <span class="bg-[#0B1F3A]/90 backdrop-blur-md px-3 py-1 rounded-md border border-white/20 text-white text-[11px] font-mono uppercase tracking-wider font-semibold">
                    Sector 0{index + 1}
                  </span>
                  <span class="bg-emerald-600/90 backdrop-blur-md px-3 py-1 rounded-md border border-emerald-400/30 text-white text-[11px] font-semibold tracking-wide shadow-sm">
                    {category.badge}
                  </span>
                </div>

                <!-- Bottom Image Overlay: Quick Origin & HS Code -->
                <div class="absolute bottom-4 left-4 right-4 text-white text-xs space-y-1 pointer-events-none">
                  <div class="flex items-center gap-1.5 text-emerald-300 text-[11px] font-semibold">
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                    <span>Origin: {category.origin}</span>
                  </div>
                  <div class="text-[11px] text-slate-300 font-mono">
                    Classification: {category.hsCode}
                  </div>
                </div>
              </div>

              <!-- Content Column -->
              <div class={`lg:col-span-7 p-6 sm:p-8 lg:p-9 flex flex-col justify-between space-y-6 ${isReversed ? 'lg:order-1' : ''}`}>
                
                <div class="space-y-4">
                  
                  <!-- Title and Badges -->
                  <div>
                    <div class="text-xs font-semibold text-[#2E8B2E] tracking-wider uppercase mb-1">
                      {category.shortDescription}
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold font-editorial-serif text-[#0B1F3A] leading-tight">
                      {category.title}
                    </h2>
                  </div>
                  
                  <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                    {category.longDescription}
                  </p>

                  <!-- Traded Varieties & Product Items (Interactive Badges) -->
                  <div class="pt-3 border-t border-slate-100 space-y-2.5">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-mono uppercase tracking-wider text-slate-500 font-bold">
                        Traded Varieties & Line Items:
                      </span>
                      <span class="text-[10px] text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded">
                        Click any item to inquire
                      </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {category.items.map((item) => (
                        <button
                          type="button"
                          data-open-quote-modal
                          data-product-name={`${item} (${category.title})`}
                          class="variety-item-btn flex items-center justify-between gap-2 p-2 rounded-lg bg-slate-50 hover:bg-emerald-50/80 border border-slate-200/80 hover:border-emerald-300 text-left transition-all group cursor-pointer"
                          title={`Click to get a trade quote for ${item}`}
                        >
                          <div class="flex items-center gap-2 min-w-0">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 flex-shrink-0 group-hover:scale-125 transition-transform"></span>
                            <span class="text-xs text-slate-800 font-medium group-hover:text-emerald-950 truncate">{item}</span>
                          </div>
                          <span class="opacity-0 group-hover:opacity-100 text-[10px] font-bold text-emerald-700 flex items-center gap-0.5 flex-shrink-0 transition-opacity">
                            Quote
                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                            </svg>
                          </span>
                        </button>
                      ))}

                      <!-- Dedicated Custom Item / Variety Placeholder Card -->
                      <button
                        type="button"
                        data-open-quote-modal
                        data-product-name={`Custom Variety / Grade Request for ${category.title}`}
                        class="flex items-center justify-between gap-2 p-2 rounded-lg bg-emerald-50/50 hover:bg-emerald-100/70 border border-dashed border-emerald-300 text-left transition-all group cursor-pointer"
                        title="Request custom variety or grade in this category"
                      >
                        <div class="flex items-center gap-2 min-w-0">
                          <span class="w-4 h-4 rounded bg-emerald-600 text-white flex items-center justify-center text-[11px] font-bold flex-shrink-0">
                            +
                          </span>
                          <span class="text-xs text-emerald-900 font-bold truncate">Custom Variety / Private Label</span>
                        </div>
                        <span class="text-[10px] font-bold text-emerald-700 flex-shrink-0">
                          Request
                        </span>
                      </button>
                    </div>
                  </div>

                  <!-- Two-Column Specifications & Packaging -->
                  <div class="pt-3 border-t border-slate-100 grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                    
                    <!-- Specifications & Assays Box -->
                    <div class="bg-slate-50/90 rounded-xl p-3 space-y-1.5 border border-slate-200/70">
                      <div class="text-[11px] font-mono uppercase tracking-wider text-[#0B1F3A] font-bold flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Quality Assays & Specs:</span>
                      </div>
                      <ul class="space-y-1 text-[11px] text-slate-600">
                        {category.keySpecs.map((spec) => (
                          <li class="flex items-start gap-1.5">
                            <span class="text-emerald-600 mt-0.5">•</span>
                            <span>{spec}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Packaging & Containerization Box -->
                    <div class="bg-slate-50/90 rounded-xl p-3 space-y-1.5 border border-slate-200/70">
                      <div class="text-[11px] font-mono uppercase tracking-wider text-[#0B1F3A] font-bold flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                        <span>Packaging Standards:</span>
                      </div>
                      <ul class="space-y-1 text-[11px] text-slate-600">
                        {category.packaging.map((pack) => (
                          <li class="flex items-start gap-1.5">
                            <span class="text-emerald-600 mt-0.5">•</span>
                            <span>{pack}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                  </div>

                </div>

                <!-- Action Button Row -->
                <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100">
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      data-open-quote-modal
                      data-product-name={category.title}
                      class="px-5 py-2.5 rounded-[6px] text-xs font-semibold text-white bg-[#2E8B2E] hover:bg-[#257325] transition-all duration-200 shadow-sm hover:shadow-md flex items-center gap-2"
                    >
                      <span>Inquire for {category.title.split('&')[0].trim()}</span>
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </button>
                    
                    <a
                      href={`/contact?interest=${encodeURIComponent(category.title)}`}
                      class="px-4 py-2.5 rounded-[6px] text-xs font-semibold text-[#0B1F3A] bg-white border border-[#0B1F3A] hover:bg-[#0B1F3A] hover:text-white transition-all duration-200"
                    >
                      Formal Trade Desk
                    </a>
                  </div>

                  <a
                    href={`https://wa.me/919500959005?text=${encodeURIComponent(`Hello ZIYA ZARA team, I am interested in procuring export quantities of: ${category.title}. Please share CIF/FOB specifications.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-emerald-700 hover:text-emerald-800 font-semibold flex items-center gap-1.5"
                  >
                    <span>Instant WhatsApp Inquiry</span>
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                  </a>
                </div>

              </div>

            </div>
          </article>
        );
      })}

    </div>
  </section>

  <!-- Export Accreditations & Quality Assurance Strip -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#2E8B2E]">Compliance & Standards</span>
        <h2 class="text-2xl sm:text-3xl font-bold font-editorial-serif text-[#0B1F3A]">
          Export Assays & Quality Certifications
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Every shipment undergoes rigorous multi-tier testing, phytosanitary checks, and international pre-shipment surveyor inspections before clearance.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <div class="text-xs font-bold text-[#0B1F3A]">APEDA</div>
          <div class="text-[11px] text-slate-500">Agro & Processed Foods Export Authority</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <div class="text-xs font-bold text-[#0B1F3A]">SPICES BOARD</div>
          <div class="text-[11px] text-slate-500">Ministry of Commerce & Industry (Govt. of India)</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <div class="text-xs font-bold text-[#0B1F3A]">FSSAI & AGMARK</div>
