  <!-- Client-side Interactive Script for Filters, Search & Modal -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Filter Pills & Live Search Elements
      const filterPills = document.querySelectorAll('#category-filter-bar .category-pill');
      const searchInput = document.getElementById('product-search-input');
      const searchClearBtn = document.getElementById('product-search-clear');
      const searchStatusBar = document.getElementById('search-status-bar');
      const searchMatchesCount = document.getElementById('search-matches-count');
      const searchResetBtn = document.getElementById('search-reset-btn');
      const noResultsBanner = document.getElementById('no-results-banner');
      const categoryCards = document.querySelectorAll('.product-category-card');
      const clearFilterBtn = document.getElementById('clear-filter-btn');

      let activeFilter = 'all';
      let searchQuery = '';

      function applyFilterAndSearch() {
        let visibleCount = 0;
        const query = searchQuery.trim().toLowerCase();

        categoryCards.forEach((card) => {
          const categorySlug = card.getAttribute('data-category-slug');
          const searchText = card.getAttribute('data-search-text') || '';

          const matchesCategory = activeFilter === 'all' || categorySlug === activeFilter;
          const matchesSearch = query === '' || searchText.includes(query);

          if (matchesCategory && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Search feedback bar
        if (query.length > 0) {
          searchStatusBar?.classList.remove('hidden');
          searchClearBtn?.classList.remove('hidden');
          if (searchMatchesCount) {
            searchMatchesCount.textContent = `Found ${visibleCount} trade sector${visibleCount === 1 ? '' : 's'} matching "${query}"`;
          }
        } else {
          searchStatusBar?.classList.add('hidden');
          searchClearBtn?.classList.add('hidden');
        }

        // Zero results banner
        if (visibleCount === 0) {
          noResultsBanner?.classList.remove('hidden');
        } else {
          noResultsBanner?.classList.add('hidden');
        }
      }

      // Filter Pill Click Handlers
      filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          filterPills.forEach((p) => {
            p.classList.remove('active', 'bg-[#0B1F3A]', 'text-white', 'shadow-xs');
            p.classList.add('bg-slate-100', 'text-slate-700');
          });

          pill.classList.add('active', 'bg-[#0B1F3A]', 'text-white', 'shadow-xs');
          pill.classList.remove('bg-slate-100', 'text-slate-700');

          activeFilter = pill.getAttribute('data-filter') || 'all';
          applyFilterAndSearch();
        });
      });

      // Search Input Handlers
      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        applyFilterAndSearch();
      });

      function resetSearch() {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        applyFilterAndSearch();
      }

      searchClearBtn?.addEventListener('click', resetSearch);
      searchResetBtn?.addEventListener('click', resetSearch);
      clearFilterBtn?.addEventListener('click', () => {
        resetSearch();
        const allPill = document.querySelector('#category-filter-bar [data-filter="all"]');
        if (allPill) allPill.click();
      });

      // 2. Interactive Quotation Modal
      const modalBackdrop = document.getElementById('quote-modal-backdrop');
      const modalCard = document.getElementById('quote-modal-card');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const quoteForm = document.getElementById('quick-quote-form');
      const modalProductName = document.getElementById('modal-product-name');
      const modalWhatsAppBtn = document.getElementById('modal-whatsapp-btn');
      const modalSuccessMsg = document.getElementById('modal-success-msg');
      const modalSubmitBtn = document.getElementById('modal-submit-btn');

      function openModal(productName) {
        if (!modalBackdrop || !modalCard) return;
        if (modalProductName) {
          modalProductName.value = productName || 'Multi-Commodity Export Inquiry';
        }
        if (modalSuccessMsg) {
          modalSuccessMsg.classList.add('hidden');
        }
        if (modalSubmitBtn) {
          modalSubmitBtn.removeAttribute('disabled');
          modalSubmitBtn.innerHTML = `<span>Submit Quotation Request</span><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>`;
        }

        modalBackdrop.classList.remove('hidden');
        // Trigger transitions
        requestAnimationFrame(() => {
          modalBackdrop.classList.remove('opacity-0');
          modalBackdrop.classList.add('opacity-100');
          modalCard.classList.remove('scale-95', 'opacity-0');
          modalCard.classList.add('scale-100', 'opacity-100');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modalBackdrop || !modalCard) return;
        modalBackdrop.classList.remove('opacity-100');
        modalBackdrop.classList.add('opacity-0');
        modalCard.classList.remove('scale-100', 'opacity-100');
        modalCard.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
          modalBackdrop.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }

      // Bind all open buttons
      document.querySelectorAll('[data-open-quote-modal]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const prodName = btn.getAttribute('data-product-name') || '';
          openModal(prodName);
        });
      });

      closeModalBtn?.addEventListener('click', closeModal);
      modalBackdrop?.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeModal();
      });

      // Escape key closes modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modalBackdrop?.classList.contains('hidden')) {
          closeModal();
        }
      });

      // WhatsApp Button in Modal
      modalWhatsAppBtn?.addEventListener('click', () => {
        const item = modalProductName?.value || 'Products';
        const port = document.getElementById('modal-port')?.value || 'Destination Port';
        const vol = document.getElementById('modal-volume')?.value || '';
        const text = encodeURIComponent(`Hello ZIYA ZARA, I would like to request an export quote for: ${item}. Quantity: ${vol}, Destination Port: ${port}. Please provide CIF terms.`);
        window.open(`https://wa.me/919500959005?text=${text}`, '_blank');
      });

      // Form Submit Handler
      quoteForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (modalSubmitBtn) {
          modalSubmitBtn.setAttribute('disabled', 'true');
          modalSubmitBtn.innerHTML = `<span>Transmitting Inquiry...</span>`;
        }

        setTimeout(() => {
          if (modalSuccessMsg) {
            modalSuccessMsg.classList.remove('hidden');
          }
          if (modalSubmitBtn) {
            modalSubmitBtn.innerHTML = `<span>Inquiry Transmitted ✓</span>`;
          }
          setTimeout(() => {
            closeModal();
            quoteForm.reset();
          }, 2400);
        }, 800);
      });
    });
  </script>
</BaseLayout>
