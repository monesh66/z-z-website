---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourcingProcess from '../components/SourcingProcess.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout
  title={`Sourcing Protocol & Methodology | ${siteConfig.legalName}`}
  description="Discover how ZIYA ZARA TRADING COMPANY manages end-to-end global sourcing, pre-shipment quality assays, and multi-modal logistics."
>
  <!-- Sourcing Banner -->
  <section class="bg-[#EAF3FB] text-navy-950 py-20 lg:py-24 border-b border-slate-200/80 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#0B1F3A_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
          <span class="w-8 h-0.5 bg-emerald-600"></span>
          <span>Procurement Architecture</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display tracking-tight text-navy-950 leading-tight">
          Precision Sourcing. <br />
          <span class="text-emerald-700 font-editorial-serif italic font-normal">Predictable Execution.</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed pt-2">
          Our 4-stage sourcing methodology ensures that technical specifications, international laboratory testing, and customs compliance are meticulously addressed before cargo is dispatched.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive 4-Stage Workflow -->
  <SourcingProcess />

  <!-- Technical Assays & Compliance Section -->
  <section class="py-20 bg-white border-b border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-emerald-700">
            <span>Quality Verification Protocol</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold font-display text-navy-950">
            Pre-Shipment Inspections & Independent Assays
          </h2>
          <div class="space-y-4 text-slate-600 text-sm leading-relaxed">
            <p>
              To protect both buyers and suppliers from commercial non-conformity, our sourcing protocol mandates strict pre-shipment inspections by internationally accredited third-party assayers (such as SGS, Bureau Veritas, or Intertek) upon buyer request.
            </p>
            <p>
              Depending on the commodity category, checks include:
            </p>
            <ul class="space-y-2 pt-2">
              <li class="flex items-center gap-2.5 text-slate-700 font-medium text-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>Moisture, purity, foreign matter, and sizing assays for agricultural commodities</span>
              </li>
              <li class="flex items-center gap-2.5 text-slate-700 font-medium text-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>Aflatoxin, pesticide residue, and microbial certifications for edible grains & oils</span>
              </li>
              <li class="flex items-center gap-2.5 text-slate-700 font-medium text-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>Yarn count, tensile strength, GSM, and colorfastness tests for textile exports</span>
              </li>
              <li class="flex items-center gap-2.5 text-slate-700 font-medium text-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                <span>Hydrostatic, ultrasonic, and chemical mill test certificates (EN 10204 3.1) for industrial metals</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 space-y-6">
            <h3 class="text-xl font-bold font-display text-navy-950">
              Incoterms 2020 Contracting Models
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We structure commercial trade contracts according to internationally recognized ICC Incoterms 2020 rules, ensuring absolute clarity regarding risk transfer, freight payment, and insurance obligations:
            </p>

            <div class="grid grid-cols-2 gap-4 pt-2">
              <div class="bg-white p-4 rounded-xl border border-slate-200">
                <div class="text-emerald-700 font-bold font-mono text-sm">FOB</div>
                <div class="text-xs font-semibold text-navy-950 mt-1">Free on Board</div>
                <div class="text-[11px] text-slate-500 mt-0.5">Origin port delivery & export clearance.</div>
              </div>

              <div class="bg-white p-4 rounded-xl border border-slate-200">
                <div class="text-emerald-700 font-bold font-mono text-sm">CIF</div>
                <div class="text-xs font-semibold text-navy-950 mt-1">Cost, Insurance & Freight</div>
                <div class="text-[11px] text-slate-500 mt-0.5">Maritime shipping to buyer destination port.</div>
              </div>

              <div class="bg-white p-4 rounded-xl border border-slate-200">
                <div class="text-emerald-700 font-bold font-mono text-sm">CFR</div>
                <div class="text-xs font-semibold text-navy-950 mt-1">Cost & Freight</div>
                <div class="text-[11px] text-slate-500 mt-0.5">Ocean transport without marine insurance.</div>
              </div>

              <div class="bg-white p-4 rounded-xl border border-slate-200">
                <div class="text-emerald-700 font-bold font-mono text-sm">DDP / EXW</div>
                <div class="text-xs font-semibold text-navy-950 mt-1">Delivered Duty Paid / Factory</div>
                <div class="text-[11px] text-slate-500 mt-0.5">Turnkey inland or origin mill handover.</div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Sourcing Consultation Banner -->
  <section class="py-16 bg-[#EAF3FB] text-navy-950 text-center border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h2 class="text-3xl font-display font-bold text-navy-950">Have a Custom Technical Requirement?</h2>
      <p class="text-slate-600 text-sm max-w-xl mx-auto">
        Share your product specification sheet, target volumes, and destination port. Our sourcing officers will provide origin recommendations.
      </p>
      <div>
        <a href="/contact" class="trade-btn-primary">
          <span>Submit Sourcing Requirement</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
